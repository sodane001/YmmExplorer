<UserControl x:Class="YmmExplorer.TextBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1B1C20" Foreground="#F3F4F6" FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="13">
    <UserControl.Resources>
        <SolidColorBrush x:Key="EsPanel" Color="#25272C"/>
        <SolidColorBrush x:Key="EsCard" Color="#2F3238"/>
        <SolidColorBrush x:Key="EsHover" Color="#3A3E46"/>
        <SolidColorBrush x:Key="EsAccent" Color="#60CDFF"/>
        <SolidColorBrush x:Key="EsText" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="EsSub" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="EsStar" Color="#FFD54F"/>
        <BooleanToVisibilityConverter x:Key="EsB2V"/>

        <Style x:Key="EsSubTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource EsSub}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" Background="{StaticResource EsCard}" CornerRadius="6" Padding="6,7">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource EsHover}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource EsAccent}"/>
                                <Setter Property="Foreground" Value="#10141A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EsCategoryItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource EsText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="10,7" Margin="0,0,0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource EsHover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource EsAccent}"/>
                                <Setter Property="Foreground" Value="#10141A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EsRowItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EsPlaceButton" TargetType="Button">
            <Setter Property="Foreground" Value="#10141A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{StaticResource EsAccent}" CornerRadius="6" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#8ADBFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EsPlainButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource EsText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{StaticResource EsCard}" CornerRadius="6" Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource EsHover}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- タグのボタン(丸い札) -->
        <Style x:Key="EsTagChip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource EsText}"/>
            <Setter Property="Background" Value="{StaticResource EsCard}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="10" Padding="9,2,9,3" BorderThickness="1" BorderBrush="#3D424B">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource EsAccent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- お気に入りの星(タイルの右上) -->
        <Style x:Key="EsStarButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="#99000000" CornerRadius="11" Width="22" Height="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#CC000000"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="EsTile">
            <Border x:Name="Box" Width="168" Margin="4" CornerRadius="7" Background="{StaticResource EsCard}" BorderThickness="2"
                    BorderBrush="Transparent" Cursor="Hand" ToolTip="{Binding ToolTipText}" MouseLeftButtonDown="Tile_MouseLeftButtonDown">
                <StackPanel>
                    <Grid Height="92" Background="#202227">
                        <TextBlock Text="Aa" FontSize="24" Foreground="#4A4F59" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Button x:Name="Star" Style="{StaticResource EsStarButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                ToolTip="お気に入り(押すと入れる/外す)" Click="Star_Click" Visibility="Hidden">
                            <TextBlock x:Name="StarText" Text="{Binding FavoriteMark}" Foreground="White" FontSize="13" Margin="0,-1,0,0"/>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="8,5,8,6"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Box" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Box" Property="Background" Value="{StaticResource EsHover}"/>
                    <Setter TargetName="Star" Property="Visibility" Value="Visible"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter TargetName="Star" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="StarText" Property="Foreground" Value="{StaticResource EsStar}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource EsAccent}"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="EsRow">
            <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource EsTile}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>

        <Border Margin="6,6,0,6" Padding="8" CornerRadius="10" Background="{StaticResource EsPanel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="分類" Foreground="{StaticResource EsSub}" FontSize="11" Margin="6,2,0,6"/>
                <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label"
                         ItemContainerStyle="{StaticResource EsCategoryItem}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Margin="6" CornerRadius="10" Background="{StaticResource EsPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="10,10,10,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="{StaticResource EsCard}"
                                 Foreground="{StaticResource EsText}" CaretBrush="{StaticResource EsText}" BorderBrush="#454A53"/>
                        <TextBlock Text="名前やタグで検索(例: 字幕 / ネオン / 黄 / 明朝 / かわいい)。スペースで区切ると、すべてを含むもの" Foreground="{StaticResource EsSub}" Margin="11,6,0,0" IsHitTestVisible="False"
                                   Visibility="{Binding HasNoSearch, Converter={StaticResource EsB2V}}"/>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{StaticResource EsSub}" VerticalAlignment="Center" Margin="12,0,2,0"/>
                </Grid>
                <DockPanel Grid.Row="1" Margin="12,2,10,2">
                    <TextBlock DockPanel.Dock="Left" Text="タグ" Foreground="{StaticResource EsSub}" FontSize="11" Margin="0,3,8,0" VerticalAlignment="Top"/>
                    <ItemsControl ItemsSource="{Binding QuickTags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="Chip" Style="{StaticResource EsTagChip}" Content="{Binding Name}" ToolTip="{Binding ToolTip}" Click="QuickTag_Click"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="Chip" Property="Background" Value="{StaticResource EsAccent}"/>
                                        <Setter TargetName="Chip" Property="Foreground" Value="#10141A"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <TextBlock Grid.Row="2" Text="{Binding EmptyText}" Foreground="{StaticResource EsSub}" FontSize="12" TextWrapping="Wrap" Margin="14,10,14,4"
                           Visibility="{Binding HasEmptyText, Converter={StaticResource EsB2V}}"/>
                <ListBox Grid.Row="3" ItemsSource="{Binding Rows}" ItemContainerStyle="{StaticResource EsRowItem}" Foreground="{StaticResource EsText}" ItemTemplate="{StaticResource EsRow}"
                         Background="Transparent" BorderThickness="0" Margin="6,0,2,6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         SizeChanged="RowList_SizeChanged"/>
            </Grid>
        </Border>

        <Border Grid.Column="2" Margin="0,6,6,6" Padding="14" CornerRadius="10" Background="{StaticResource EsPanel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="使い方" Foreground="{StaticResource EsSub}" FontSize="11" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <RadioButton Style="{StaticResource EsSubTab}" GroupName="TextMode" Content="新しく作成" IsChecked="{Binding ModeNew}"
                                     ToolTip="新しいテキストを作って、シークバーの位置に配置します"/>
                        <RadioButton Grid.Column="2" Style="{StaticResource EsSubTab}" GroupName="TextMode" Content="選択中に適用" IsChecked="{Binding ModeApply}"
                                     ToolTip="YMM4 のタイムラインで選択中のテキスト(ボイスの字幕も)に、書式を適用します"/>
                    </Grid>
                    <TextBlock Text="{Binding HintText}" Foreground="{StaticResource EsSub}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Visibility="{Binding HasNoSelected, Converter={StaticResource EsB2V}}"/>
                    <StackPanel Visibility="{Binding HasSelected, Converter={StaticResource EsB2V}}">
                        <Border CornerRadius="8" Background="#202227" ClipToBounds="True" Margin="0,0,0,10">
                            <Image Source="{Binding PreviewImage}" Height="135" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="{Binding Selected.Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,3"/>
                        <TextBlock Foreground="{StaticResource EsSub}" FontSize="12" Margin="0,0,0,6">
                            <Run Text="{Binding Selected.NoText, Mode=OneWay}"/><Run Text="  ・  "/><Run Text="{Binding Selected.Category, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Selected.Description}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Selected.FontText}" Foreground="{StaticResource EsSub}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Visibility="{Binding Selected.HasTags, Converter={StaticResource EsB2V}}">
                            <TextBlock Text="タグ(押すと、そのタグで探します)" Foreground="{StaticResource EsSub}" FontSize="11" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Selected.Tags}" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource EsTagChip}" Content="{Binding}" ContentStringFormat="#{0}" Click="Tag_Click"
                                                ToolTip="このタグで探します(Ctrl を押しながらだと、今の検索に足します)"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="見本の文字(新しく作成する時の文字にもなります)" Foreground="{StaticResource EsSub}" FontSize="11" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,10">
                            <TextBox Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged}" Padding="7,5" Background="{StaticResource EsCard}"
                                     Foreground="{StaticResource EsText}" CaretBrush="{StaticResource EsText}" BorderBrush="#454A53"/>
                            <TextBlock Text="{Binding Selected.Sample}" Foreground="{StaticResource EsSub}" Margin="10,5,0,0" IsHitTestVisible="False"
                                       Visibility="{Binding HasNoPreviewText, Converter={StaticResource EsB2V}}"/>
                        </Grid>
                    </StackPanel>
                    <Button Style="{StaticResource EsPlaceButton}" Content="{Binding RunText}" Command="{Binding RunCommand}"/>
                    <CheckBox IsChecked="{Binding WithSize}" Foreground="{StaticResource EsText}" Margin="0,8,0,0"
                              Visibility="{Binding ModeApply, Converter={StaticResource EsB2V}}"
                              Content="適用する時、文字の大きさも変える"
                              ToolTip="オフの時は、いまの文字の大きさのまま書式だけを変えます(縁取りの太さは、いまの大きさに合わせます)"/>
                    <Button Style="{StaticResource EsPlainButton}" Content="{Binding FavoriteButtonText}" Command="{Binding FavoriteCommand}" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource EsAccent}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- YMM4本体のフォルダ。環境に合わせて変更するか、環境変数 YMM4DirPath を設定してください -->
    <YMM4DirPath Condition="'$(YMM4DirPath)' == ''">I:\YMM4\YukkuriMovieMaker_v4</YMM4DirPath>

    <!-- YMM4本体が.NET 10のため net10.0 を指定(.NET 10 SDKが必要) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YmmExplorer</AssemblyName>
    <RootNamespace>YmmExplorer</RootNamespace>
    <!-- 同梱の「演出図形」(EffectShapes フォルダー)は下で順番を決めて含めるので、自動の読み込みからは外す -->
    <DefaultItemExcludes>$(DefaultItemExcludes);EffectShapes\**;Bridge3D\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="YukkuriMovieMaker.Plugin">
      <HintPath>$(YMM4DirPath)\YukkuriMovieMaker.Plugin.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 同梱の「演出図形」(EffectShapes フォルダー)も、この YmmExplorer.dll の中に一緒にコンパイルします。
       図形の並び順はこの順番（番号順）で決まるので、自動の読み込みから外して順番どおりに並べています -->
  <ItemGroup>
    <Reference Include="YukkuriMovieMaker.Controls">
      <HintPath>$(YMM4DirPath)\YukkuriMovieMaker.Controls.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="YukkuriMovieMaker.Commons" Condition="Exists('$(YMM4DirPath)\YukkuriMovieMaker.Commons.dll')">
      <HintPath>$(YMM4DirPath)\YukkuriMovieMaker.Commons.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SharpGen.Runtime">
      <HintPath>$(YMM4DirPath)\SharpGen.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SharpGen.Runtime.COM">
      <HintPath>$(YMM4DirPath)\SharpGen.Runtime.COM.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Vortice.Direct2D1">
      <HintPath>$(YMM4DirPath)\Vortice.Direct2D1.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Vortice.DXGI">
      <HintPath>$(YMM4DirPath)\Vortice.DXGI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Vortice.Direct3D11">
      <HintPath>$(YMM4DirPath)\Vortice.Direct3D11.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Vortice.D3DCompiler">
      <HintPath>$(YMM4DirPath)\Vortice.D3DCompiler.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Vortice.DirectX">
      <HintPath>$(YMM4DirPath)\Vortice.DirectX.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Vortice.Mathematics">
      <HintPath>$(YMM4DirPath)\Vortice.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

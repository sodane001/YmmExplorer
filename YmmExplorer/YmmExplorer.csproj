  <!--
    同梱プラグイン(Bundled フォルダー): サラウンドパン(音声エフェクト)・文字中心固定(映像エフェクト)・
    MIDI ピアノロール/五線譜(図形)。YmmExplorer と同じフォルダーに一緒にコピーされ、YMM4 がそのまま読み込みます
  -->
  <ItemGroup>
    <None Update="Bundled\*.dll;Bundled\*.txt" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="WarnOldBundled" AfterTargets="Build">
    <Warning Condition="Exists('$(YMM4DirPath)\user\plugin\SurroundPan\SurroundPan.dll')" Text="サラウンドパンは YmmExplorer に同梱されました。YMM4 を閉じて、前に単体で入れた $(YMM4DirPath)\user\plugin\SurroundPan フォルダーを削除してください(残っているとエフェクトが2つずつ出ます)" />
    <Warning Condition="Exists('$(YMM4DirPath)\user\plugin\midi、五線譜プラグイン\MidiRollPlugin.dll')" Text="MIDI(ピアノロール・五線譜)は YmmExplorer に同梱されました。YMM4 を閉じて、前に入れた $(YMM4DirPath)\user\plugin\midi、五線譜プラグイン フォルダーを削除してください" />
    <Warning Condition="Exists('$(YMM4DirPath)\user\plugin\TextCenterKeeper\TextCenterKeeper.dll')" Text="文字中心固定は YmmExplorer に同梱されました。YMM4 を閉じて、前に単体で入れた $(YMM4DirPath)\user\plugin\TextCenterKeeper フォルダーを削除してください" />
  </Target>

  <!-- 前に単体で入れた演出図形プラグインが残っていると、図形が2つずつ出てしまうので知らせる -->
  <Target Name="WarnOldEffectShapes" AfterTargets="Build" Condition="Exists('$(YMM4DirPath)\user\plugin\YMM4EffectShapes\YMM4EffectShapes.dll')">
    <Warning Text="演出図形プラグインは YmmExplorer に同梱されました。YMM4 を閉じて、前に単体で入れた $(YMM4DirPath)\user\plugin\YMM4EffectShapes フォルダーを削除してください(残っていると図形が重複します)" />
  </Target>

  <!-- ビルド後にYMM4のpluginフォルダへ自動コピー(YMM4を閉じてからビルドしてください) -->
  <!-- PDFプレビュー(Windows.Data.Pdf)のために Microsoft.Windows.SDK.NET.dll / WinRT.Runtime.dll も一緒にコピーします -->
  <!-- 3Dプレビュー(YMM43D)との橋渡し: YMM43D がある時だけ作って、.bin の名前で置く(YMM4 がプラグインとして読まないように) -->
  <PropertyGroup>
    <YMM43DPath Condition="'$(YMM43DPath)' == ''">$(YMM4DirPath)\user\plugin\YMM4_3D\YMM43D.dll</YMM43DPath>
  </PropertyGroup>
  <Target Name="BuildBridge3D" AfterTargets="Build" BeforeTargets="CopyToYmm" Condition="Exists('$(YMM43DPath)')">
    <MSBuild Projects="Bridge3D\Bridge3D.csproj" Properties="Configuration=$(Configuration);YMM4DirPath=$(YMM4DirPath);YMM43DPath=$(YMM43DPath)" Targets="Restore;Build" />
    <Copy SourceFiles="Bridge3D\bin\$(Configuration)\net10.0-windows10.0.19041.0\YmmExplorer.Bridge3D.dll" DestinationFiles="$(OutDir)YmmExplorer.Bridge3D.bin" />
  </Target>
  <Target Name="CopyToYmm" AfterTargets="Build" Condition="Exists('$(YMM4DirPath)\user\plugin')">
    <ItemGroup>
      <PluginFile Include="$(OutDir)*.dll;$(OutDir)$(AssemblyName).deps.json;$(OutDir)*利用規約.txt;$(OutDir)YmmExplorer.Bridge3D.bin" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFile)" DestinationFolder="$(YMM4DirPath)\user\plugin\YmmExplorer" />
    <!-- 以前の版で別 DLL として入れた演出図形が残っていると図形が重複するので消す -->
    <Delete Files="$(YMM4DirPath)\user\plugin\YmmExplorer\YMM4EffectShapes.dll" ContinueOnError="true" />
  </Target>


  <!--
    同梱の演出図形で使う、文字・フォントの入力欄の属性(TextEditor / FontComboBox)が、
    このYMM4にあるかを調べる。無い時は、代わりの属性を使う(ビルドは通り、YMM4標準の画面には欄が出ない)
  -->
  <Target Name="DetectYmmEditorAttributes" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_YmmCtlText Condition="Exists('$(YMM4DirPath)\YukkuriMovieMaker.Controls.dll')">$([System.IO.File]::ReadAllText('$(YMM4DirPath)\YukkuriMovieMaker.Controls.dll'))</_YmmCtlText>
      <_YmmPlgText Condition="Exists('$(YMM4DirPath)\YukkuriMovieMaker.Plugin.dll')">$([System.IO.File]::ReadAllText('$(YMM4DirPath)\YukkuriMovieMaker.Plugin.dll'))</_YmmPlgText>
      <DefineConstants Condition="'$(_YmmCtlText.Contains(`TextEditorAttribute`))' == 'True' Or '$(_YmmPlgText.Contains(`TextEditorAttribute`))' == 'True'">$(DefineConstants);YMM_HAS_TEXTEDITOR</DefineConstants>
      <DefineConstants Condition="'$(_YmmCtlText.Contains(`FontComboBoxAttribute`))' == 'True' Or '$(_YmmPlgText.Contains(`FontComboBoxAttribute`))' == 'True'">$(DefineConstants);YMM_HAS_FONTCOMBOBOX</DefineConstants>
      <_YmmCtlText></_YmmCtlText>
      <_YmmPlgText></_YmmPlgText>
    </PropertyGroup>
    <Message Importance="high" Text="YmmExplorer: YMM4の文字入力欄 = $(DefineConstants.Contains('YMM_HAS_TEXTEDITOR')) / フォント選択欄 = $(DefineConstants.Contains('YMM_HAS_FONTCOMBOBOX'))" />
  </Target>
</Project>

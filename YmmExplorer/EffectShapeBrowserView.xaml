<UserControl x:Class="YmmExplorer.EffectShapeBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1B1C20" Foreground="#F3F4F6" FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="13">
    <UserControl.Resources>
        <SolidColorBrush x:Key="EsPanel" Color="#25272C"/>
        <SolidColorBrush x:Key="EsCard" Color="#2F3238"/>
        <SolidColorBrush x:Key="EsHover" Color="#3A3E46"/>
        <SolidColorBrush x:Key="EsAccent" Color="#60CDFF"/>
        <SolidColorBrush x:Key="EsText" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="EsSub" Color="#9CA3AF"/>
        <BooleanToVisibilityConverter x:Key="EsB2V"/>

        <Style x:Key="EsSubTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource EsSub}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="18,7" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource EsHover}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource EsAccent}"/>
                                <Setter Property="Foreground" Value="#10141A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EsCategoryItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource EsText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="10,7" Margin="0,0,0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource EsHover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource EsAccent}"/>
                                <Setter Property="Foreground" Value="#10141A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EsRowItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EsPlaceButton" TargetType="Button">
            <Setter Property="Foreground" Value="#10141A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{StaticResource EsAccent}" CornerRadius="6" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#8ADBFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EsPlainButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource EsText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{StaticResource EsCard}" CornerRadius="6" Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource EsHover}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="EsTile">
            <Border x:Name="Box" Width="168" Margin="4" CornerRadius="7" Background="{StaticResource EsCard}" BorderThickness="2"
                    BorderBrush="Transparent" Cursor="Hand" ToolTip="{Binding Title}" MouseLeftButtonDown="Tile_MouseLeftButtonDown">
                <StackPanel>
                    <Grid Height="92" Background="#202227">
                        <TextBlock Text="◆" FontSize="24" Foreground="#4A4F59" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Border x:Name="ModelBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Padding="6,1,6,2"
                                CornerRadius="4" Background="#E62E7D5B" Visibility="Collapsed" IsHitTestVisible="False"
                                ToolTip="図形に合わせた専用の3Dモデルで描きます">
                            <TextBlock Text="3Dモデル" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="8,5,8,6"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Box" Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource EsHover}"/></Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource EsAccent}"/></DataTrigger>
                <DataTrigger Binding="{Binding HasModel, FallbackValue=False}" Value="True"><Setter TargetName="ModelBadge" Property="Visibility" Value="Visible"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="EsRow">
            <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource EsTile}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="8,7,8,0">
            <RadioButton Style="{StaticResource EsSubTab}" GroupName="EsMode" Content="図形" IsChecked="{Binding IsShapeMode}"/>
            <RadioButton Style="{StaticResource EsSubTab}" GroupName="EsMode" Content="PV背景" IsChecked="{Binding IsPvMode}"/>
            <Border Width="1" Background="#3A3E46" Margin="10,4,14,4"/>
            <!-- 2D / 3D: 同じ図形の平面版と立体版(演出3D)を切り替える -->
            <RadioButton Style="{StaticResource EsSubTab}" GroupName="EsDim" Content="2D" IsChecked="{Binding Show2D}" ToolTip="平面の図形を並べます"/>
            <RadioButton Style="{StaticResource EsSubTab}" GroupName="EsDim" Content="3D" IsChecked="{Binding Show3D}" ToolTip="立体の図形(演出3D)を並べます。回すと奥や側面が見えます"/>
        </StackPanel>

        <!-- 図形 -->
        <Grid Grid.Row="1" Visibility="{Binding IsShapeMode, Converter={StaticResource EsB2V}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Border Margin="6,6,0,6" Padding="8" CornerRadius="10" Background="{StaticResource EsPanel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="分類" Foreground="{StaticResource EsSub}" FontSize="11" Margin="6,2,0,6"/>
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label"
                             ItemContainerStyle="{StaticResource EsCategoryItem}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Margin="6" CornerRadius="10" Background="{StaticResource EsPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="10,10,10,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="{StaticResource EsCard}"
                                     Foreground="{StaticResource EsText}" CaretBrush="{StaticResource EsText}" BorderBrush="#454A53"/>
                            <TextBlock Text="図形を検索(例: 雨 / 桜 / テロップ)" Foreground="{StaticResource EsSub}" Margin="11,6,0,0" IsHitTestVisible="False"
                                       Visibility="{Binding HasNoSearch, Converter={StaticResource EsB2V}}"/>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{StaticResource EsSub}" VerticalAlignment="Center" Margin="12,0,2,0"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="{StaticResource EsAccent}" FontSize="12" TextWrapping="Wrap" Margin="12,2,12,4"
                               Visibility="{Binding HasStatus, Converter={StaticResource EsB2V}}"/>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Rows}" ItemContainerStyle="{StaticResource EsRowItem}" ItemTemplate="{StaticResource EsRow}"
                             Background="Transparent" BorderThickness="0" Margin="6,0,2,6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             SizeChanged="RowList_SizeChanged"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Margin="0,6,6,6" Padding="14" CornerRadius="10" Background="{StaticResource EsPanel}">
                <StackPanel>
                    <TextBlock Text="図形を選ぶと、ここに表示します。ダブルクリックでタイムラインに配置します。" Foreground="{StaticResource EsSub}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Visibility="{Binding HasNoSelected, Converter={StaticResource EsB2V}}"/>
                    <StackPanel Visibility="{Binding HasSelected, Converter={StaticResource EsB2V}}">
                        <Border CornerRadius="8" Background="#202227" ClipToBounds="True" Margin="0,0,0,10">
                            <Image Source="{Binding Selected.Thumb}" Height="130" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="{Binding Selected.Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Selected.Category}" Foreground="{StaticResource EsSub}" FontSize="12" Margin="0,0,0,12"/>
                    </StackPanel>
                    <Button Style="{StaticResource EsPlaceButton}" Content="タイムラインに配置" Command="{Binding PlaceCommand}"/>
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource EsAccent}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- PV背景 -->
        <Grid Grid.Row="1" Visibility="{Binding IsPvMode, Converter={StaticResource EsB2V}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Margin="6,6,0,6" Padding="8" CornerRadius="10" Background="{StaticResource EsPanel}">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Style="{StaticResource EsPlainButton}" Content="← 図形の分類へ戻る" Command="{Binding BackToShapesCommand}" Margin="0,0,0,10"/>
                    <TextBlock DockPanel.Dock="Top" Text="PV背景の設定" Foreground="{StaticResource EsSub}" FontSize="11" Margin="6,2,0,6"/>
                    <ListBox ItemsSource="{Binding PvGroups}" SelectedItem="{Binding SelectedPvGroup}" DisplayMemberPath="Label"
                             ItemContainerStyle="{StaticResource EsCategoryItem}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Margin="6" CornerRadius="10" Background="{StaticResource EsPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource EsAccent}" FontSize="12" TextWrapping="Wrap" Margin="12,8,12,2"
                               Visibility="{Binding HasStatus, Converter={StaticResource EsB2V}}"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding PvRows}" ItemContainerStyle="{StaticResource EsRowItem}" ItemTemplate="{StaticResource EsRow}"
                             Background="Transparent" BorderThickness="0" Margin="6,6,2,6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             SizeChanged="RowList_SizeChanged"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Margin="0,6,6,6" Padding="14" CornerRadius="10" Background="{StaticResource EsPanel}">
                <StackPanel>
                    <Border CornerRadius="8" Background="#202227" ClipToBounds="True" Margin="0,0,0,12">
                        <Image Source="{Binding PvPreview}" Height="152" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="背景" Foreground="{StaticResource EsSub}" Margin="0,2"/>
                        <TextBlock Grid.Column="1" Text="{Binding PvSceneText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Text="立体" Foreground="{StaticResource EsSub}" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PvSolidText}" TextWrapping="Wrap" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Text="描き方" Foreground="{StaticResource EsSub}" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PvStyleText}" TextWrapping="Wrap" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Text="配色" Foreground="{StaticResource EsSub}" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PvPaletteText}" TextWrapping="Wrap" Margin="0,2"/>
                    </Grid>
                    <Button Style="{StaticResource EsPlaceButton}" Content="この組み合わせを配置" Command="{Binding PlacePvCommand}" Margin="0,0,0,6"/>
                    <Button Style="{StaticResource EsPlainButton}" Content="組み合わせを最初に戻す" Command="{Binding ResetPvCommand}"/>
                    <TextBlock Text="各設定から1つずつ選ぶと組み合わせられます。ダブルクリックでも配置できます。配置後は、アイテムの設定で変更できます。" Foreground="{StaticResource EsSub}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource EsAccent}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

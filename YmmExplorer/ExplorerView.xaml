<UserControl x:Class="YmmExplorer.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YmmExplorer"
             FontFamily="Yu Gothic UI, Segoe UI" FontSize="13"
             PreviewKeyDown="Root_PreviewKeyDown" SizeChanged="Root_SizeChanged"
             PreviewMouseWheel="Root_PreviewMouseWheel"
             MinWidth="560" MinHeight="320">

    <UserControl.Resources>
        <!-- ===== カラーパレット (Filesアプリ風のダーク) ===== -->
        <SolidColorBrush x:Key="Bg" Color="#1B1C20"/>
        <SolidColorBrush x:Key="Panel" Color="#25272C"/>
        <SolidColorBrush x:Key="Card" Color="#2F3238"/>
        <SolidColorBrush x:Key="Hover" Color="#3A3D45"/>
        <SolidColorBrush x:Key="SelectedBg" Color="#2B4A63"/>
        <SolidColorBrush x:Key="Stroke" Color="#3F424B"/>
        <SolidColorBrush x:Key="Accent" Color="#60CDFF"/>
        <SolidColorBrush x:Key="OnAccent" Color="#0B1A24"/>
        <SolidColorBrush x:Key="Text" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="Sub" Color="#9CA3AF"/>

        <BooleanToVisibilityConverter x:Key="B2V"/>
        <local:EqualsConverter x:Key="Eq"/>

        <!-- ===== アイコン用テキスト ===== -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== ボタン ===== -->
        <ControlTemplate x:Key="BtnTpl" TargetType="Button">
            <Grid>
                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"/>
                <Border x:Name="hl" Background="White" Opacity="0" CornerRadius="6" IsHitTestVisible="False"/>
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="hl" Property="Opacity" Value="0.08"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="hl" Property="Opacity" Value="0.16"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="Button" x:Key="{x:Type Button}">
            <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <Style x:Key="FilledBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Card}"/>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>

        <Style x:Key="HeaderBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource Sub}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- ===== ピル型トグル (期間・サブフォルダ) ===== -->
        <Style x:Key="PillToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{StaticResource Card}" CornerRadius="14" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 入力欄 (Tagにヒント文字を指定) ===== -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource Sub}"
                                           Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                                <ScrollViewer local:WheelFix.Enabled="True" x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 一覧の行 ===== -->
        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent" Padding="8,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 素材タイル用(Eagle風の選択枠) ===== -->
        <Style x:Key="TileItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" Padding="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectedBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== スクロールバー (細いダーク) ===== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#555963" CornerRadius="4" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ===== チェックボックス(詳細パネルの設定用) ===== -->
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="4" VerticalAlignment="Top"
                                    Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                                <TextBlock x:Name="mark" Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="11"
                                           Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== スイッチ型のチェックボックス(対象パラメータ用) ===== -->
        <Style x:Key="SwitchCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Border x:Name="track" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Margin="8,0,0,0"
                                    Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                                <Ellipse x:Name="thumb" Width="14" Height="14" Fill="{StaticResource Sub}"
                                         HorizontalAlignment="Left" Margin="4,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource SelectedBg}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,4,0"/>
                                <Setter TargetName="thumb" Property="Fill" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 右クリックメニュー(ダーク) ===== -->
        <Style TargetType="ContextMenu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="8" Padding="4">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                           Foreground="{StaticResource Sub}" FontSize="11" Margin="28,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="{StaticResource Stroke}" Margin="8,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ツールチップ(ダーク) ===== -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- ===== スライダー(シーク・音量) ===== -->
        <Style x:Key="Seek" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{StaticResource Stroke}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource Accent}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ホバー時のプレビュー ===== -->
        <DataTemplate x:Key="HoverTpl">
            <StackPanel MaxWidth="340">
                <Image Source="{Binding Thumbnail}" MaxHeight="240" Stretch="Uniform" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,2"/>
                <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Text="ダブルクリックでプレビュー" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding CanPreview, Converter={StaticResource B2V}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- アイコン非表示時にグリフを出すためのスタイル(サムネイルがあれば隠す) -->
        <Style x:Key="GlyphUnderThumb" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== 詳細表示 ===== -->
        <DataTemplate x:Key="DetailsTpl">
            <Grid Height="36" Background="Transparent">
                <Grid.ToolTip>
                    <ToolTip Content="{Binding}" ContentTemplate="{StaticResource HoverTpl}"/>
                </Grid.ToolTip>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBlock Style="{StaticResource GlyphUnderThumb}" Text="{Binding IconGlyph}"
                                   Foreground="{Binding IconBrush}" FontSize="18"/>
                        <Image Source="{Binding Thumbnail}" Width="38" Height="28" Stretch="Uniform"
                               HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding ModifiedText}" Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding TypeText}" Foreground="{StaticResource Sub}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
                <ItemsControl Grid.Column="4" ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Brush}" CornerRadius="9" Padding="8,1" Margin="0,0,4,0">
                                <TextBlock Text="{Binding Name}" Foreground="#14161A" FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <!-- ===== 一覧表示 ===== -->
        <DataTemplate x:Key="ListTpl">
            <StackPanel Orientation="Horizontal" Width="230" Height="32" Background="Transparent">
                <StackPanel.ToolTip>
                    <ToolTip Content="{Binding}" ContentTemplate="{StaticResource HoverTpl}"/>
                </StackPanel.ToolTip>
                <Grid Width="40">
                    <TextBlock Style="{StaticResource GlyphUnderThumb}" Text="{Binding IconGlyph}"
                               Foreground="{Binding IconBrush}" FontSize="16"/>
                    <Image Source="{Binding Thumbnail}" Width="34" Height="24" Stretch="Uniform"
                           HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="184"/>
            </StackPanel>
        </DataTemplate>

        <!-- ===== アイコン表示(小・中・大・特大) ===== -->
        <DataTemplate x:Key="TileTpl">
            <StackPanel Background="Transparent"
                        Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <StackPanel.ToolTip>
                    <ToolTip Content="{Binding}" ContentTemplate="{StaticResource HoverTpl}"/>
                </StackPanel.ToolTip>
                <Grid HorizontalAlignment="Center" Margin="0,6,0,4"
                      Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock Style="{StaticResource GlyphUnderThumb}" Text="{Binding IconGlyph}"
                               Foreground="{Binding IconBrush}" HorizontalAlignment="Center"
                               FontSize="{Binding DataContext.GlyphSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"
                           TextAlignment="Center" FontSize="12" Margin="2,0"/>
                <ItemsControl ItemsSource="{Binding Tags}" HorizontalAlignment="Center" Margin="0,3,0,6" MinHeight="8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="1,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- ===== ファイル一覧(表示モードで見た目を切り替え) ===== -->
        <Style x:Key="FileListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Row}"/>
            <Setter Property="ItemTemplate" Value="{StaticResource DetailsTpl}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsList}" Value="True">
                    <Setter Property="ItemTemplate" Value="{StaticResource ListTpl}"/>
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTiles}" Value="True">
                    <Setter Property="ItemTemplate" Value="{StaticResource TileTpl}"/>
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== 上部のタブ(機能切り替え) ===== -->
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Sub}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8,8,0,0" Padding="16,8,16,0">
                            <StackPanel>
                                <ContentPresenter HorizontalAlignment="Center" Margin="0,0,0,7"/>
                                <Rectangle x:Name="line" Height="3" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{StaticResource Accent}" Visibility="Hidden"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Panel}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Panel}"/>
                                <Setter TargetName="line" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== テンプレートのタイル(サムネイルが無い時はアイコン) ===== -->
        <Style x:Key="TemplateGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayThumb}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TemplateTileTpl">
            <StackPanel Width="190" Background="Transparent" Margin="0,4">
                <Border Height="112" CornerRadius="8" Background="{StaticResource Card}" Margin="0,0,0,8" ClipToBounds="True">
                    <Grid>
                        <TextBlock Style="{StaticResource TemplateGlyph}" Text="{Binding Item.IconGlyph, FallbackValue=&#xE7BA;}"
                                   Foreground="{Binding Item.IconBrush}" FontSize="40" HorizontalAlignment="Center"/>
                        <Image Source="{Binding DisplayThumb}" Stretch="Uniform" Margin="4"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,0"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Sub}" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="2,2,2,0"/>
                <TextBlock Text="{Binding Memo}" Foreground="{StaticResource Sub}" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="2,2,2,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="EffectTileTpl">
            <Border Width="190" Margin="0,4" CornerRadius="8" Background="{StaticResource Card}" ClipToBounds="True">
                <StackPanel>
                    <Grid Height="104" Background="#26000000">
                        <TextBlock Text="{Binding Placeholder}" FontSize="38" Foreground="{StaticResource Sub}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasNoThumb, Converter={StaticResource B2V}}"/>
                        <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="4"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <StackPanel Margin="12,8,12,10">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding CreatedText}" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Memo}" Foreground="{StaticResource Sub}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ShapeTileTpl">
            <Border Width="190" Margin="0,4" CornerRadius="8" Background="{StaticResource Card}" ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Height="104" Background="#26000000">
                        <TextBlock Text="◆" FontSize="38" Foreground="{StaticResource Sub}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasNoThumb, Converter={StaticResource B2V}}"/>
                        <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="4"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,2"
                                CornerRadius="4" Background="#CC000000"
                                Visibility="{Binding IsHidden, Converter={StaticResource B2V}}">
                            <TextBlock Text="非表示" FontSize="10"/>
                        </Border>
                    </Grid>
                    <StackPanel Margin="12,8,12,10">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceText}" Foreground="{StaticResource Sub}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding PlaceText}" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Memo}" Foreground="{StaticResource Sub}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PresetTileTpl">
            <Border Width="210" Margin="0,4" CornerRadius="8" Background="{StaticResource Card}" ClipToBounds="True">
                <StackPanel>
                    <Grid Height="118" Background="#26000000">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE91B;" Foreground="{StaticResource Sub}"
                                   FontSize="34" HorizontalAlignment="Center"
                                   Visibility="{Binding HasNoThumb, Converter={StaticResource B2V}}"/>
                        <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="4"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <StackPanel Margin="12,8,12,10">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding CreatedText}" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Memo}" Foreground="{StaticResource Sub}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== アイテムタブ: 項目のメニュー(デフォルトに戻す・設定する) ===== -->
        <ContextMenu x:Key="ItemRowMenu">
            <MenuItem Header="デフォルト(既定値)に戻す" Command="{Binding ResetDefaultCommand}"/>
            <MenuItem Header="いまの値を、デフォルト(既定値)に設定" Command="{Binding SetDefaultCommand}"/>
            <Separator/>
            <MenuItem Header="{Binding QuickMenuText}" Command="{Binding ToggleQuickCommand}"/>
        </ContextMenu>

        <!-- ===== アイテムタブ: 移動の1点(始点・中間点・終点)の行 ===== -->
        <DataTemplate x:Key="AnimPointRowTpl">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Slider Style="{StaticResource Seek}" IsMoveToPointEnabled="True" PreviewMouseLeftButtonUp="RangeSlider_Release"
                            ToolTip="端まで動かしてマウスを離すと、範囲が今の倍に広がります"
                            Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding SliderValue, Mode=TwoWay, Delay=12}"/>
                    <TextBlock Text="{Binding RangeText}" Foreground="{StaticResource Sub}" FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBox Grid.Column="2" Style="{StaticResource Field}" Width="86" TextAlignment="Right" KeyDown="ItemField_KeyDown"
                         ToolTip="数字を入力して Enter" Text="{Binding Text, UpdateSourceTrigger=LostFocus}"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0">
                    <Button Style="{StaticResource IconBtn}" Content="&#xE8C8;" Width="28" Height="28" FontSize="12"
                            ToolTip="この点の値をコピー" Command="{Binding CopyCommand}"/>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE77F;" Width="28" Height="28" FontSize="12" Margin="2,0,0,0"
                            ToolTip="コピーした数値を、この点へ貼り付け" Command="{Binding PasteCommand}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ===== アイテムタブ: 動かし方を選ぶ部品(項目の中と、大きく開いたグラフの両方で使う) ===== -->
        <DataTemplate x:Key="AnimTypeChooserTpl">
            <StackPanel>
                                <TextBlock Text="① 動かし方" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding AnimBasicTypes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource PillToggle}" Margin="0,0,6,6" FontSize="11" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{Binding Label}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Canvas Width="40" Height="24" Margin="0,0,6,0" Visibility="{Binding HasCurve, Converter={StaticResource B2V}}">
                                                            <Polyline Points="{Binding Points}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                      StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                                        </Canvas>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                <StackPanel Visibility="{Binding HasEasing, Converter={StaticResource B2V}}" Margin="0,4,0,0">
                                    <TextBlock Text="緩急をつける(なめらかに動かす)― 曲がり方を選ぶ" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,5"/>
                                    <ItemsControl ItemsSource="{Binding EaseFamilies}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource PillToggle}" Margin="0,0,6,6" FontSize="11" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{Binding Label}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Canvas Width="40" Height="24" Margin="0,0,6,0" Visibility="{Binding HasCurve, Converter={StaticResource B2V}}">
                                                            <Polyline Points="{Binding Points}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                      StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                                        </Canvas>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Visibility="{Binding IsEasing, Converter={StaticResource B2V}}">
                                        <TextBlock Text="速さの変わり方" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,2,0,5"/>
                                        <ItemsControl ItemsSource="{Binding EaseDirections}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource PillToggle}" Margin="0,0,6,6" FontSize="11" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{Binding Label}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Canvas Width="40" Height="24" Margin="0,0,6,0" Visibility="{Binding HasCurve, Converter={StaticResource B2V}}">
                                                            <Polyline Points="{Binding Points}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                      StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                                        </Canvas>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                        <CheckBox Style="{StaticResource Check}" Content="値を整数にする(カクカクさせる)" Margin="0,0,0,6" IsChecked="{Binding EaseInteger, Mode=TwoWay}"
                                                  Visibility="{Binding HasEaseInteger, Converter={StaticResource B2V}}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding AnimExplain}" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- ===== アイテムタブ: 図形の種類を選ぶ画面(エフェクトの追加画面と同じ形) ===== -->
        <DataTemplate x:Key="ShapePickerTpl">
            <Border Background="{StaticResource Bg}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                    BorderBrush="{StaticResource Accent}" BorderThickness="1"
                    Visibility="{Binding IsOpen, Converter={StaticResource B2V}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource Field}" Tag="図形を検索(名前・分類・読み・英語 例: あめ / rain)"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center" Margin="10,0"/>
                        <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE711;" Width="30" Height="30" ToolTip="閉じる" Command="{Binding CloseCommand}"/>
                    </Grid>
                    <!-- 2D / 3D (分類とは別) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="演出図形" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ToggleButton Style="{StaticResource PillToggle}" Content="2D" MinWidth="54" IsChecked="{Binding Show2D, Mode=TwoWay}" ToolTip="平面の演出図形を出します"/>
                        <ToggleButton Style="{StaticResource PillToggle}" Content="3D" MinWidth="54" IsChecked="{Binding Show3D, Mode=TwoWay}" ToolTip="立体の演出図形(演出3D)を出します"/>
                    </StackPanel>
                    <!-- 分類 -->
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="{StaticResource Card}" CornerRadius="12" Padding="10,3" Margin="0,0,5,5">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- 最近使ったもの -->
                    <StackPanel Visibility="{Binding HasRecent, Converter={StaticResource B2V}}" Margin="0,0,0,6">
                        <TextBlock Text="最近使った図形" Foreground="{StaticResource Sub}" FontSize="10" Margin="2,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource AccentBtn}" Content="{Binding Name}" Padding="10,4" Margin="0,0,6,6" ToolTip="{Binding Tip}"
                                            Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- 図形の一覧(クリックで切り替え) -->
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Shown}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FilledBtn}" Width="168" Padding="10,6" Margin="0,0,6,6" ToolTip="{Binding Tip}"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="{StaticResource Sub}" FontSize="10" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Category, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding SourceText, Mode=OneWay}" Foreground="{StaticResource Accent}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="エフェクトをクリックすると、選択中のアイテムに追加されます(続けて何個でも追加できます)" Foreground="{StaticResource Sub}" FontSize="10" Margin="2,6,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== アイテムタブ: 項目1行(数値・スイッチ・選択・文字・色) ===== -->
        <DataTemplate x:Key="ItemPropRowTpl">
            <Grid Margin="0,4" Background="Transparent" ContextMenu="{StaticResource ItemRowMenu}"
                  Visibility="{Binding IsVisible, Converter={StaticResource B2V}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Top" Margin="0,3,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" ToolTip="{Binding Tip}" Foreground="{StaticResource Sub}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE712;" Width="22" Height="24" FontSize="11"
                            ToolTip="デフォルトに戻す・デフォルトに設定(項目の右クリックでも開けます)"
                            ContextMenu="{StaticResource ItemRowMenu}" Click="ItemRowMenu_Click"/>
                </Grid>
                <StackPanel Grid.Column="1">
                    <!-- 数値(スライダー + 入力欄。アニメーション中は、終わりの値も) -->
                    <StackPanel Visibility="{Binding IsNumber, Converter={StaticResource B2V}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <Button Style="{StaticResource IconBtn}" Content="&#xE8C8;" Width="28" Height="28" FontSize="12"
                                        ToolTip="数値をコピー(移動している項目は、動かし方と各点の値も覚えます)" Command="{Binding CopyValueCommand}"/>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE77F;" Width="28" Height="28" FontSize="12" Margin="2,0,0,0"
                                        ToolTip="コピーした数値を貼り付け" Command="{Binding PasteValueCommand}"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <Slider Style="{StaticResource Seek}" IsMoveToPointEnabled="True" PreviewMouseLeftButtonUp="RangeSlider_Release"
                                        ToolTip="端まで動かしてマウスを離すと、範囲が今の倍に広がります(値を戻すと、元の範囲に戻ります)"
                                        Minimum="{Binding SliderMin}" Maximum="{Binding SliderMax}"
                                        Value="{Binding SliderValue, Mode=TwoWay, Delay=12}"/>
                                <TextBlock Text="{Binding RangeText}" Foreground="{StaticResource Sub}" FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Style="{StaticResource Field}" Width="78" TextAlignment="Right" KeyDown="ItemField_KeyDown"
                                     ToolTip="数字を入力して Enter(スライダーの範囲の外の値も入れられます)"
                                     Text="{Binding NumText, UpdateSourceTrigger=LostFocus}"/>
                            <ToggleButton Grid.Column="2" Style="{StaticResource PillToggle}" Margin="6,0,0,0" FontSize="11"
                                          Content="{Binding AnimButtonText}" IsChecked="{Binding AnimOpen, Mode=TwoWay}"
                                          ToolTip="時間とともに値を動かす(移動・キーフレーム)設定を開きます"
                                          Visibility="{Binding IsAnim, Converter={StaticResource B2V}}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Unit}" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                        <!-- 移動(キーフレーム): 動かし方・グラフ・各点の値 -->
                        <Border Background="{StaticResource Bg}" CornerRadius="8" Padding="12,10" Margin="0,6,0,2"
                                Visibility="{Binding AnimOpen, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AnimTypeChooserTpl}" Focusable="False"/>

                                <StackPanel Visibility="{Binding IsAnimated, Converter={StaticResource B2V}}" Margin="0,12,0,0">
                                    <TextBlock Text="② 値を決める" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding GraphModeHint, StringFormat='グラフは、左がアイテムの始まり、右が終わり。{0}'}"
                                               Foreground="{StaticResource Sub}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,4">
                                        <ToggleButton Style="{StaticResource PillToggle}" Content="点を動かす" Margin="0,0,6,4" Padding="10,2" FontSize="11"
                                                      ToolTip="ふつうのモード: 点を上下にドラッグ・線の上をドラッグで中間点を追加" IsChecked="{Binding GraphModeNormal, Mode=TwoWay}"/>
                                        <ToggleButton Style="{StaticResource PillToggle}" Content="✎ 手書き" Margin="0,0,6,4" Padding="10,2" FontSize="11"
                                                      ToolTip="グラフの上をマウスでなぞると、その形がそのまま動きになります" IsChecked="{Binding GraphModeDraw, Mode=TwoWay}"/>
                                        <ToggleButton Style="{StaticResource PillToggle}" Content="⇔ 中間点を横にも動かす" Margin="0,0,6,4" Padding="10,2" FontSize="11"
                                                      ToolTip="中間点を左右(いつ)にもドラッグできます。Shift を押しながらで、左右だけ" IsChecked="{Binding GraphModeSlide, Mode=TwoWay}"/>
                                    </WrapPanel>
                                    <local:AnimGraph Height="170" Margin="0,0,0,10" Row="{Binding}" Version="{Binding GraphVersion}" Mode="{Binding GraphMode}"/>
                                    <ItemsControl ItemsSource="{Binding AnimPoints}" ItemTemplate="{StaticResource AnimPointRowTpl}"/>
                                    <WrapPanel Margin="0,2,0,0">
                                        <Button Style="{StaticResource AccentBtn}" Content="⛶ グラフを大きく開く" Padding="10,3" FontSize="11" Margin="0,0,6,6"
                                                ToolTip="グラフを、このタブいっぱいに大きく表示します(Esc で閉じる)" Command="{Binding OpenGraphCommand}"/>
                                        <Button Style="{StaticResource FilledBtn}" Content="⇄ 始点と終点を入れ替え" Padding="10,3" FontSize="11" Margin="0,0,6,6"
                                                ToolTip="動く向きを逆にします" Command="{Binding SwapPointsCommand}"/>
                                        <Button Style="{StaticResource FilledBtn}" Content="＋ 中間点を追加" Padding="10,3" FontSize="11" Margin="0,0,6,6"
                                                ToolTip="終点の手前に、通過する点を1つ足します" Command="{Binding AddPointCommand}"
                                                Visibility="{Binding CanEditPoints, Converter={StaticResource B2V}}"/>
                                        <Button Style="{StaticResource FilledBtn}" Content="− 中間点を削除" Padding="10,3" FontSize="11" Margin="0,0,6,6"
                                                ToolTip="最後の中間点を消します(始点と終点は残ります)" Command="{Binding RemovePointCommand}"
                                                Visibility="{Binding CanEditPoints, Converter={StaticResource B2V}}"/>
                                    </WrapPanel>
                                    <TextBlock Foreground="{StaticResource Sub}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="中間点は、このアイテムの中で移動しているすべての項目に、同じ位置で入ります(YMM4の仕組み)。ほかの項目には、いまの動きが変わらない値が入ります。うまくいかない時は、Ctrl + Z で元に戻せます。"
                                               Visibility="{Binding PointsLocked, Converter={StaticResource B2V}}"/>
                                </StackPanel>
                                <Expander Header="そのほか" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,6,0,0">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="すべての動かし方から選ぶ" Foreground="{StaticResource Sub}" FontSize="10" Margin="0,0,0,3"/>
                                        <ComboBox MinWidth="230" HorizontalAlignment="Left" Margin="0,0,0,8" ItemsSource="{Binding AnimTypeChoices}" SelectedIndex="{Binding AnimTypeIndex, Mode=TwoWay}"/>
                                        <Button Style="{StaticResource FilledBtn}" Content="うまく動かない時: 内部データをコピー" Padding="8,2" FontSize="10" HorizontalAlignment="Left"
                                                ToolTip="この項目の移動の内部データを、クリップボードへコピーします(不具合の調査用)" Command="{Binding CopyAnimInfoCommand}"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <CheckBox Style="{StaticResource Check}" Margin="0,7,0,0" IsChecked="{Binding BoolValue, Mode=TwoWay}"
                              Visibility="{Binding IsBool, Converter={StaticResource B2V}}"/>
                    <ComboBox HorizontalAlignment="Left" MinWidth="180" ItemsSource="{Binding Choices}" SelectedIndex="{Binding ChoiceIndex, Mode=TwoWay}"
                              Visibility="{Binding IsPlainEnum, Converter={StaticResource B2V}}"/>
                    <!-- 図形の種類: 分類つきの専用の選択画面 -->
                    <StackPanel Visibility="{Binding IsShapeRow, Converter={StaticResource B2V}}">
                        <ToggleButton Style="{StaticResource PillToggle}" HorizontalAlignment="Left" Padding="12,5" Cursor="Hand"
                                      IsChecked="{Binding ShapePicker.IsOpen, Mode=TwoWay}" ToolTip="クリックで、分類ごとの図形の一覧を開きます">
                            <TextBlock><Run Text="{Binding CurrentChoiceText, Mode=OneWay}"/><Run Text="   ▾ 図形を変える" Foreground="{StaticResource Sub}"/></TextBlock>
                        </ToggleButton>
                        <!-- 演出図形だけ: 同じ図形の 2D 版と 3D 版を切り替える(図形の設定は引き継ぐ) -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsEffectShape, Converter={StaticResource B2V}}">
                            <TextBlock Text="描き方" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ToggleButton Style="{StaticResource PillToggle}" Content="2D" MinWidth="54" IsChecked="{Binding IsShape2D, Mode=TwoWay}" ToolTip="平面の図形で描きます"/>
                            <ToggleButton Style="{StaticResource PillToggle}" Content="3D" MinWidth="54" IsChecked="{Binding IsShape3D, Mode=TwoWay}" ToolTip="立体の図形(演出3D)で描きます。色や数などの設定は引き継ぎます"/>
                        </StackPanel>
                        <ContentControl Content="{Binding ShapePicker}" ContentTemplate="{StaticResource ShapePickerTpl}" Focusable="False" Margin="0,8,0,0"/>
                    </StackPanel>
                    <!-- フォント: ボタンを押すと、検索つきの一覧が開く(名前を、そのフォントで表示) -->
                    <StackPanel Visibility="{Binding IsFont, Converter={StaticResource B2V}}">
                        <ToggleButton x:Name="fontButton" HorizontalAlignment="Left" MinWidth="260" Cursor="Hand" IsChecked="{Binding FontOpen, Mode=TwoWay}"
                                      IsHitTestVisible="{Binding FontClosed}" ToolTip="クリックで、フォントの一覧を開きます">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TextValue}" FontFamily="{Binding CurrentFontFamily}" FontSize="15" Foreground="{StaticResource Text}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="10" Foreground="{StaticResource Sub}" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{Binding FontOpen, Mode=TwoWay}" StaysOpen="False" Placement="Bottom" AllowsTransparency="True"
                               PlacementTarget="{Binding ElementName=fontButton}">
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,4,8,8" Width="420">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource Field}" Tag="フォントを検索(名前の一部)" Text="{Binding FontSearch, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FontCountText}" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center" Margin="10,0,2,0"/>
                                    </Grid>
                                    <StackPanel Visibility="{Binding HasRecentFonts, Converter={StaticResource B2V}}" Margin="0,0,0,8">
                                        <TextBlock Text="最近使ったフォント" Foreground="{StaticResource Sub}" FontSize="10" Margin="2,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding RecentFonts}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource FilledBtn}" Padding="10,4" Margin="0,0,6,6" ToolTip="{Binding Name}"
                                                            Command="{Binding DataContext.PickFontCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="14" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding FontList}" Height="320" Background="Transparent" BorderThickness="0"
                                             ItemContainerStyle="{StaticResource Row}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Cursor="Hand" ToolTip="クリックで、このフォントにします"
                                                        Command="{Binding DataContext.PickFontCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid Background="Transparent" Margin="0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="170"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="あいう 永遠 ABC abc 123" FontFamily="{Binding Family}" FontSize="16"
                                                                           Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <TextBox Style="{StaticResource Field}" KeyDown="ItemField_KeyDown" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                             Loaded="ItemTextBox_Loaded"
                             Visibility="{Binding IsText, Converter={StaticResource B2V}}"/>
                    <TextBox Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" MaxHeight="240"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Loaded="ItemTextBox_Loaded"
                             PreviewKeyDown="ItemMultiline_PreviewKeyDown"
                             Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsMultiline, Converter={StaticResource B2V}}"/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsColor, Converter={StaticResource B2V}}">
                        <ToggleButton x:Name="colorSwatch" Width="46" Height="30" Margin="0,0,8,0" Cursor="Hand" IsChecked="{Binding PaletteOpen, Mode=TwoWay}"
                                      IsHitTestVisible="{Binding PaletteClosed}"
                                      ToolTip="クリックで、カラーパレットを開きます">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border CornerRadius="6" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Background="{Binding ColorBrush}"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBox Style="{StaticResource Field}" Width="104" KeyDown="ItemField_KeyDown" ToolTip="#AARRGGBB または #RRGGBB"
                                 Text="{Binding ColorText, UpdateSourceTrigger=LostFocus}"/>
                        <ItemsControl ItemsSource="{Binding QuickColors}" Margin="10,0,0,0" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="20" Height="20" Margin="0,0,4,0" Cursor="Hand"
                                            Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Hex}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{Binding Brush}" CornerRadius="10" BorderBrush="{StaticResource Stroke}" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- カラーパレット(色の一覧 + 赤・緑・青・不透明度のスライダー) -->
                        <Popup IsOpen="{Binding PaletteOpen, Mode=TwoWay}" StaysOpen="False" Placement="Bottom" AllowsTransparency="True"
                               PlacementTarget="{Binding ElementName=colorSwatch}">
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,4,8,8">
                                <StackPanel Width="296">
                                    <local:ColorPad Height="170" Margin="0,0,0,10" Cursor="Cross"
                                                    ToolTip="左の四角: 鮮やかさ(横)と明るさ(縦) / 右の帯: 色あい。ドラッグで決めます"
                                                    SelectedColor="{Binding PadColor, Mode=TwoWay, Delay=12}"/>
                                    <ItemsControl ItemsSource="{Binding Palette}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="12"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Height="22" Margin="1" Cursor="Hand" ToolTip="{Binding Hex}"
                                                        Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Hex}">
                                                    <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{Binding Brush}" CornerRadius="3" BorderBrush="{StaticResource Stroke}" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="赤" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" Style="{StaticResource Seek}" Minimum="0" Maximum="255" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                                Value="{Binding ColorR, Mode=TwoWay, Delay=12}"/>
                                        <TextBlock Grid.Row="1" Text="緑" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource Seek}" Minimum="0" Maximum="255" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                                Value="{Binding ColorG, Mode=TwoWay, Delay=12}"/>
                                        <TextBlock Grid.Row="2" Text="青" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource Seek}" Minimum="0" Maximum="255" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                                Value="{Binding ColorB, Mode=TwoWay, Delay=12}"/>
                                        <TextBlock Grid.Row="3" Text="不透明度" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="3" Grid.Column="1" Style="{StaticResource Seek}" Minimum="0" Maximum="255" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                                Value="{Binding ColorA, Mode=TwoWay, Delay=12}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Width="46" Height="26" CornerRadius="5" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Background="{Binding ColorBrush}" Margin="0,0,8,0"/>
                                        <TextBox Style="{StaticResource Field}" Width="110" KeyDown="ItemField_KeyDown" ToolTip="#AARRGGBB または #RRGGBB"
                                                 Text="{Binding ColorText, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ===== アイテムタブ: エフェクト1つ分 ===== -->
        <DataTemplate x:Key="ItemEffectCardTpl">
            <Border Background="{StaticResource Card}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource Check}" VerticalAlignment="Center" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  ToolTip="このエフェクトのオン・オフ"/>
                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsOpen, Mode=TwoWay}" Cursor="Hand" Margin="6,0,0,0"
                                      ToolTip="クリックで、中の項目を開く・閉じる">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="2,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                            <TextBlock Text="{Binding RowsText}" Foreground="{StaticResource Sub}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource IconBtn}" Content="&#xE74A;" Width="28" Height="28" ToolTip="上へ(先に掛ける)" Command="{Binding MoveUpCommand}"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE74B;" Width="28" Height="28" Margin="2,0,0,0" ToolTip="下へ(後に掛ける)" Command="{Binding MoveDownCommand}"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="28" Height="28" Margin="2,0,0,0" ToolTip="このエフェクトを外す" Command="{Binding RemoveCommand}"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{DynamicResource ItemPropRowTpl}" Margin="0,6,0,2"
                                  Visibility="{Binding IsOpen, Converter={StaticResource B2V}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== アイテムタブ: エフェクトを選んで追加する画面 ===== -->
        <DataTemplate x:Key="EffectPickerTpl">
            <Border Background="{StaticResource Bg}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                    BorderBrush="{StaticResource Accent}" BorderThickness="1"
                    Visibility="{Binding IsOpen, Converter={StaticResource B2V}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource Field}" Tag="エフェクトを検索(名前・分類・読み・英語)"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center" Margin="10,0"/>
                        <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE711;" Width="30" Height="30" ToolTip="閉じる" Command="{Binding CloseCommand}"/>
                    </Grid>
                    <!-- 分類 -->
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="{StaticResource Card}" CornerRadius="12" Padding="10,3" Margin="0,0,5,5">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- 最近使ったもの -->
                    <StackPanel Visibility="{Binding HasRecent, Converter={StaticResource B2V}}" Margin="0,0,0,6">
                        <TextBlock Text="最近使ったエフェクト" Foreground="{StaticResource Sub}" FontSize="10" Margin="2,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource AccentBtn}" Content="{Binding Name}" Padding="10,4" Margin="0,0,6,6" ToolTip="{Binding Tip}"
                                            Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- エフェクトの一覧(クリックで追加) -->
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Shown}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FilledBtn}" Width="168" Padding="10,6" Margin="0,0,6,6" ToolTip="{Binding Tip}"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="{StaticResource Sub}" FontSize="10" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Category, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding SourceText, Mode=OneWay}" Foreground="{StaticResource Accent}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="エフェクトをクリックすると、選択中のアイテムに追加されます(続けて何個でも追加できます)" Foreground="{StaticResource Sub}" FontSize="10" Margin="2,6,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- ===== AI音声生成: サーバーが教えてくれた入力欄1つ ===== -->
        <DataTemplate x:Key="McpFieldTpl">

                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" ToolTip="{Binding Tip}" Foreground="{StaticResource Sub}" FontSize="12"
                                                                   VerticalAlignment="Top" Margin="0,7,10,0" TextWrapping="Wrap"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBox Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalContentAlignment="Top"
                                                                     ToolTip="{Binding Tip}" Tag="例: Calm lofi hip hop with soft piano, 80 BPM(英語の方が、思い通りになりやすいです)"
                                                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                     Visibility="{Binding IsLongText, Converter={StaticResource B2V}}"/>
                                                            <Grid Visibility="{Binding IsSingleLine, Converter={StaticResource B2V}}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Style="{StaticResource Field}" ToolTip="{Binding Tip}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <Button Grid.Column="1" Style="{StaticResource FilledBtn}" Content="選択中の素材を使う" Padding="10,4" Margin="6,0,0,0"
                                                                        ToolTip="素材データベースで選んでいる音声の場所を入れます"
                                                                        Command="{Binding DataContext.UseSelectedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" Visibility="{Binding IsPath, Converter={StaticResource B2V}}"/>
                                                            </Grid>
                                                            <TextBox Style="{StaticResource Field}" Width="140" HorizontalAlignment="Left" TextAlignment="Right" ToolTip="{Binding Tip}"
                                                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                     Visibility="{Binding IsNumber, Converter={StaticResource B2V}}"/>
                                                            <CheckBox Style="{StaticResource Check}" Margin="0,7,0,0" ToolTip="{Binding Tip}" IsChecked="{Binding Flag}"
                                                                      Visibility="{Binding IsBool, Converter={StaticResource B2V}}"/>
                                                            <ComboBox MinWidth="200" HorizontalAlignment="Left" ToolTip="{Binding Tip}" ItemsSource="{Binding Choices}"
                                                                      SelectedItem="{Binding Choice, Mode=TwoWay}"
                                                                      Visibility="{Binding IsChoice, Converter={StaticResource B2V}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>

    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource Bg}" TextElement.Foreground="{StaticResource Text}">
        <!-- Ctrl + ホイールで、画面全体の表示倍率を変える -->
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== タブ(機能切り替え): エクスプローラー + テンプレート1〜n ===== -->
        <Border Grid.Row="0" Background="{StaticResource Bg}" Padding="10,6,6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="TabScroll" Grid.Column="0" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Hidden" PreviewMouseWheel="TabScroll_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="1" Height="18" Fill="{StaticResource Stroke}" Margin="6,0,10,6"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsGroupStart, Converter={StaticResource B2V}}"/>
                                    <RadioButton Style="{StaticResource TabBtn}" IsChecked="{Binding IsSelected}">
                                        <TextBlock Text="{Binding Name}"/>
                                    </RadioButton>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE713;" Width="32" Height="32"
                        Margin="6,0,0,6" VerticalAlignment="Center" ToolTip="設定(タブの数・名前)"
                        Command="{Binding ToggleSettingsPageCommand}"/>
            </Grid>
        </Border>

        <!-- ===== エクスプローラータブ ===== -->
        <Grid Grid.Row="1" Visibility="{Binding ShowExplorerView, Converter={StaticResource B2V}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== ナビゲーションバー ===== -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="12,10,12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource IconBtn}" Content="&#xE72B;" ToolTip="戻る" Command="{Binding BackCommand}"/>
                <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE72A;" ToolTip="進む" Command="{Binding ForwardCommand}"/>
                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE74A;" ToolTip="上の階層へ" Command="{Binding UpCommand}"/>
                <Button Grid.Column="3" Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="更新" Command="{Binding RefreshCommand}"/>
                <TextBox Grid.Column="4" Style="{StaticResource Field}" Margin="8,0,0,0" MinWidth="80"
                         Tag="パスを入力して Enter"
                         Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding GoCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <ToggleButton Grid.Column="5" Style="{StaticResource PillToggle}" Content="詳細パネル" Margin="8,0,0,0"
                              ToolTip="右側の詳細・タグ編集パネルの表示/非表示を切り替えます"
                              IsChecked="{Binding IsDetailOpen}"/>
            </Grid>
        </Border>

        <!-- ===== 検索バー ===== -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" Padding="12,0,12,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBox Style="{StaticResource Field}" Width="210" Margin="0,0,8,4"
                         Tag="名前で検索 (スペースでAND)"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Style="{StaticResource Field}" Width="170" Margin="0,0,12,4"
                         Tag="拡張子 (例: mp4 png)"
                         Text="{Binding ExtFilter, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,10,4" VerticalAlignment="Center">
                    <TextBlock Text="更新日" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton Style="{StaticResource PillToggle}" Content="すべて"
                                 IsChecked="{Binding DatePreset, Converter={StaticResource Eq}, ConverterParameter=0}"/>
                    <RadioButton Style="{StaticResource PillToggle}" Content="今日"
                                 IsChecked="{Binding DatePreset, Converter={StaticResource Eq}, ConverterParameter=1}"/>
                    <RadioButton Style="{StaticResource PillToggle}" Content="7日"
                                 IsChecked="{Binding DatePreset, Converter={StaticResource Eq}, ConverterParameter=2}"/>
                    <RadioButton Style="{StaticResource PillToggle}" Content="30日"
                                 IsChecked="{Binding DatePreset, Converter={StaticResource Eq}, ConverterParameter=3}"/>
                    <RadioButton Style="{StaticResource PillToggle}" Content="1年"
                                 IsChecked="{Binding DatePreset, Converter={StaticResource Eq}, ConverterParameter=4}"/>
                </StackPanel>

                <ToggleButton Style="{StaticResource PillToggle}" Content="サブフォルダーも検索" Margin="0,0,10,4"
                              IsChecked="{Binding IncludeSub}"/>

                <Button Style="{StaticResource FilledBtn}" Margin="0,0,8,4" Padding="12,5"
                        Command="{Binding ClearTagFilterCommand}"
                        Visibility="{Binding HasTagFilter, Converter={StaticResource B2V}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EC;" Foreground="{StaticResource Accent}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TagFilter}"/>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="10" Margin="8,0,0,0" Foreground="{StaticResource Sub}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource FilledBtn}" Content="条件をクリア" Margin="0,0,0,4" Padding="12,5"
                        Command="{Binding ClearFiltersCommand}"/>

                <StackPanel Orientation="Horizontal" Margin="12,0,0,4" VerticalAlignment="Center">
                    <TextBlock Text="並び替え" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="詳細表示では列の見出しをクリックしても変更できます"/>
                    <RadioButton Style="{StaticResource PillToggle}" Content="名前"
                                 IsChecked="{Binding SortIndex, Converter={StaticResource Eq}, ConverterParameter=0}"/>
                    <RadioButton Style="{StaticResource PillToggle}" Content="更新日時"
                                 IsChecked="{Binding SortIndex, Converter={StaticResource Eq}, ConverterParameter=1}"/>
                    <RadioButton Style="{StaticResource PillToggle}" Content="作成日時"
                                 IsChecked="{Binding SortIndex, Converter={StaticResource Eq}, ConverterParameter=2}"/>
                    <RadioButton Style="{StaticResource PillToggle}" Content="種類"
                                 IsChecked="{Binding SortIndex, Converter={StaticResource Eq}, ConverterParameter=3}"/>
                    <RadioButton Style="{StaticResource PillToggle}" Content="サイズ"
                                 IsChecked="{Binding SortIndex, Converter={StaticResource Eq}, ConverterParameter=4}"/>
                    <ToggleButton Style="{StaticResource PillToggle}" Content="降順" Margin="4,0,6,0"
                                  ToolTip="オフ=昇順(小さい順・古い順・A→Z) / オン=降順"
                                  IsChecked="{Binding SortDescending}"/>
                    <ToggleButton Style="{StaticResource PillToggle}" Content="フォルダーを先頭" Margin="0"
                                  IsChecked="{Binding FoldersFirst}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="12,0,0,4" VerticalAlignment="Center">
                    <Button Style="{StaticResource FilledBtn}" Content="すべて選択 (Ctrl+A)" Padding="12,5" Margin="0,0,6,0"
                            ToolTip="空きスペースをドラッグしても範囲選択できます" Click="FileSelectAll_Click"/>
                    <Button Style="{StaticResource FilledBtn}" Content="選択解除" Padding="12,5" Click="FileClearSelection_Click"/>
                </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="12,0,10,4" VerticalAlignment="Center">
                    <TextBlock Text="表示" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="Ctrl + Shift + マウスホイールでも切り替えできます(Ctrl + ホイールは、画面全体の表示倍率)"/>
                    <RadioButton Style="{StaticResource PillToggle}" Content="詳細"
                                 IsChecked="{Binding ViewMode, Converter={StaticResource Eq}, ConverterParameter=0}"/>
                    <RadioButton Style="{StaticResource PillToggle}" Content="一覧"
                                 IsChecked="{Binding ViewMode, Converter={StaticResource Eq}, ConverterParameter=1}"/>
                    <RadioButton Style="{StaticResource PillToggle}" Content="小"
                                 IsChecked="{Binding ViewMode, Converter={StaticResource Eq}, ConverterParameter=2}"/>
                    <RadioButton Style="{StaticResource PillToggle}" Content="中"
                                 IsChecked="{Binding ViewMode, Converter={StaticResource Eq}, ConverterParameter=3}"/>
                    <RadioButton Style="{StaticResource PillToggle}" Content="大"
                                 IsChecked="{Binding ViewMode, Converter={StaticResource Eq}, ConverterParameter=4}"/>
                    <RadioButton Style="{StaticResource PillToggle}" Content="特大" Margin="0"
                                 IsChecked="{Binding ViewMode, Converter={StaticResource Eq}, ConverterParameter=5}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ===== 本体 ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideCol" Width="190"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- サイドバー -->
            <ScrollViewer local:WheelFix.Enabled="True" x:Name="SidePane" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="6,6,0,6">
                <StackPanel>
                    <TextBlock Text="場所" Foreground="{StaticResource Sub}" FontSize="12" Margin="10,6,0,4"/>
                    <ItemsControl ItemsSource="{Binding Places}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavBtn}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Path}" ToolTip="{Binding Path}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Width="22"
                                                   Foreground="{StaticResource Accent}"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="タグ" Foreground="{StaticResource Sub}" FontSize="12" Margin="10,16,0,4"/>
                    <TextBlock Text="ファイルを選んでタグを追加できます" Foreground="{StaticResource Sub}" FontSize="11"
                               TextWrapping="Wrap" Margin="10,0,6,0"
                               Visibility="{Binding HasNoTags, Converter={StaticResource B2V}}"/>
                    <ItemsControl ItemsSource="{Binding AllTags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavBtn}"
                                        Command="{Binding DataContext.FilterTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Name}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{StaticResource Sub}" FontSize="11"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ファイル一覧カード -->
            <Border Grid.Column="1" Margin="6" Background="{StaticResource Panel}" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 列ヘッダー -->
                    <Grid Grid.Row="0" Margin="14,4,24,0"
                          Visibility="{Binding IsDetails, Converter={StaticResource B2V}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource HeaderBtn}" Content="{Binding HeaderName}"
                                Command="{Binding SortCommand}" CommandParameter="Name" Margin="46,0,0,0"/>
                        <Button Grid.Column="1" Style="{StaticResource HeaderBtn}" Content="{Binding HeaderModified}"
                                Command="{Binding SortCommand}" CommandParameter="Modified"/>
                        <Button Grid.Column="2" Style="{StaticResource HeaderBtn}" Content="{Binding HeaderType}"
                                Command="{Binding SortCommand}" CommandParameter="Type"/>
                        <Button Grid.Column="3" Style="{StaticResource HeaderBtn}" Content="{Binding HeaderSize}"
                                Command="{Binding SortCommand}" CommandParameter="Size"/>
                        <TextBlock Grid.Column="4" Text="タグ" Foreground="{StaticResource Sub}" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="True" BorderThickness="0"
                                 Background="Transparent" Foreground="{StaticResource Accent}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"/>

                    <!-- 一覧 -->
                    <ListBox x:Name="FileList" Grid.Row="2" ItemsSource="{Binding Items}"
                             Style="{StaticResource FileListStyle}"
                             SelectionChanged="FileList_SelectionChanged"
                             MouseDoubleClick="FileList_MouseDoubleClick"
                             PreviewKeyDown="FileList_PreviewKeyDown"
                             PreviewMouseWheel="FileList_PreviewMouseWheel"
                             PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="開く" InputGestureText="Enter"
                                          Command="{Binding PlacementTarget.DataContext.OpenSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="プレビュー" InputGestureText="Space"
                                          Command="{Binding PlacementTarget.DataContext.PreviewSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Windowsのエクスプローラーで表示"
                                          Command="{Binding PlacementTarget.DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="パスをコピー"
                                          Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="素材データベースに追加"
                                          Command="{Binding PlacementTarget.DataContext.AddToMaterialsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="プロパティ" InputGestureText="Alt+Enter"
                                          Command="{Binding PlacementTarget.DataContext.ShowPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <Canvas Grid.Row="2" IsHitTestVisible="False">
                        <Rectangle x:Name="FileRubberRect" Visibility="Collapsed" Fill="#4060CDFF"
                                   Stroke="{StaticResource Accent}" StrokeThickness="1"/>
                    </Canvas>

                    <!-- ステータスバー -->
                    <Border Grid.Row="3" Padding="16,7" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Sub}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 詳細・タグ編集ペイン -->
            <Border x:Name="DetailPane" Grid.Column="2" Width="280" Margin="0,6,6,6" Padding="16,12,16,16" CornerRadius="10"
                    Background="{StaticResource Panel}"
                    Visibility="{Binding IsDetailOpen, Converter={StaticResource B2V}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 見出し + 設定ボタン -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="詳細" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Visibility="{Binding IsSettingsClosed, Converter={StaticResource B2V}}"/>
                        <TextBlock Text="詳細パネルの設定" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Visibility="{Binding IsSettingsOpen, Converter={StaticResource B2V}}"/>
                        <Button Style="{StaticResource IconBtn}" Content="&#xE713;" HorizontalAlignment="Right"
                                Width="30" Height="30" ToolTip="詳細パネルに表示する情報を選ぶ"
                                Command="{Binding ToggleSettingsCommand}"/>
                    </Grid>

                    <!-- 設定: 表示する情報を選ぶ -->
                    <ScrollViewer local:WheelFix.Enabled="True" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsSettingsOpen, Converter={StaticResource B2V}}">
                        <StackPanel>
                            <TextBlock Text="ファイルを選んだ時に、ここに表示する情報を選びます"
                                       Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <CheckBox Style="{StaticResource Check}" Content="サムネイル"
                                      IsChecked="{Binding ShowDetailThumbnail}"/>
                            <ItemsControl ItemsSource="{Binding DetailOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource Check}" Content="{Binding Label}"
                                                  IsChecked="{Binding IsChecked}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource FilledBtn}" Content="初期設定に戻す" Margin="0,6,0,6"
                                    Command="{Binding ResetDetailFieldsCommand}"/>
                            <Button Style="{StaticResource AccentBtn}" Content="完了"
                                    Command="{Binding ToggleSettingsCommand}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 通常の詳細 -->
                    <Grid Grid.Row="1" Visibility="{Binding IsSettingsClosed, Converter={StaticResource B2V}}">
                <!-- 未選択時の案内 -->
                <TextBlock Text="ファイルやフォルダーを選択すると、ここに詳細とタグ編集が表示されます"
                           Foreground="{StaticResource Sub}" TextWrapping="Wrap" LineHeight="20"
                           VerticalAlignment="Top"
                           Visibility="{Binding HasNoSelection, Converter={StaticResource B2V}}"/>
                <ScrollViewer local:WheelFix.Enabled="True" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelection, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <Grid HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding DetailGlyph}"
                                       Foreground="{Binding DetailBrush}" FontSize="44" HorizontalAlignment="Left"
                                       Visibility="{Binding HasNoDetailThumb, Converter={StaticResource B2V}}"/>
                            <Image Source="{Binding DetailThumb}" MaxHeight="170" Stretch="Uniform"
                                   HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <TextBlock Text="{Binding DetailTitle}" FontSize="15" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,10,0,10"/>
                        <StackPanel Visibility="{Binding HasDetailItem, Converter={StaticResource B2V}}">
                            <TextBlock Text="ショートカットキー" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,8,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <local:KeyRecorder Style="{StaticResource Field}" Keys="{Binding DetailShortcutKeys, Mode=TwoWay}" ToolTip="クリックして、割り当てたいキーを実際に押すと記録されます(Delete: 解除 / Esc: 取りやめ)"/>
                                <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="32" Height="32" Margin="6,0,0,0"
                                        ToolTip="このショートカットを削除" Click="ClearKeyRecorder_Click"/>
                            </Grid>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding DetailRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Sub}" FontSize="11"/>
                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Height="1" Fill="{StaticResource Stroke}" Margin="0,14"/>

                        <TextBlock Text="タグ" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding SelectedTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Brush}" CornerRadius="11" Margin="0,0,6,6" Padding="10,2,3,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="#14161A" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE711;" FontSize="9"
                                                    Width="20" Height="20" Foreground="#14161A" ToolTip="このタグを外す"
                                                    Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Name}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource Field}" Tag="新しいタグ名"
                                     Text="{Binding NewTagText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddTagCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Style="{StaticResource AccentBtn}" Content="追加"
                                    Margin="6,0,0,0" Height="34" Command="{Binding AddTagCommand}"/>
                        </Grid>

                        <TextBlock Text="既存のタグから追加" Foreground="{StaticResource Sub}" FontSize="12" Margin="0,14,0,6"/>
                        <ItemsControl ItemsSource="{Binding AllTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FilledBtn}" Margin="0,0,6,6" Padding="10,3"
                                            Command="{Binding DataContext.AddTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Name}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Height="1" Fill="{StaticResource Stroke}" Margin="0,10,0,14"/>

                        <Button Style="{StaticResource AccentBtn}" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                Command="{Binding PreviewSelectedCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE890;" Width="24"/>
                                <TextBlock Text="プレビュー (Space)"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FilledBtn}" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                Command="{Binding ShowInExplorerCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" Width="24"/>
                                <TextBlock Text="Windowsのエクスプローラーで表示"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FilledBtn}" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                Command="{Binding CopyPathCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" Width="24"/>
                                <TextBlock Text="パスをコピー"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="テンプレートに追加(追加先を選ぶ)" Foreground="{StaticResource Sub}" FontSize="11"
                                   Margin="0,4,0,5"/>
                        <ItemsControl ItemsSource="{Binding TemplateGroup.VisibleTabs}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FilledBtn}" Content="{Binding Slot}"
                                            MinWidth="34" Padding="8,5" Margin="0,0,5,5"
                                            ToolTip="{Binding DisplayName}" CommandParameter="{Binding Slot}"
                                            Command="{Binding DataContext.AddToSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource FilledBtn}" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                Command="{Binding DownloadCloudCommand}"
                                Visibility="{Binding HasCloudOnlySelected, Converter={StaticResource B2V}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" Width="24"/>
                                <TextBlock Text="クラウドからダウンロード"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FilledBtn}" HorizontalContentAlignment="Left"
                                Command="{Binding ShowPropertiesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" Width="24"/>
                                <TextBlock Text="プロパティ (Alt+Enter)"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </Grid>

        <!-- ===== テンプレートタブ ===== -->
        <Grid Grid.Row="1" Visibility="{Binding ShowTemplateView, Converter={StaticResource B2V}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ツールバー -->
            <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="12,10,12,4">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentBtn}" Content="＋ ファイルを追加" Margin="0,0,8,6"
                                Click="AddTemplateFile_Click"/>
                        <Button Style="{StaticResource FilledBtn}" Content="＋ フォルダーを追加" Margin="0,0,8,6"
                                Click="AddTemplateFolder_Click"/>
                        <Button Style="{StaticResource FilledBtn}" Content="エクスプローラーで選択中の項目を追加" Margin="0,0,16,6"
                                Command="{Binding AddToTemplateCommand}"/>
                        <Button Style="{StaticResource FilledBtn}" Content="すべて選択 (Ctrl+A)" Margin="0,0,8,6"
                                Click="TemplateSelectAll_Click"/>
                        <Button Style="{StaticResource FilledBtn}" Content="選択解除" Margin="0,0,8,6"
                                Click="TemplateClearSelection_Click"/>
                        <Button Style="{StaticResource FilledBtn}" Content="選択をテンプレートから削除 (Delete)" Margin="0,0,0,6"
                                Command="{Binding RemoveTemplateCommand}"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                        <TextBlock Text="並べ替え" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,10,0"
                                   ToolTip="選んだ項目をまとめて移動します"/>
                        <Button Style="{StaticResource FilledBtn}" Content="◀ 前へ" Padding="12,5" Margin="0,0,6,0"
                                ToolTip="1つ前へ (Alt+←)" Command="{Binding MoveTemplatesCommand}" CommandParameter="up"/>
                        <Button Style="{StaticResource FilledBtn}" Content="後ろへ ▶" Padding="12,5" Margin="0,0,6,0"
                                ToolTip="1つ後ろへ (Alt+→)" Command="{Binding MoveTemplatesCommand}" CommandParameter="down"/>
                        <Button Style="{StaticResource FilledBtn}" Content="先頭へ" Padding="12,5" Margin="0,0,6,0"
                                Command="{Binding MoveTemplatesCommand}" CommandParameter="top"/>
                        <Button Style="{StaticResource FilledBtn}" Content="末尾へ" Padding="12,5" Margin="0,0,12,0"
                                Command="{Binding MoveTemplatesCommand}" CommandParameter="bottom"/>
                        <TextBlock Text="タイルをドラッグして、好きな位置へ移動もできます" Foreground="{StaticResource Sub}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding TemplateSelectionText}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                        <TextBlock Text="空きスペースをドラッグで範囲選択 / Ctrl・Shiftクリックで複数選択 / 選択をまとめてタイムラインへドラッグ"
                                   Foreground="{StaticResource Sub}" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding TemplateMessage}" Foreground="{StaticResource Accent}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- テンプレート一覧 -->
                <Border Grid.Column="0" Margin="6" CornerRadius="10" Background="{StaticResource Panel}">
                    <Grid>
                        <TextBlock Text="テンプレートはまだありません&#x0A;「＋ ファイルを追加」か、ドラッグ&amp;ドロップで登録できます"
                                   Foreground="{StaticResource Sub}" TextAlignment="Center" LineHeight="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasNoTemplates, Converter={StaticResource B2V}}"/>
                        <ListBox x:Name="TemplateList" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Text}" SelectionMode="Extended" AllowDrop="True"
                                 ItemsSource="{Binding Templates}"
                                 ItemContainerStyle="{StaticResource Row}"
                                 ItemTemplate="{StaticResource TemplateTileTpl}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewKeyDown="TemplateList_PreviewKeyDown"
                                 SelectionChanged="TemplateList_SelectionChanged"
                                 MouseDoubleClick="TemplateList_MouseDoubleClick"
                                 DragOver="TemplateList_DragOver" DragLeave="TemplateList_DragLeave" Drop="TemplateList_Drop"
                                 PreviewMouseRightButtonDown="TemplateList_PreviewMouseRightButtonDown">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="プレビュー / 開く"
                                              Command="{Binding PlacementTarget.DataContext.OpenTemplateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="エクスプローラータブで場所を開く"
                                              Command="{Binding PlacementTarget.DataContext.RevealTemplateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="プロパティ"
                                              Command="{Binding PlacementTarget.DataContext.TemplatePropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="テンプレートから削除" InputGestureText="Delete"
                                              Command="{Binding PlacementTarget.DataContext.RemoveTemplateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        <!-- 範囲選択の枠(ドラッグ中だけ表示) -->
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="RubberRect" Visibility="Collapsed" Fill="#4060CDFF"
                                       Stroke="{StaticResource Accent}" StrokeThickness="1"/>
                            <Rectangle x:Name="TemplateInsertMark" Visibility="Collapsed" Fill="{StaticResource Accent}" RadiusX="1.5" RadiusY="1.5"/>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- 選んだテンプレートの編集 -->
                <Border Grid.Column="1" Width="280" Margin="0,6,6,6" Padding="16,14,16,16" CornerRadius="10"
                        Background="{StaticResource Panel}">
                    <ScrollViewer local:WheelFix.Enabled="True" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="テンプレートを1つ選ぶと、名前やメモを編集できます"
                                       Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Visibility="{Binding HasNoSelectedTemplate, Converter={StaticResource B2V}}"/>

                            <StackPanel Visibility="{Binding HasSelectedTemplate, Converter={StaticResource B2V}}">
                                <TextBlock Text="ショートカットキー" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,8,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <local:KeyRecorder Style="{StaticResource Field}" Keys="{Binding SelectedTemplate.ShortcutKeys, Mode=TwoWay}" ToolTip="クリックして、割り当てたいキーを実際に押すと記録されます(Delete: 解除 / Esc: 取りやめ)"/>
                                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="32" Height="32" Margin="6,0,0,0"
                                            ToolTip="このショートカットを削除" Click="ClearKeyRecorder_Click"/>
                                </Grid>
                                <Border CornerRadius="8" Background="{StaticResource Card}" ClipToBounds="True" Margin="0,0,0,12">
                                    <Grid MinHeight="120">
                                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding SelectedTemplate.Item.IconGlyph}"
                                                   Foreground="{Binding SelectedTemplate.Item.IconBrush}" FontSize="44"
                                                   HorizontalAlignment="Center"/>
                                        <Image Source="{Binding SelectedTemplate.DisplayThumb}" MaxHeight="190" Stretch="Uniform"
                                               Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                                <Button Style="{StaticResource FilledBtn}" Content="クリップボードの画像をサムネイルにする (Ctrl+V)" Margin="0,0,0,6"
                                        Command="{Binding PasteTemplateThumbnailCommand}"/>
                                <Button Style="{StaticResource FilledBtn}" Content="画像ファイルを選ぶ…" Margin="0,0,0,6"
                                        Click="TemplateThumbFile_Click"/>
                                <StackPanel Visibility="{Binding SelectedTemplate.CanPlayFrames, Converter={StaticResource B2V}}"
                                            Margin="0,4,0,8">
                                    <TextBlock Text="動画のコマからサムネイルを選ぶ" Foreground="{StaticResource Sub}"
                                               FontSize="11" Margin="0,0,0,6"/>
                                    <Border Background="Black" CornerRadius="8" ClipToBounds="True" Height="160">
                                        <MediaElement x:Name="TemplatePlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                                      ScrubbingEnabled="True" Stretch="Uniform" Volume="0.8"/>
                                    </Border>
                                    <Grid Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="TemplatePlayBtn" Style="{StaticResource IconBtn}" Content="&#xE768;"
                                                ToolTip="再生 / 一時停止"/>
                                        <Slider x:Name="TemplateSeek" Grid.Column="1" Style="{StaticResource Seek}" Margin="8,0"
                                                Minimum="0" Maximum="1" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button Style="{StaticResource AccentBtn}" Content="いま表示しているコマをサムネイルにする"
                                            Click="TemplateFrameThumb_Click"/>
                                </StackPanel>
                                <Button Style="{StaticResource FilledBtn}" Content="ファイル自身のサムネイルに戻す" Margin="0,0,0,12"
                                        Command="{Binding ClearTemplateThumbnailCommand}"/>

                                <TextBlock Text="名前" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding SelectedTemplate.Name, UpdateSourceTrigger=LostFocus}"
                                         Margin="0,0,0,10"/>
                                <TextBlock Text="メモ" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding SelectedTemplate.Memo, UpdateSourceTrigger=LostFocus}"
                                         Height="90" Padding="10,6" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding SelectedTemplate.StatusText}" Foreground="{StaticResource Sub}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedTemplate.Path}" Foreground="{StaticResource Sub}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,14"/>
                            </StackPanel>

                            <Button Style="{StaticResource AccentBtn}" Content="プレビュー / 開く" Margin="0,0,0,6"
                                    Command="{Binding OpenTemplateCommand}"/>
                            <Button Style="{StaticResource FilledBtn}" Content="エクスプローラータブで場所を開く" Margin="0,0,0,6"
                                    Command="{Binding RevealTemplateCommand}"/>
                            <Button Style="{StaticResource FilledBtn}" Content="プロパティ" Margin="0,0,0,6"
                                    Command="{Binding TemplatePropertiesCommand}"/>
                            <Button Style="{StaticResource FilledBtn}" Content="テンプレートから削除"
                                    Command="{Binding RemoveTemplateCommand}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== プリセットタブ ===== -->
        <Grid Grid.Row="1" Visibility="{Binding ShowPresetView, Converter={StaticResource B2V}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="12,10,12,4">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentBtn}" Content="クリップボードからプリセットを作成" Margin="0,0,8,6"
                                Click="CapturePreset_Click"/>
                        <Button Style="{StaticResource AccentBtn}" Content="選択中のアイテムから作成(確実な方式)" Margin="0,0,8,6"
                                ToolTip="YMM4のタイムラインで選択中のアイテムを、YMM4のアイテムテンプレートとして保存します。クリップボードを使わず、ダブルクリックでシークバーの位置に確実に配置できます"
                                Command="{Binding CreatePresetFromSelectionCommand}"/>
                        <Button Style="{StaticResource FilledBtn}" Content="タイムラインに配置 (ダブルクリック)" Margin="0,0,8,6"
                                Click="PlacePreset_Click"/>
                        <Button Style="{StaticResource FilledBtn}" Content="クリップボードにセットだけ行う" Margin="0,0,16,6"
                                Click="ApplyPreset_Click"/>
                        <Button Style="{StaticResource FilledBtn}" Content="すべて選択 (Ctrl+A)" Margin="0,0,8,6"
                                Click="PresetSelectAll_Click"/>
                        <Button Style="{StaticResource FilledBtn}" Content="選択解除" Margin="0,0,8,6"
                                Click="PresetClearSelection_Click"/>
                        <Button Style="{StaticResource FilledBtn}" Content="選択をプリセットから削除 (Delete)" Margin="0,0,0,6"
                                Command="{Binding RemovePresetCommand}"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                        <TextBlock Text="並べ替え" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,10,0"
                                   ToolTip="選んだ項目をまとめて移動します"/>
                        <Button Style="{StaticResource FilledBtn}" Content="◀ 前へ" Padding="12,5" Margin="0,0,6,0"
                                ToolTip="1つ前へ (Alt+←)" Command="{Binding MovePresetsCommand}" CommandParameter="up"/>
                        <Button Style="{StaticResource FilledBtn}" Content="後ろへ ▶" Padding="12,5" Margin="0,0,6,0"
                                ToolTip="1つ後ろへ (Alt+→)" Command="{Binding MovePresetsCommand}" CommandParameter="down"/>
                        <Button Style="{StaticResource FilledBtn}" Content="先頭へ" Padding="12,5" Margin="0,0,6,0"
                                Command="{Binding MovePresetsCommand}" CommandParameter="top"/>
                        <Button Style="{StaticResource FilledBtn}" Content="末尾へ" Padding="12,5" Margin="0,0,12,0"
                                Command="{Binding MovePresetsCommand}" CommandParameter="bottom"/>
                        <TextBlock Text="タイルをドラッグして、好きな位置へ移動もできます" Foreground="{StaticResource Sub}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <TextBlock Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,4" LineHeight="20"
                               Text="【作る】YMM4のタイムラインで素材を複数選んで Ctrl+C → 「クリップボードからプリセットを作成」。数値や設定はそのまま保存されます。&#x0A;【サムネイル】画像をコピーして Ctrl+V / 画像ファイルをタイルへドロップ / 右の「プリセットに含まれる素材」から選べます。&#x0A;【使う】プリセットをダブルクリック → YMM4のシークバーの位置に配置(自動で貼り付けられない時は、タイムラインで Ctrl+V)。"/>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding PresetSelectionText}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding PresetMessage}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="6" CornerRadius="10" Background="{StaticResource Panel}">
                    <Grid>
                        <TextBlock Text="プリセットはまだありません&#x0A;タイムラインの素材をコピーして「クリップボードからプリセットを作成」を押してください"
                                   Foreground="{StaticResource Sub}" TextAlignment="Center" LineHeight="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasNoPresets, Converter={StaticResource B2V}}"/>
                        <ListBox x:Name="PresetList" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Text}" SelectionMode="Extended" AllowDrop="True"
                                 DragOver="PresetList_DragOver" DragLeave="PresetList_DragLeave" Drop="PresetList_Drop"
                                 ItemsSource="{Binding Presets}"
                                 ItemContainerStyle="{StaticResource Row}"
                                 ItemTemplate="{StaticResource PresetTileTpl}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewKeyDown="PresetList_PreviewKeyDown"
                                 SelectionChanged="PresetList_SelectionChanged"
                                 MouseDoubleClick="PresetList_MouseDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="PresetRubberRect" Visibility="Collapsed" Fill="#4060CDFF"
                                       Stroke="{StaticResource Accent}" StrokeThickness="1"/>
                            <Rectangle x:Name="PresetInsertMark" Visibility="Collapsed" Fill="{StaticResource Accent}" RadiusX="1.5" RadiusY="1.5"/>
                        </Canvas>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Width="280" Margin="0,6,6,6" Padding="16,14,16,16" CornerRadius="10"
                        Background="{StaticResource Panel}">
                    <ScrollViewer local:WheelFix.Enabled="True" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="プリセットを1つ選ぶと、名前やメモを編集できます"
                                       Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Visibility="{Binding HasNoSelectedPreset, Converter={StaticResource B2V}}"/>
                            <StackPanel Visibility="{Binding HasSelectedPreset, Converter={StaticResource B2V}}">
                                <Border CornerRadius="8" Background="{StaticResource Card}" ClipToBounds="True" Margin="0,0,0,8">
                                    <Grid MinHeight="110">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE91B;" Foreground="{StaticResource Sub}"
                                                   FontSize="38" HorizontalAlignment="Center"
                                                   Visibility="{Binding SelectedPreset.HasNoThumb, Converter={StaticResource B2V}}"/>
                                        <Image Source="{Binding SelectedPreset.Thumb}" MaxHeight="170" Stretch="Uniform" Margin="4"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                                <!-- プレビュー動画: 含まれる素材からエンコードして保存。再生して、好きなコマをサムネイルにできる -->
                                <TextBlock Text="プレビュー動画(エンコードして保存したもの)" Foreground="{StaticResource Sub}"
                                           FontSize="11" Margin="0,2,0,6"/>
                                <StackPanel Visibility="{Binding SelectedPreset.HasPreview, Converter={StaticResource B2V}}" Margin="0,0,0,8">
                                    <Border Background="Black" CornerRadius="8" ClipToBounds="True" Height="160">
                                        <MediaElement x:Name="PresetPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                                      ScrubbingEnabled="True" Stretch="Uniform" Volume="0.8"
                                                      />
                                    </Border>
                                    <Grid Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PresetPlayBtn" Style="{StaticResource IconBtn}" Content="&#xE768;"
                                                ToolTip="再生 / 一時停止"/>
                                        <Slider x:Name="PresetSeek" Grid.Column="1" Style="{StaticResource Seek}" Margin="8,0"
                                                Minimum="0" Maximum="1" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button Style="{StaticResource AccentBtn}" Content="いま表示しているコマをサムネイルにする"
                                            Click="PresetFrameThumb_Click"/>
                                </StackPanel>
                                <TextBlock Text="まだありません。下のボタンで作成・登録できます" Foreground="{StaticResource Sub}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Visibility="{Binding SelectedPreset.HasNoPreview, Converter={StaticResource B2V}}"/>
                                <TextBlock Text="{Binding PresetEncodeText}" Foreground="{StaticResource Accent}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Button Style="{StaticResource FilledBtn}" Content="含まれる素材からプレビューを作成(エンコード)" Margin="0,0,0,6"
                                        Command="{Binding CreatePreviewCommand}"/>
                                <Button Style="{StaticResource FilledBtn}" Content="動画ファイルを登録…" Margin="0,0,0,6"
                                        Click="PresetPreviewFile_Click"/>
                                <Button Style="{StaticResource FilledBtn}" Content="プレビュー動画を削除" Margin="0,0,0,14"
                                        Command="{Binding ClearPreviewCommand}"/>

                                <Button Style="{StaticResource FilledBtn}" Content="クリップボードの画像を貼り付け (Ctrl+V)" Margin="0,0,0,6"
                                        Command="{Binding PasteThumbnailCommand}"/>
                                <Button Style="{StaticResource FilledBtn}" Content="YMM4のプレビュー画面を取り込む" Margin="0,0,0,6"
                                        ToolTip="いまYMM4のプレビューに映っている画像を、サムネイルにします" Command="{Binding PresetPreviewThumbnailCommand}"/>
                                <TextBlock Text="ショートカットキー" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,8,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <local:KeyRecorder Style="{StaticResource Field}" Keys="{Binding SelectedPreset.ShortcutKeys, Mode=TwoWay}" ToolTip="クリックして、割り当てたいキーを実際に押すと記録されます(Delete: 解除 / Esc: 取りやめ)"/>
                                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="32" Height="32" Margin="6,0,0,0"
                                            ToolTip="このショートカットを削除" Click="ClearKeyRecorder_Click"/>
                                </Grid>
                                <Button Style="{StaticResource FilledBtn}" Content="画像ファイルを選ぶ…" Margin="0,0,0,6"
                                        Click="PresetThumbFile_Click"/>
                                <Button Style="{StaticResource FilledBtn}" Content="サムネイルを削除" Margin="0,0,0,12"
                                        Command="{Binding ClearThumbnailCommand}"/>

                                <TextBlock Text="プリセットに含まれる素材からサムネイルを選ぶ" Foreground="{StaticResource Sub}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="画像・動画のファイルは見つかりませんでした" Foreground="{StaticResource Sub}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Visibility="{Binding HasNoPresetMedia, Converter={StaticResource B2V}}"/>
                                <ItemsControl ItemsSource="{Binding PresetMedia}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5" ToolTip="{Binding Path}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Grid.Column="1" Style="{StaticResource FilledBtn}" Content="使う" Padding="12,4"
                                                        CommandParameter="{Binding Path}"
                                                        Command="{Binding DataContext.UseMediaThumbnailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="名前" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding SelectedPreset.Name, UpdateSourceTrigger=LostFocus}"
                                         Margin="0,0,0,10"/>
                                <TextBlock Text="メモ" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding SelectedPreset.Memo, UpdateSourceTrigger=LostFocus}"
                                         Height="90" Padding="10,6" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding SelectedPreset.Summary}" Foreground="{StaticResource Sub}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedPreset.DataId, StringFormat='データID: {0}'}" Foreground="{StaticResource Sub}"
                                           FontSize="11" Margin="0,0,0,2" ToolTip="保存してあるデータの指紋です。別々に登録したのに同じなら、同じ内容を保存しています"/>
                                <TextBlock Text="{Binding SelectedPreset.CreatedText}" Foreground="{StaticResource Sub}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedPreset.FormatNames}" Foreground="{StaticResource Sub}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,14"/>
                            </StackPanel>
                            <Button Style="{StaticResource AccentBtn}" Content="タイムラインに配置" Margin="0,0,0,6"
                                    Click="PlacePreset_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="クリップボードにセットだけ行う" Margin="0,0,0,6"
                                    Click="ApplyPreset_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="プリセットから削除"
                                    Command="{Binding RemovePresetCommand}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 図形タブ ===== -->
        <Grid Grid.Row="1" Visibility="{Binding ShowShapeView, Converter={StaticResource B2V}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="12,10,12,4">
                <StackPanel>
                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                            Visibility="{Binding IsShapeCapturing, Converter={StaticResource B2V}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ShapeCaptureText}" Foreground="{StaticResource Accent}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="20"/>
                            <Button Grid.Column="1" Style="{StaticResource FilledBtn}" Content="中止" Margin="12,0,0,0"
                                    VerticalAlignment="Center" Command="{Binding CancelShapeCaptureCommand}"/>
                        </Grid>
                    </Border>
                    <WrapPanel VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentBtn}" Content="クリップボードから図形を追加" Margin="0,0,8,6"
                                ToolTip="YMM4で図形のアイテムを選んで Ctrl+C してから押します" Click="CaptureShape_Click"/>
                        <Button Style="{StaticResource AccentBtn}" Content="選択中のアイテムから図形を追加(確実な方式)" Margin="0,0,8,6"
                                ToolTip="YMM4のタイムラインで選択中のアイテムを、図形として追加します(アイテムテンプレート方式。ダブルクリックで確実に配置できます)"
                                Command="{Binding AddShapeFromSelectionCommand}"/>
                        <Button Style="{StaticResource FilledBtn}" Content="選択中のアイテムを配置データにする(確実な方式)" Margin="0,0,8,6"
                                ToolTip="選んでいる図形に、YMM4で選択中のアイテムを配置データとして登録します"
                                Command="{Binding AttachShapeTemplateCommand}"/>
                        <Button Style="{StaticResource FilledBtn}" Content="標準・プラグインの図形をすべて自動収録" Margin="0,0,8,6"
                                ToolTip="YMM4に入っている標準の図形と、プラグインで追加された図形を、このタブにすべて収録します。収録後は、削除・並べ替えができます(タブごとに独立)"
                                Command="{Binding AutoRegisterShapesCommand}"/>
                        <Button Style="{StaticResource FilledBtn}" Content="クリップボードの内容を配置データにする" Margin="0,0,8,6"
                                ToolTip="選んでいる図形に、コピーしたアイテムを登録します(ダブルクリックで配置できるようになります)"
                                Click="AttachShapeData_Click"/>
                        <Button Style="{StaticResource FilledBtn}" Content="初期値の配置データを順番に登録" Margin="0,0,8,6"
                                ToolTip="選んだ図形(配置データが無いもの)を、YMM4で1つずつ追加してコピーするだけで自動登録します。初期値のまま配置できるようになります"
                                Command="{Binding StartShapeCaptureCommand}"/>
                        <Button Style="{StaticResource FilledBtn}" Content="タイムラインに配置 (ダブルクリック)" Margin="0,0,16,6"
                                Click="PlaceShape_Click"/>
                        <Button Style="{StaticResource FilledBtn}" Content="すべて選択 (Ctrl+A)" Margin="0,0,8,6"
                                Click="ShapeSelectAll_Click"/>
                        <Button Style="{StaticResource FilledBtn}" Content="選択解除" Margin="0,0,0,6"
                                Click="ShapeClearSelection_Click"/>
                    </WrapPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <Button Style="{StaticResource FilledBtn}" Content="選択を非表示" Margin="0,0,8,6"
                                Command="{Binding HideShapesCommand}" CommandParameter="hide"/>
                        <Button Style="{StaticResource FilledBtn}" Content="選択を表示に戻す" Margin="0,0,8,6"
                                Command="{Binding HideShapesCommand}" CommandParameter="show"/>
                        <ToggleButton Style="{StaticResource PillToggle}" Content="非表示の図形も表示" Margin="0,0,16,6"
                                      IsChecked="{Binding ShapeShowHidden}"/>
                        <Button Style="{StaticResource FilledBtn}" Content="選択を削除 (Delete)" Margin="0,0,8,6"
                                ToolTip="選んだ図形を、このタブから削除します(自動収録した標準・プラグインの図形も消せます。Ctrl+クリック・Shift+クリック・ドラッグ・Ctrl+A で、まとめて選べます)"
                                Command="{Binding RemoveShapesCommand}"/>
                        <Button Style="{StaticResource FilledBtn}" Content="削除した自動収録の図形を戻す" Margin="0,0,8,6"
                                ToolTip="このタブで削除した自動収録の図形を、もう一度収録します"
                                Command="{Binding RestoreRemovedShapesCommand}"/>
                        <Button Style="{StaticResource FilledBtn}" Content="YMM4の図形をもう一度探す" Margin="0,0,0,6"
                                Command="{Binding ScanShapesCommand}"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                        <TextBlock Text="並べ替え" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,10,0"
                                   ToolTip="選んだ項目をまとめて移動します"/>
                        <Button Style="{StaticResource FilledBtn}" Content="◀ 前へ" Padding="12,5" Margin="0,0,6,0"
                                ToolTip="1つ前へ (Alt+←)" Command="{Binding MoveShapesCommand}" CommandParameter="up"/>
                        <Button Style="{StaticResource FilledBtn}" Content="後ろへ ▶" Padding="12,5" Margin="0,0,6,0"
                                ToolTip="1つ後ろへ (Alt+→)" Command="{Binding MoveShapesCommand}" CommandParameter="down"/>
                        <Button Style="{StaticResource FilledBtn}" Content="先頭へ" Padding="12,5" Margin="0,0,6,0"
                                Command="{Binding MoveShapesCommand}" CommandParameter="top"/>
                        <Button Style="{StaticResource FilledBtn}" Content="末尾へ" Padding="12,5" Margin="0,0,12,0"
                                Command="{Binding MoveShapesCommand}" CommandParameter="bottom"/>
                        <TextBlock Text="タイルをドラッグして、好きな位置へ移動もできます" Foreground="{StaticResource Sub}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ShapeScanText}" Foreground="{StaticResource Sub}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding ShapeSelectionText}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding ShapeMessage}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="6" CornerRadius="10" Background="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBox Style="{StaticResource Field}" Margin="8,8,8,2" Tag="図形を検索(名前・メモ・読み・英語 例: あめ / rain)" Text="{Binding ShapeSearch, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Text="図形がありません&#x0A;「クリップボードから図形を追加」で追加できます"
                                   Foreground="{StaticResource Sub}" TextAlignment="Center" LineHeight="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasNoShapes, Converter={StaticResource B2V}}"/>
                        <ListBox Grid.Row="1" x:Name="ShapeList" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Text}" SelectionMode="Extended" AllowDrop="True"
                                 ItemsSource="{Binding Shapes}"
                                 ItemContainerStyle="{StaticResource Row}"
                                 ItemTemplate="{StaticResource ShapeTileTpl}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewKeyDown="ShapeList_PreviewKeyDown"
                                 SelectionChanged="ShapeList_SelectionChanged"
                                 MouseDoubleClick="ShapeList_MouseDoubleClick"
                                 DragOver="ShapeList_DragOver" DragLeave="ShapeList_DragLeave" Drop="ShapeList_Drop">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="タイムラインに配置" Click="PlaceShape_Click"/>
                                    <Separator/>
                                    <MenuItem Header="選択を非表示" Command="{Binding HideShapesCommand}" CommandParameter="hide"/>
                                    <MenuItem Header="選択を表示に戻す" Command="{Binding HideShapesCommand}" CommandParameter="show"/>
                                    <Separator/>
                                    <MenuItem Header="選択を削除" InputGestureText="Delete" Command="{Binding RemoveShapesCommand}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <Canvas Grid.Row="1" IsHitTestVisible="False">
                            <Rectangle x:Name="ShapeRubberRect" Visibility="Collapsed" Fill="#4060CDFF"
                                       Stroke="{StaticResource Accent}" StrokeThickness="1"/>
                            <Rectangle x:Name="ShapeInsertMark" Visibility="Collapsed" Fill="{StaticResource Accent}" RadiusX="1.5" RadiusY="1.5"/>
                        </Canvas>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Width="280" Margin="0,6,6,6" Padding="16,14,16,16" CornerRadius="10"
                        Background="{StaticResource Panel}">
                    <ScrollViewer local:WheelFix.Enabled="True" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="図形を1つ選ぶと、名前やメモ・サムネイルを編集できます"
                                       Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Visibility="{Binding HasNoSelectedShape, Converter={StaticResource B2V}}"/>
                            <StackPanel Visibility="{Binding HasSelectedShape, Converter={StaticResource B2V}}">
                                <Border CornerRadius="8" Background="{StaticResource Card}" ClipToBounds="True" Margin="0,0,0,8">
                                    <Grid MinHeight="110">
                                        <TextBlock Text="◆" FontSize="42" Foreground="{StaticResource Sub}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding SelectedShape.HasNoThumb, Converter={StaticResource B2V}}"/>
                                        <Image Source="{Binding SelectedShape.Thumb}" MaxHeight="170" Stretch="Uniform" Margin="4"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                                <Button Style="{StaticResource FilledBtn}" Content="クリップボードの画像を貼り付け (Ctrl+V)" Margin="0,0,0,6"
                                        Command="{Binding PasteShapeThumbnailCommand}"/>
                                <Button Style="{StaticResource FilledBtn}" Content="YMM4のプレビュー画面を取り込む" Margin="0,0,0,6"
                                        ToolTip="いまYMM4のプレビューに映っている画像を、サムネイルにします" Command="{Binding ShapePreviewThumbnailCommand}"/>
                                <TextBlock Text="ショートカットキー" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,8,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <local:KeyRecorder Style="{StaticResource Field}" Keys="{Binding SelectedShape.ShortcutKeys, Mode=TwoWay}" ToolTip="クリックして、割り当てたいキーを実際に押すと記録されます(Delete: 解除 / Esc: 取りやめ)"/>
                                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="32" Height="32" Margin="6,0,0,0"
                                            ToolTip="このショートカットを削除" Click="ClearKeyRecorder_Click"/>
                                </Grid>
                                <Button Style="{StaticResource FilledBtn}" Content="画像ファイルを選ぶ…" Margin="0,0,0,6"
                                        Click="ShapeThumbFile_Click"/>
                                <Button Style="{StaticResource FilledBtn}" Content="サムネイルを削除" Margin="0,0,0,12"
                                        Command="{Binding ClearShapeThumbnailCommand}"/>

                                <TextBlock Text="名前" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding SelectedShape.Name, UpdateSourceTrigger=LostFocus}"
                                         Margin="0,0,0,10"/>
                                <TextBlock Text="メモ" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Style="{StaticResource Field}" Text="{Binding SelectedShape.Memo, UpdateSourceTrigger=LostFocus}"
                                         Height="90" Padding="10,6" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding SelectedShape.SourceText}" Foreground="{StaticResource Sub}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedShape.DataId, StringFormat='データID: {0}'}" Foreground="{StaticResource Sub}"
                                           FontSize="11" Margin="0,0,0,2" ToolTip="保存してあるデータの指紋です。別々の図形なのに同じなら、同じ内容を保存しています"/>
                                <TextBlock Text="{Binding SelectedShape.PlaceText}" Foreground="{StaticResource Sub}" Margin="0,0,0,14"/>
                            </StackPanel>
                            <Button Style="{StaticResource AccentBtn}" Content="タイムラインに配置" Margin="0,0,0,6"
                                    Click="PlaceShape_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="初期値の配置データを自動登録" Margin="0,0,0,6"
                                    ToolTip="YMM4で図形を追加(初期値のまま)して Ctrl+C するだけで登録されます"
                                    Command="{Binding StartShapeCaptureCommand}"/>
                            <Button Style="{StaticResource FilledBtn}" Content="クリップボードの内容を配置データにする" Margin="0,0,0,6"
                                    Click="AttachShapeData_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="選択を非表示" Margin="0,0,0,6"
                                    Command="{Binding HideShapesCommand}" CommandParameter="hide"/>
                            <Button Style="{StaticResource FilledBtn}" Content="選択を表示に戻す" Margin="0,0,0,6"
                                    Command="{Binding HideShapesCommand}" CommandParameter="show"/>
                            <Button Style="{StaticResource FilledBtn}" Content="選択を削除 (Delete)" Foreground="#FF8A80"
                                    ToolTip="選んだ図形を、このタブから削除します(自動収録した図形も消せます)"
                                    Command="{Binding RemoveShapesCommand}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 演出図形タブ(分類で絞って配置するだけ。追加・削除はできない) ===== -->
        <local:EffectShapeBrowserView Grid.Row="1" DataContext="{Binding EffectShapes}"
                                      Visibility="{Binding DataContext.ShowEffectShapeView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>

        <!-- ===== エフェクトタブ(同梱の演出エフェクト。映像はサンプル画像のサムネイル、音声は一覧) ===== -->
        <local:FxBrowserView Grid.Row="1" DataContext="{Binding FxBrowser}"
                             Visibility="{Binding DataContext.ShowVideoEffectView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}"/>

        <!-- 前の「映像エフェクト」タブ(自分で追加する方式)。v131 から使わない -->
        <Grid Grid.Row="1" Visibility="Collapsed">
            <Grid DataContext="{Binding VideoFx}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="12,10,12,4">
                    <StackPanel>
                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                                Visibility="{Binding IsWatching, Converter={StaticResource B2V}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding WatchText}" Foreground="{StaticResource Accent}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="20"/>
                                <Button Grid.Column="1" Style="{StaticResource FilledBtn}" Content="中止" Margin="12,0,0,0"
                                        VerticalAlignment="Center" Command="{Binding CancelWatchCommand}"/>
                            </Grid>
                        </Border>
                        <WrapPanel VerticalAlignment="Center">
                            <Button Style="{StaticResource AccentBtn}" Content="選択中のアイテムから読み取る" Margin="0,0,8,6"
                                    ToolTip="YMM4で、エフェクトを読み取りたいアイテムを選んでから押します。コピーのキー操作を自動で送り、そのアイテムのエフェクトを1つのまとまりとして保存します"
                                    Click="FxReadSelected_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="コピー済みのアイテムから読み取る" Margin="0,0,8,6"
                                    ToolTip="すでにYMM4でアイテムをコピーしてある時に押します" Click="FxReadClipboard_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="コピーを待って追加(そのまま保存)" Margin="0,0,8,6"
                                    ToolTip="押したあとYMM4でエフェクトをコピー(Ctrl+C)すると、コピーした内容をそのまま保存します"
                                    Command="{Binding WatchCommand}"/>
                            <Button Style="{StaticResource FilledBtn}" Content="クリップボードから追加(そのまま保存)" Margin="0,0,8,6"
                                    ToolTip="すでにコピーしてある内容を、そのまま保存します" Click="FxCapture_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="選択中のアイテムに適用 (ダブルクリック)" Margin="0,0,16,6"
                                    Click="FxApply_Click"/>
                            <CheckBox Style="{StaticResource Check}" VerticalAlignment="Center" Margin="0,0,16,6"
                                      IsChecked="{Binding RemoveBeforeApply}"
                                      ToolTip="オンにすると、適用の前に、選択中のアイテムのエフェクトをすべて削除してから、このまとまりを追加します。オフなら、いまのエフェクトを残したまま、後ろに追加します"
                                      Content="適用前に、選択中のアイテムのエフェクトをすべて削除する"/>
                            <Button Style="{StaticResource FilledBtn}" Content="標準・プラグインのエフェクトをすべて自動収録" Margin="0,0,8,6"
                                    ToolTip="YMM4に入っている標準のエフェクトと、プラグインで追加されたエフェクトを、このタブにすべて収録します。収録後は、削除・並べ替えができます(タブごとに独立)"
                                    Command="{Binding AutoRegisterCommand}"/>
                            <Button Style="{StaticResource FilledBtn}" Content="すべて選択 (Ctrl+A)" Margin="0,0,8,6"
                                    Click="FxSelectAll_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="選択解除" Margin="0,0,8,6"
                                    Click="FxClearSelection_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="選択を削除 (Delete)" Margin="0,0,0,6"
                                    Command="{Binding RemoveCommand}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                            <TextBlock Text="並べ替え" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,10,0"
                                       ToolTip="選んだ項目をまとめて移動します"/>
                            <Button Style="{StaticResource FilledBtn}" Content="◀ 前へ" Padding="12,5" Margin="0,0,6,0"
                                    ToolTip="1つ前へ (Alt+←)" Command="{Binding MoveCommand}" CommandParameter="up"/>
                            <Button Style="{StaticResource FilledBtn}" Content="後ろへ ▶" Padding="12,5" Margin="0,0,6,0"
                                    ToolTip="1つ後ろへ (Alt+→)" Command="{Binding MoveCommand}" CommandParameter="down"/>
                            <Button Style="{StaticResource FilledBtn}" Content="先頭へ" Padding="12,5" Margin="0,0,6,0"
                                    Command="{Binding MoveCommand}" CommandParameter="top"/>
                            <Button Style="{StaticResource FilledBtn}" Content="末尾へ" Padding="12,5" Margin="0,0,12,0"
                                    Command="{Binding MoveCommand}" CommandParameter="bottom"/>
                            <TextBlock Text="タイルをドラッグして、好きな位置へ移動もできます" Foreground="{StaticResource Sub}"
                                       FontSize="11" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <TextBlock Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,4" LineHeight="20"
                                   Text="【読み取り】YMM4で、エフェクトを読み取りたいアイテムを選び、「選択中のアイテムから読み取る」を押すと、そのアイテムのエフェクトが1つのまとまりとして保存されます。&#x0A;【適用】YMM4で適用したいアイテムを選んでおき、ここでまとまりをダブルクリックします。選択中のアイテムを自動でコピーして、エフェクトを足したものに置き換えます(追加・置き換えや、元のアイテムを残すかどうかは、設定で変えられます)。"/>
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="6" CornerRadius="10" Background="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBox Style="{StaticResource Field}" Margin="8,8,8,2" Tag="エフェクトを検索(名前・メモ・読み・英語)" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Text="エフェクトがありません&#x0A;YMM4でエフェクトをコピーして、「コピーを待って追加」から追加できます"
                                       Foreground="{StaticResource Sub}" TextAlignment="Center" LineHeight="22"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoItems, Converter={StaticResource B2V}}"/>
                            <ListBox Grid.Row="1" x:Name="VideoFxList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Text}" SelectionMode="Extended" AllowDrop="True"
                                     ItemsSource="{Binding Items}"
                                     ItemContainerStyle="{StaticResource Row}"
                                     ItemTemplate="{StaticResource EffectTileTpl}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewKeyDown="FxList_PreviewKeyDown"
                                     SelectionChanged="FxList_SelectionChanged"
                                     MouseDoubleClick="FxList_MouseDoubleClick"
                                     DragOver="FxList_DragOver" DragLeave="FxList_DragLeave" Drop="FxList_Drop">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                            <Canvas Grid.Row="1" IsHitTestVisible="False">
                                <Rectangle x:Name="VideoFxRubberRect" Visibility="Collapsed" Fill="#4060CDFF"
                                           Stroke="{StaticResource Accent}" StrokeThickness="1"/>
                                <Rectangle x:Name="VideoFxInsertMark" Visibility="Collapsed" Fill="{StaticResource Accent}" RadiusX="1.5" RadiusY="1.5"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Width="280" Margin="0,6,6,6" Padding="16,14,16,16" CornerRadius="10"
                            Background="{StaticResource Panel}">
                        <ScrollViewer local:WheelFix.Enabled="True" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="エフェクトを1つ選ぶと、名前やメモ・サムネイルを編集できます"
                                           Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Visibility="{Binding HasNoSelected, Converter={StaticResource B2V}}"/>
                                <StackPanel Visibility="{Binding HasSelected, Converter={StaticResource B2V}}">
                                    <Border CornerRadius="8" Background="{StaticResource Card}" ClipToBounds="True" Margin="0,0,0,8">
                                        <Grid MinHeight="110">
                                            <TextBlock Text="{Binding SelectedItem.Placeholder}" FontSize="42" Foreground="{StaticResource Sub}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding SelectedItem.HasNoThumb, Converter={StaticResource B2V}}"/>
                                            <Image Source="{Binding SelectedItem.Thumb}" MaxHeight="170" Stretch="Uniform" Margin="4"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                    <Button Style="{StaticResource FilledBtn}" Content="クリップボードの画像を貼り付け (Ctrl+V)" Margin="0,0,0,6"
                                            Command="{Binding PasteThumbnailCommand}"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="YMM4のプレビュー画面を取り込む" Margin="0,0,0,6"
                                            ToolTip="いまYMM4のプレビューに映っている画像を、サムネイルにします" Command="{Binding PreviewThumbnailCommand}"/>
                                    <TextBlock Text="ショートカットキー" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,8,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <local:KeyRecorder Style="{StaticResource Field}" Keys="{Binding SelectedItem.ShortcutKeys, Mode=TwoWay}" ToolTip="クリックして、割り当てたいキーを実際に押すと記録されます(Delete: 解除 / Esc: 取りやめ)"/>
                                        <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="32" Height="32" Margin="6,0,0,0"
                                                ToolTip="このショートカットを削除" Click="ClearKeyRecorder_Click"/>
                                    </Grid>
                                    <Button Style="{StaticResource FilledBtn}" Content="画像ファイルを選ぶ…" Margin="0,0,0,6"
                                            Click="FxThumbFile_Click"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="サムネイルを削除" Margin="0,0,0,12"
                                            Command="{Binding ClearThumbnailCommand}"/>

                                    <TextBlock Text="名前" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding SelectedItem.Name, UpdateSourceTrigger=LostFocus}"
                                             Margin="0,0,0,10"/>
                                    <TextBlock Text="メモ" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding SelectedItem.Memo, UpdateSourceTrigger=LostFocus}"
                                             Height="90" Padding="10,6" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding SelectedItem.Summary}" Foreground="{StaticResource Sub}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SelectedItem.DataId, StringFormat='データID: {0}'}" Foreground="{StaticResource Sub}"
                                               FontSize="11" Margin="0,0,0,2" ToolTip="保存してあるデータの指紋です。別々のエフェクトなのに同じなら、同じ内容を保存しています"/>
                                    <TextBlock Text="{Binding SelectedItem.BundleText}" Foreground="{StaticResource Sub}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,4,0,6"
                                               Visibility="{Binding SelectedItem.IsBundle, Converter={StaticResource B2V}}"/>
                                    <TextBlock Text="{Binding SelectedItem.CreatedText}" Foreground="{StaticResource Sub}" Margin="0,0,0,14"/>
                                </StackPanel>
                                <Button Style="{StaticResource AccentBtn}" Content="選択中のアイテムに適用" Margin="0,0,0,6"
                                        Click="FxApply_Click"/>
                                <Button Style="{StaticResource FilledBtn}" Content="エフェクトを削除"
                                        Command="{Binding RemoveCommand}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== テキストタブ ===== -->
        <Grid Grid.Row="1" Visibility="{Binding ShowTextView, Converter={StaticResource B2V}}">
            <Grid DataContext="{Binding TextLib}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="12,10,12,4">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Style="{StaticResource AccentBtn}" Content="✂ 選択中のテキストを分割" Padding="12,5"
                                    ToolTip="YMM4のタイムラインで選択中のテキストを、好きな位置で複数のアイテムに分けます"
                                    Command="{Binding DataContext.TextSplit.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <TextBlock Text="時間で切り替える字幕や、1文字ずつ動かせるレイアウトに分けられます" Foreground="{StaticResource Sub}" FontSize="11"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,10" MaxWidth="460" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="分割画面へ送るショートカット" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <local:KeyRecorder Grid.Column="1" Style="{StaticResource Field}" Keys="{Binding DataContext.TextSplitShortcutKeys, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               ToolTip="押すと、YMM4で選んでいるテキストを分割画面に読み込みます(どのタブを開いていても動きます)"/>
                            <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="32" Height="32" Margin="6,0,0,0"
                                    ToolTip="このショートカットを削除" Click="ClearKeyRecorder_Click"/>
                        </Grid>
                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                                Visibility="{Binding IsWatching, Converter={StaticResource B2V}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding WatchText}" Foreground="{StaticResource Accent}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="20"/>
                                <Button Grid.Column="1" Style="{StaticResource FilledBtn}" Content="中止" Margin="12,0,0,0"
                                        VerticalAlignment="Center" Command="{Binding CancelWatchCommand}"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                                Visibility="{Binding HasPending, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <TextBlock Text="保存する書式の項目を選んでください" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="名前" Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource Field}" MaxLength="40"
                                             Text="{Binding PendingName, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Style="{StaticResource AccentBtn}" Content="この内容で保存" Margin="0,0,8,0"
                                            Command="{Binding SavePendingCommand}"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="すべて選ぶ" Margin="0,0,8,0"
                                            Command="{Binding CheckAllPendingCommand}"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="すべて外す" Margin="0,0,8,0"
                                            Command="{Binding UncheckAllPendingCommand}"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="取りやめ"
                                            Command="{Binding CancelPendingCommand}"/>
                                </WrapPanel>
                                <!-- サムネイル: 背景色と見本の文字を決めると、書式から自動で作る -->
                                <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="192" Height="108" CornerRadius="6" ClipToBounds="True" Background="{Binding ThumbBgBrush}" VerticalAlignment="Top">
                                            <Image Source="{Binding PendingThumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <CheckBox Style="{StaticResource Check}" Content="保存する時に、このサムネイルを付ける" IsChecked="{Binding ThumbAuto}" Margin="0,0,0,8"/>
                                            <TextBlock Text="見本の文字" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                            <TextBox Style="{StaticResource Field}" Text="{Binding ThumbSample, UpdateSourceTrigger=PropertyChanged, Delay=250}" Margin="0,0,0,8"
                                                     ToolTip="サムネイルに描く文字(\n で改行)"/>
                                            <TextBlock Text="背景色" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                            <ItemsControl ItemsSource="{x:Static local:EffectLibraryVm.ThumbBgChoices}" Margin="0,0,0,6">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="22" Height="22" Margin="0,0,4,4" Cursor="Hand" ToolTip="{Binding}"
                                                                Command="{Binding DataContext.SetThumbBgCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border CornerRadius="4" Background="{Binding}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"/>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBox Style="{StaticResource Field}" Width="110" HorizontalAlignment="Left" Text="{Binding ThumbBg, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="#RRGGBB か #AARRGGBB で入力して Enter"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="対象パラメータ" Foreground="{StaticResource Sub}" FontSize="12" Margin="0,0,0,8"
                                           Visibility="{Binding PendingIsDirect, Converter={StaticResource B2V}}"/>
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding PendingIsDirect, Converter={StaticResource B2V}}">
                                    <ItemsControl ItemsSource="{Binding PendingGroups}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource SwitchCheck}" Width="196" Margin="0,0,14,10"
                                                          Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                                          IsEnabled="{Binding IsAvailable}" ToolTip="{Binding Tooltip}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding PendingIsList, Converter={StaticResource B2V}}">
                                    <ItemsControl ItemsSource="{Binding PendingKeys}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="230"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource Check}" Margin="0,0,0,4"
                                                              Content="{Binding Display}" IsChecked="{Binding IsChecked}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Preview}" Foreground="{StaticResource Sub}"
                                                               FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"
                                                               Margin="0,1,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <WrapPanel VerticalAlignment="Center">
                            <Button Style="{StaticResource AccentBtn}" Content="選択中のテキストから書式を読み取る" Margin="0,0,8,6"
                                    ToolTip="YMM4で、書式を読み取りたいテキストのアイテムを選んでから押します。フォント・色・縁取りなどの書式とエフェクトだけを保存します(文字の内容・時間・位置は保存しません)。テキストではないアイテムを選んでいる時は警告します"
                                    Click="FxReadSelected_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="コピー済みのアイテムから読み取る" Margin="0,0,8,6"
                                    ToolTip="すでにYMM4でテキストのアイテムをコピーしてある時に押します。書式とエフェクトだけを取り出して保存します"
                                    Click="FxReadClipboard_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="コピーを待って読み取る" Margin="0,0,8,6"
                                    ToolTip="押したあとYMM4でテキストのアイテムをコピー(Ctrl+C)すると、書式とエフェクトだけを自動で保存します"
                                    Command="{Binding WatchCommand}"/>
                            <Button Style="{StaticResource FilledBtn}" Content="選択中のアイテムに適用 (ダブルクリック)" Margin="0,0,16,6"
                                    Click="FxApply_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="新しいテキストとして配置" Margin="0,0,16,6"
                                    ToolTip="選んだ書式の、新しいテキストアイテムを、シークバーの位置に配置します(YMM4から直接読み取った書式で使えます)"
                                    Click="FxPlaceNewText_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="すべて選択 (Ctrl+A)" Margin="0,0,8,6"
                                    Click="FxSelectAll_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="選択解除" Margin="0,0,8,6"
                                    Click="FxClearSelection_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="選択を削除 (Delete)" Margin="0,0,0,6"
                                    Command="{Binding RemoveCommand}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                            <TextBlock Text="並べ替え" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,10,0"
                                       ToolTip="選んだ項目をまとめて移動します"/>
                            <Button Style="{StaticResource FilledBtn}" Content="◀ 前へ" Padding="12,5" Margin="0,0,6,0"
                                    ToolTip="1つ前へ (Alt+←)" Command="{Binding MoveCommand}" CommandParameter="up"/>
                            <Button Style="{StaticResource FilledBtn}" Content="後ろへ ▶" Padding="12,5" Margin="0,0,6,0"
                                    ToolTip="1つ後ろへ (Alt+→)" Command="{Binding MoveCommand}" CommandParameter="down"/>
                            <Button Style="{StaticResource FilledBtn}" Content="先頭へ" Padding="12,5" Margin="0,0,6,0"
                                    Command="{Binding MoveCommand}" CommandParameter="top"/>
                            <Button Style="{StaticResource FilledBtn}" Content="末尾へ" Padding="12,5" Margin="0,0,12,0"
                                    Command="{Binding MoveCommand}" CommandParameter="bottom"/>
                            <TextBlock Text="タイルをドラッグして、好きな位置へ移動もできます" Foreground="{StaticResource Sub}"
                                       FontSize="11" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <TextBlock Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,4" LineHeight="20"
                                   Text="【読み取り】YMM4で、書式を読み取りたいテキストのアイテムを選び、「選択中のテキストから書式を読み取る」を押すと、フォント・色・縁取りなどの書式とエフェクトが保存されます(文字の内容・時間・位置は保存しません)。テキストではないアイテムを選んでいる時は警告します。&#x0A;【適用】YMM4で、適用したいテキストのアイテムを選んでおき、ここで書式をダブルクリックします。選んでいるアイテムがテキストではない時は、警告して何もしません。選択中のアイテムは、書式を反映したものに置き換わります(YMM4で Ctrl+Z で戻せます)。"/>
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="6" CornerRadius="10" Background="{StaticResource Panel}">
                        <Grid>
                            <TextBlock Text="書式がありません&#x0A;YMM4でテキストのアイテムを選んで、「選択中のテキストから書式を読み取る」から追加できます"
                                       Foreground="{StaticResource Sub}" TextAlignment="Center" LineHeight="22"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoItems, Converter={StaticResource B2V}}"/>
                            <ListBox x:Name="TextLibList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Text}" SelectionMode="Extended" AllowDrop="True"
                                     ItemsSource="{Binding Items}"
                                     ItemContainerStyle="{StaticResource Row}"
                                     ItemTemplate="{StaticResource EffectTileTpl}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewKeyDown="FxList_PreviewKeyDown"
                                     SelectionChanged="FxList_SelectionChanged"
                                     MouseDoubleClick="FxList_MouseDoubleClick"
                                     DragOver="FxList_DragOver" DragLeave="FxList_DragLeave" Drop="FxList_Drop">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                            <Canvas IsHitTestVisible="False">
                                <Rectangle x:Name="TextLibRubberRect" Visibility="Collapsed" Fill="#4060CDFF"
                                           Stroke="{StaticResource Accent}" StrokeThickness="1"/>
                                <Rectangle x:Name="TextLibInsertMark" Visibility="Collapsed" Fill="{StaticResource Accent}" RadiusX="1.5" RadiusY="1.5"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Width="280" Margin="0,6,6,6" Padding="16,14,16,16" CornerRadius="10"
                            Background="{StaticResource Panel}">
                        <ScrollViewer local:WheelFix.Enabled="True" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="書式を1つ選ぶと、名前やメモ・サムネイルを編集できます"
                                           Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Visibility="{Binding HasNoSelected, Converter={StaticResource B2V}}"/>
                                <StackPanel Visibility="{Binding HasSelected, Converter={StaticResource B2V}}">
                                    <Border CornerRadius="8" Background="{StaticResource Card}" ClipToBounds="True" Margin="0,0,0,8">
                                        <Grid MinHeight="110">
                                            <TextBlock Text="{Binding SelectedItem.Placeholder}" FontSize="42" Foreground="{StaticResource Sub}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding SelectedItem.HasNoThumb, Converter={StaticResource B2V}}"/>
                                            <Image Source="{Binding SelectedItem.Thumb}" MaxHeight="170" Stretch="Uniform" Margin="4"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                    <Button Style="{StaticResource FilledBtn}" Content="クリップボードの画像を貼り付け (Ctrl+V)" Margin="0,0,0,6"
                                            Command="{Binding PasteThumbnailCommand}"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="YMM4のプレビュー画面を取り込む" Margin="0,0,0,6"
                                            ToolTip="いまYMM4のプレビューに映っている画像を、サムネイルにします" Command="{Binding PreviewThumbnailCommand}"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="書式からサムネイルを作る" Margin="0,0,0,6"
                                            ToolTip="この書式のフォント・文字色・装飾で、見本の文字を描いたサムネイルを作ります(背景色と見本の文字は、書式を読み取った時の設定を使います)"
                                            Command="{Binding MakeThumbFromStyleCommand}"/>
                                    <TextBlock Text="ショートカットキー" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,8,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <local:KeyRecorder Style="{StaticResource Field}" Keys="{Binding SelectedItem.ShortcutKeys, Mode=TwoWay}" ToolTip="クリックして、割り当てたいキーを実際に押すと記録されます(Delete: 解除 / Esc: 取りやめ)"/>
                                        <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="32" Height="32" Margin="6,0,0,0"
                                                ToolTip="このショートカットを削除" Click="ClearKeyRecorder_Click"/>
                                    </Grid>
                                    <Button Style="{StaticResource FilledBtn}" Content="画像ファイルを選ぶ…" Margin="0,0,0,6"
                                            Click="FxThumbFile_Click"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="サムネイルを削除" Margin="0,0,0,12"
                                            Command="{Binding ClearThumbnailCommand}"/>

                                    <TextBlock Text="名前" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding SelectedItem.Name, UpdateSourceTrigger=LostFocus}"
                                             Margin="0,0,0,10"/>
                                    <TextBlock Text="メモ" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding SelectedItem.Memo, UpdateSourceTrigger=LostFocus}"
                                             Height="90" Padding="10,6" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding SelectedItem.Summary}" Foreground="{StaticResource Sub}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SelectedItem.DataId, StringFormat='データID: {0}'}" Foreground="{StaticResource Sub}"
                                               FontSize="11" Margin="0,0,0,2" ToolTip="保存してあるデータの指紋です。別々の書式なのに同じなら、同じ内容を保存しています"/>
                                    <TextBlock Text="{Binding SelectedItem.BundleText}" Foreground="{StaticResource Sub}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,4,0,6"
                                               Visibility="{Binding SelectedItem.IsBundle, Converter={StaticResource B2V}}"/>
                                    <TextBlock Text="{Binding SelectedItem.StyleText}" Foreground="{StaticResource Sub}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SelectedItem.CreatedText}" Foreground="{StaticResource Sub}" Margin="0,0,0,14"/>
                                </StackPanel>
                                <Button Style="{StaticResource AccentBtn}" Content="選択中のアイテムに適用" Margin="0,0,0,6"
                                        Click="FxApply_Click"/>
                                <Button Style="{StaticResource FilledBtn}" Content="書式を削除"
                                        Command="{Binding RemoveCommand}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== 音声エフェクトタブ ===== -->
        <Grid Grid.Row="1" Visibility="Collapsed">
            <Grid DataContext="{Binding AudioFx}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="12,10,12,4">
                    <StackPanel>
                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                                Visibility="{Binding IsWatching, Converter={StaticResource B2V}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding WatchText}" Foreground="{StaticResource Accent}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="20"/>
                                <Button Grid.Column="1" Style="{StaticResource FilledBtn}" Content="中止" Margin="12,0,0,0"
                                        VerticalAlignment="Center" Command="{Binding CancelWatchCommand}"/>
                            </Grid>
                        </Border>
                        <WrapPanel VerticalAlignment="Center">
                            <Button Style="{StaticResource AccentBtn}" Content="選択中のアイテムから読み取る" Margin="0,0,8,6"
                                    ToolTip="YMM4で、エフェクトを読み取りたいアイテムを選んでから押します。コピーのキー操作を自動で送り、そのアイテムのエフェクトを1つのまとまりとして保存します"
                                    Click="FxReadSelected_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="コピー済みのアイテムから読み取る" Margin="0,0,8,6"
                                    ToolTip="すでにYMM4でアイテムをコピーしてある時に押します" Click="FxReadClipboard_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="コピーを待って追加(そのまま保存)" Margin="0,0,8,6"
                                    ToolTip="押したあとYMM4でエフェクトをコピー(Ctrl+C)すると、コピーした内容をそのまま保存します"
                                    Command="{Binding WatchCommand}"/>
                            <Button Style="{StaticResource FilledBtn}" Content="クリップボードから追加(そのまま保存)" Margin="0,0,8,6"
                                    ToolTip="すでにコピーしてある内容を、そのまま保存します" Click="FxCapture_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="選択中のアイテムに適用 (ダブルクリック)" Margin="0,0,16,6"
                                    Click="FxApply_Click"/>
                            <CheckBox Style="{StaticResource Check}" VerticalAlignment="Center" Margin="0,0,16,6"
                                      IsChecked="{Binding RemoveBeforeApply}"
                                      ToolTip="オンにすると、適用の前に、選択中のアイテムのエフェクトをすべて削除してから、このまとまりを追加します。オフなら、いまのエフェクトを残したまま、後ろに追加します"
                                      Content="適用前に、選択中のアイテムのエフェクトをすべて削除する"/>
                            <Button Style="{StaticResource FilledBtn}" Content="標準・プラグインのエフェクトをすべて自動収録" Margin="0,0,8,6"
                                    ToolTip="YMM4に入っている標準のエフェクトと、プラグインで追加されたエフェクトを、このタブにすべて収録します。収録後は、削除・並べ替えができます(タブごとに独立)"
                                    Command="{Binding AutoRegisterCommand}"/>
                            <Button Style="{StaticResource FilledBtn}" Content="すべて選択 (Ctrl+A)" Margin="0,0,8,6"
                                    Click="FxSelectAll_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="選択解除" Margin="0,0,8,6"
                                    Click="FxClearSelection_Click"/>
                            <Button Style="{StaticResource FilledBtn}" Content="選択を削除 (Delete)" Margin="0,0,0,6"
                                    Command="{Binding RemoveCommand}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                            <TextBlock Text="並べ替え" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,10,0"
                                       ToolTip="選んだ項目をまとめて移動します"/>
                            <Button Style="{StaticResource FilledBtn}" Content="◀ 前へ" Padding="12,5" Margin="0,0,6,0"
                                    ToolTip="1つ前へ (Alt+←)" Command="{Binding MoveCommand}" CommandParameter="up"/>
                            <Button Style="{StaticResource FilledBtn}" Content="後ろへ ▶" Padding="12,5" Margin="0,0,6,0"
                                    ToolTip="1つ後ろへ (Alt+→)" Command="{Binding MoveCommand}" CommandParameter="down"/>
                            <Button Style="{StaticResource FilledBtn}" Content="先頭へ" Padding="12,5" Margin="0,0,6,0"
                                    Command="{Binding MoveCommand}" CommandParameter="top"/>
                            <Button Style="{StaticResource FilledBtn}" Content="末尾へ" Padding="12,5" Margin="0,0,12,0"
                                    Command="{Binding MoveCommand}" CommandParameter="bottom"/>
                            <TextBlock Text="タイルをドラッグして、好きな位置へ移動もできます" Foreground="{StaticResource Sub}"
                                       FontSize="11" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <TextBlock Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,4" LineHeight="20"
                                   Text="【読み取り】YMM4で、エフェクトを読み取りたいアイテムを選び、「選択中のアイテムから読み取る」を押すと、そのアイテムのエフェクトが1つのまとまりとして保存されます。&#x0A;【適用】YMM4で適用したいアイテムを選んでおき、ここでまとまりをダブルクリックします。選択中のアイテムを自動でコピーして、エフェクトを足したものに置き換えます(追加・置き換えや、元のアイテムを残すかどうかは、設定で変えられます)。"/>
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="6" CornerRadius="10" Background="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBox Style="{StaticResource Field}" Margin="8,8,8,2" Tag="エフェクトを検索(名前・メモ・読み・英語)" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Text="エフェクトがありません&#x0A;YMM4でエフェクトをコピーして、「コピーを待って追加」から追加できます"
                                       Foreground="{StaticResource Sub}" TextAlignment="Center" LineHeight="22"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoItems, Converter={StaticResource B2V}}"/>
                            <ListBox Grid.Row="1" x:Name="AudioFxList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Text}" SelectionMode="Extended" AllowDrop="True"
                                     ItemsSource="{Binding Items}"
                                     ItemContainerStyle="{StaticResource Row}"
                                     ItemTemplate="{StaticResource EffectTileTpl}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewKeyDown="FxList_PreviewKeyDown"
                                     SelectionChanged="FxList_SelectionChanged"
                                     MouseDoubleClick="FxList_MouseDoubleClick"
                                     DragOver="FxList_DragOver" DragLeave="FxList_DragLeave" Drop="FxList_Drop">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                            <Canvas Grid.Row="1" IsHitTestVisible="False">
                                <Rectangle x:Name="AudioFxRubberRect" Visibility="Collapsed" Fill="#4060CDFF"
                                           Stroke="{StaticResource Accent}" StrokeThickness="1"/>
                                <Rectangle x:Name="AudioFxInsertMark" Visibility="Collapsed" Fill="{StaticResource Accent}" RadiusX="1.5" RadiusY="1.5"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Width="280" Margin="0,6,6,6" Padding="16,14,16,16" CornerRadius="10"
                            Background="{StaticResource Panel}">
                        <ScrollViewer local:WheelFix.Enabled="True" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="エフェクトを1つ選ぶと、名前やメモ・サムネイルを編集できます"
                                           Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Visibility="{Binding HasNoSelected, Converter={StaticResource B2V}}"/>
                                <StackPanel Visibility="{Binding HasSelected, Converter={StaticResource B2V}}">
                                    <Border CornerRadius="8" Background="{StaticResource Card}" ClipToBounds="True" Margin="0,0,0,8">
                                        <Grid MinHeight="110">
                                            <TextBlock Text="{Binding SelectedItem.Placeholder}" FontSize="42" Foreground="{StaticResource Sub}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding SelectedItem.HasNoThumb, Converter={StaticResource B2V}}"/>
                                            <Image Source="{Binding SelectedItem.Thumb}" MaxHeight="170" Stretch="Uniform" Margin="4"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                    <Button Style="{StaticResource FilledBtn}" Content="クリップボードの画像を貼り付け (Ctrl+V)" Margin="0,0,0,6"
                                            Command="{Binding PasteThumbnailCommand}"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="YMM4のプレビュー画面を取り込む" Margin="0,0,0,6"
                                            ToolTip="いまYMM4のプレビューに映っている画像を、サムネイルにします" Command="{Binding PreviewThumbnailCommand}"/>
                                    <TextBlock Text="ショートカットキー" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,8,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <local:KeyRecorder Style="{StaticResource Field}" Keys="{Binding SelectedItem.ShortcutKeys, Mode=TwoWay}" ToolTip="クリックして、割り当てたいキーを実際に押すと記録されます(Delete: 解除 / Esc: 取りやめ)"/>
                                        <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="32" Height="32" Margin="6,0,0,0"
                                                ToolTip="このショートカットを削除" Click="ClearKeyRecorder_Click"/>
                                    </Grid>
                                    <Button Style="{StaticResource FilledBtn}" Content="画像ファイルを選ぶ…" Margin="0,0,0,6"
                                            Click="FxThumbFile_Click"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="サムネイルを削除" Margin="0,0,0,12"
                                            Command="{Binding ClearThumbnailCommand}"/>

                                    <TextBlock Text="名前" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding SelectedItem.Name, UpdateSourceTrigger=LostFocus}"
                                             Margin="0,0,0,10"/>
                                    <TextBlock Text="メモ" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding SelectedItem.Memo, UpdateSourceTrigger=LostFocus}"
                                             Height="90" Padding="10,6" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding SelectedItem.Summary}" Foreground="{StaticResource Sub}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SelectedItem.DataId, StringFormat='データID: {0}'}" Foreground="{StaticResource Sub}"
                                               FontSize="11" Margin="0,0,0,2" ToolTip="保存してあるデータの指紋です。別々のエフェクトなのに同じなら、同じ内容を保存しています"/>
                                    <TextBlock Text="{Binding SelectedItem.BundleText}" Foreground="{StaticResource Sub}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,4,0,6"
                                               Visibility="{Binding SelectedItem.IsBundle, Converter={StaticResource B2V}}"/>
                                    <TextBlock Text="{Binding SelectedItem.CreatedText}" Foreground="{StaticResource Sub}" Margin="0,0,0,14"/>
                                </StackPanel>
                                <Button Style="{StaticResource AccentBtn}" Content="選択中のアイテムに適用" Margin="0,0,0,6"
                                        Click="FxApply_Click"/>
                                <Button Style="{StaticResource FilledBtn}" Content="エフェクトを削除"
                                        Command="{Binding RemoveCommand}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== YMM4設定タブ ===== -->
        <Grid Grid.Row="1" Background="{StaticResource Bg}" Visibility="{Binding ShowYmmSettingsView, Converter={StaticResource B2V}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 上: 検索・操作 -->
            <Border Grid.ColumnSpan="2" Padding="12,12,12,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource Field}" Tag="YMM4の設定を検索(名前・説明)"
                                 Text="{Binding YmmSettingFilter, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Style="{StaticResource FilledBtn}" Content="読み込み直す" Margin="0,0,8,0"
                                    ToolTip="YMM4の設定を、もう一度読み込みます" Command="{Binding LoadYmmSettingsCommand}"/>
                            <Button Style="{StaticResource FilledBtn}" Content="開いた時の値に戻す"
                                    ToolTip="このタブを開いてから変更した項目を、すべて元の値に戻します" Command="{Binding RevertYmmSettingsCommand}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding YmmSettingMessage}" Foreground="{StaticResource Sub}" FontSize="11"
                               TextWrapping="Wrap" Margin="2,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 左: グループ -->
            <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10" Margin="10,0,0,10">
                <ListBox ItemsSource="{Binding VisibleYmmGroups}" SelectedItem="{Binding SelectedYmmGroup, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0,6"
                         ItemContainerStyle="{StaticResource Row}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{StaticResource Sub}" FontSize="11"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 右: 選んだグループの項目 -->
            <ScrollViewer local:WheelFix.Enabled="True" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10,0,10,10">
                <StackPanel Visibility="{Binding HasSelectedYmmGroup, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding SelectedYmmGroup.Title}" FontSize="18" FontWeight="SemiBold" Margin="4,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding SelectedYmmGroup.SubGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16" Visibility="{Binding IsVisible, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"
                                               Margin="4,0,0,8" Visibility="{Binding HasTitle, Converter={StaticResource B2V}}"/>
                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14,11" Margin="0,0,0,6"
                                                        Visibility="{Binding IsVisible, Converter={StaticResource B2V}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                                       ToolTip="{Binding PropertyName}"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource Sub}" FontSize="11"
                                                                       TextWrapping="Wrap" Margin="0,3,0,0"
                                                                       Visibility="{Binding HasDescription, Converter={StaticResource B2V}}"/>
                                                            <TextBlock Text="{Binding Error}" Foreground="#F87171" FontSize="11" Margin="0,3,0,0"
                                                                       Visibility="{Binding HasError, Converter={StaticResource B2V}}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource IconBtn}" Content="&#xE7A7;" Width="30" Height="30" Margin="0,0,8,0"
                                                                    ToolTip="開いた時の値に戻す" Command="{Binding RevertCommand}"
                                                                    Visibility="{Binding IsChanged, Converter={StaticResource B2V}}"/>
                                                            <CheckBox Style="{StaticResource SwitchCheck}" HorizontalAlignment="Right" Margin="0"
                                                                      IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                                      Visibility="{Binding IsBool, Converter={StaticResource B2V}}"/>
                                                            <TextBox Width="180" Style="{StaticResource Field}"
                                                                     Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}"
                                                                     Visibility="{Binding IsNumberOrText, Converter={StaticResource B2V}}"/>
                                                            <ComboBox Width="180" ItemsSource="{Binding Options}"
                                                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                      SelectedValue="{Binding EnumValue, Mode=TwoWay}"
                                                                      Visibility="{Binding IsEnum, Converter={StaticResource B2V}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== 素材データベースタブ(Eagle風) ===== -->
        <Grid Grid.Row="1" Background="{StaticResource Bg}" Visibility="{Binding ShowMaterialView, Converter={StaticResource B2V}}"
              AllowDrop="True" DragOver="MaterialArea_DragOver" Drop="MaterialArea_Drop">
            <Grid DataContext="{Binding Materials}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <!-- 上: 検索・取り込み・表示の切り替え -->
                <Border Grid.ColumnSpan="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="12,10,12,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource Field}" Tag="素材を検索(名前・タグ・メモ・拡張子)"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                <Button Style="{StaticResource AccentBtn}" Content="＋ ファイルを取り込む" Margin="0,0,8,0"
                                        ToolTip="ファイルを選んで、まとめて取り込みます(エクスプローラーからのドラッグ&amp;ドロップでも取り込めます)"
                                        Click="MaterialImportFiles_Click"/>
                                <ToggleButton Style="{StaticResource PillToggle}" Content="🎵 AIで音を作る" Margin="0,0,8,0"
                                              ToolTip="Audio Studio MCP(パソコンの中で動く音声生成AI)とつないで、BGM・効果音を作り、そのまま素材として取り込みます"
                                              IsChecked="{Binding Studio.IsOpen, Mode=TwoWay}"/>
                                <ToggleButton Style="{StaticResource PillToggle}" Content="🖼 ローカルAIで作る" Margin="0,0,8,0"
                                              ToolTip="Local AI Studio(このPCの中で動くAI)で、画像や音楽(Audio Studio MCP も)を作って、そのまま素材として取り込みます。モデルごとの性能・重さも確認できます"
                                              IsChecked="{Binding LocalGen.IsOpen, Mode=TwoWay}"/>
                                <Button Style="{StaticResource FilledBtn}" Content="フォルダーを取り込む"
                                        ToolTip="フォルダーの中のファイルを、すべて取り込みます"
                                        Click="MaterialImportFolder_Click"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,8,0,0">
                            <ToggleButton Style="{StaticResource PillToggle}" Content="{Binding FilterButtonText}" IsChecked="{Binding FilterOpen, Mode=TwoWay}"
                                          Margin="0,0,14,4" ToolTip="種類・評価・拡張子・形・色で絞り込みます"/>
                            <TextBlock Text="並べ替え" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                            <ComboBox Width="110" Margin="0,0,8,4" ItemsSource="{Binding SortOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SortMode, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource Check}" Content="降順" Margin="0,4,16,4" IsChecked="{Binding SortDescending}"/>
                            <RadioButton Style="{StaticResource PillToggle}" GroupName="MatLayout" Content="ウォーターフォール" IsChecked="{Binding LayoutWaterfall, Mode=TwoWay}"
                                         Margin="0,0,6,4" ToolTip="画像の縦横比のまま、すき間なく並べます"/>
                            <RadioButton Style="{StaticResource PillToggle}" GroupName="MatLayout" Content="行そろえ" IsChecked="{Binding LayoutJustified, Mode=TwoWay}"
                                         Margin="0,0,6,4" ToolTip="行の高さをそろえて、画像の縦横比に合わせてタイルの幅を変えます(横長の画像は広く、縦長の画像は細く)"/>
                            <RadioButton Style="{StaticResource PillToggle}" GroupName="MatLayout" Content="グリッド" IsChecked="{Binding LayoutGrid, Mode=TwoWay}"
                                         Margin="0,0,12,4" ToolTip="同じ大きさのタイルで並べます"/>
                            <TextBlock Text="大きさ" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                            <Slider Width="120" Minimum="80" Maximum="360" Value="{Binding TileSize, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,4"
                                    IsMoveToPointEnabled="True" ToolTip="タイルの大きさ"/>
                            <CheckBox Style="{StaticResource Check}" Content="名前を表示" Margin="0,4,16,4" IsChecked="{Binding ShowNames}"/>
                            <TextBlock Text="{Binding CountText}" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,12,4"/>
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Accent}" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- フィルター: 種類・評価・拡張子・形・色 -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1"
                        Padding="12,8,12,10" Visibility="{Binding FilterOpen, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <WrapPanel>
                            <RadioButton Style="{StaticResource PillToggle}" GroupName="MatKind" Content="すべて" IsChecked="{Binding KindAll, Mode=TwoWay}" Margin="0,0,6,6"/>
                            <RadioButton Style="{StaticResource PillToggle}" GroupName="MatKind" Content="画像" IsChecked="{Binding KindImage, Mode=TwoWay}" Margin="0,0,6,6"/>
                            <RadioButton Style="{StaticResource PillToggle}" GroupName="MatKind" Content="動画" IsChecked="{Binding KindVideo, Mode=TwoWay}" Margin="0,0,6,6"/>
                            <RadioButton Style="{StaticResource PillToggle}" GroupName="MatKind" Content="音声" IsChecked="{Binding KindAudio, Mode=TwoWay}" Margin="0,0,6,6"/>
                            <RadioButton Style="{StaticResource PillToggle}" GroupName="MatKind" Content="その他" IsChecked="{Binding KindOther, Mode=TwoWay}" Margin="0,0,18,6"/>
                            <TextBlock Text="評価" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,6,6"/>
                            <ComboBox Width="96" Margin="0,0,14,6" SelectedIndex="{Binding RatingIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="指定なし"/>
                                <ComboBoxItem Content="★1 以上"/>
                                <ComboBoxItem Content="★2 以上"/>
                                <ComboBoxItem Content="★3 以上"/>
                                <ComboBoxItem Content="★4 以上"/>
                                <ComboBoxItem Content="★5"/>
                            </ComboBox>
                            <TextBlock Text="拡張子" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,6,6"/>
                            <ComboBox Width="90" Margin="0,0,14,6" ItemsSource="{Binding ExtChoices}" SelectedItem="{Binding ExtChoice, Mode=TwoWay}"/>
                            <TextBlock Text="形" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,6,6"/>
                            <ComboBox Width="92" Margin="0,0,14,6" SelectedIndex="{Binding ShapeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="指定なし"/>
                                <ComboBoxItem Content="横長"/>
                                <ComboBoxItem Content="縦長"/>
                                <ComboBoxItem Content="正方形"/>
                            </ComboBox>
                            <Button Style="{StaticResource FilledBtn}" Content="条件をすべて解除" Padding="10,4" Margin="0,0,0,6" Command="{Binding ClearFiltersCommand}"/>
                        </WrapPanel>

                        <TextBlock Text="色で探す" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,4,0,6"/>
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding ColorPresets}" Margin="0,0,10,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="24" Height="24" Margin="0,0,5,0" Cursor="Hand" ToolTip="{Binding Tip}"
                                                Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Hex}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{Binding Brush}" CornerRadius="12" BorderBrush="{StaticResource Stroke}" BorderThickness="1"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Style="{StaticResource Field}" Width="96" Tag="#RRGGBB" MaxLength="9" Margin="0,0,6,6"
                                     Text="{Binding ColorHexText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding ApplyHexCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Style="{StaticResource FilledBtn}" Content="この色で探す" Padding="10,4" Margin="0,0,8,6" Command="{Binding ApplyHexCommand}"/>
                            <Button Style="{StaticResource FilledBtn}" Content="選択中の素材の色で探す" Padding="10,4" Margin="0,0,14,6"
                                    ToolTip="選んでいる素材のいちばん目立つ色に近い素材を探します" Command="{Binding SimilarColorCommand}"/>
                            <TextBlock Text="近さ" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,6,6"/>
                            <Slider Width="110" Minimum="8" Maximum="60" Value="{Binding ColorTolerance, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,6"
                                    ToolTip="左ほど厳しく(そっくりな色だけ)、右ほどゆるく探します"/>
                            <TextBlock Text="厳しい ← → ゆるい" Foreground="{StaticResource Sub}" FontSize="10" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Width="16" Height="16" CornerRadius="8" Margin="0,0,8,0" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                    Background="{Binding ColorFilterBrush}" Visibility="{Binding HasColorFilter, Converter={StaticResource B2V}}"/>
                            <TextBlock Text="{Binding ColorFilterText}" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource FilledBtn}" Content="色を解除" Padding="8,2" FontSize="11" Margin="10,0,0,0"
                                    Command="{Binding ClearColorCommand}" Visibility="{Binding HasColorFilter, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 左: フォルダー・タグ -->
                <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
                    <ScrollViewer local:WheelFix.Enabled="True" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,10,6,10">
                            <ListBox ItemsSource="{Binding FolderItems}" SelectedItem="{Binding SelectedFolderItem, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Row}"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="13" Foreground="{StaticResource Sub}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{StaticResource Sub}" FontSize="11" Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Margin="6,8,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource Field}" Tag="新しいフォルダー" MaxLength="40"
                                         Text="{Binding NewFolderText, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding AddFolderCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE710;" Width="30" Height="30" Margin="4,0,0,0"
                                        ToolTip="フォルダーを作る" Command="{Binding AddFolderCommand}"/>
                                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="30" Height="30" Margin="4,0,0,0"
                                        ToolTip="選んでいるフォルダーを削除(中の素材は未分類に戻ります)" Command="{Binding DeleteFolderCommand}"/>
                            </Grid>

                            <Grid Margin="10,20,6,6">
                                <TextBlock Text="タグ" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource FilledBtn}" Content="絞り込みを解除" Padding="8,2" FontSize="11"
                                        HorizontalAlignment="Right" Command="{Binding ClearTagFilterCommand}"/>
                            </Grid>
                            <TextBox Style="{StaticResource Field}" Tag="タグを検索" Margin="6,0,6,8"
                                     Text="{Binding TagFilterText, UpdateSourceTrigger=PropertyChanged}"/>
                            <ItemsControl ItemsSource="{Binding TagView}" Margin="4,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource PillToggle}" Content="{Binding Display}"
                                                      IsChecked="{Binding IsActive, Mode=TwoWay}" Margin="0,0,6,6" FontSize="12"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 中: 素材の一覧 -->
                <Grid Grid.Row="2" Grid.Column="1" Background="{StaticResource Bg}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource Card}" Padding="14,8" Visibility="{Binding IsTrashView, Converter={StaticResource B2V}}">
                        <Grid>
                            <TextBlock Foreground="{StaticResource Sub}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,150,0"
                                       Text="ゴミ箱です。素材を選んで「元に戻す」か「完全に削除」を押してください。完全に削除するまで、ファイルは消えません。"/>
                            <Button Style="{StaticResource FilledBtn}" Content="ゴミ箱を空にする" Padding="10,4" HorizontalAlignment="Right"
                                    Command="{Binding EmptyTrashCommand}"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <TextBlock Text="素材がありません&#x0A;ファイル・フォルダーを、ここへドラッグ&amp;ドロップするか、上のボタンで取り込めます&#x0A;(エクスプローラーのタブで選んで、右クリック →「素材データベースに追加」でも入れられます)"
                                   Foreground="{StaticResource Sub}" TextAlignment="Center" LineHeight="22" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"
                                   Visibility="{Binding HasNoItems, Converter={StaticResource B2V}}"/>
                        <ListBox x:Name="MaterialList" Background="Transparent" BorderThickness="0" Padding="8"
                                 Foreground="{StaticResource Text}" SelectionMode="Extended"
                                 ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource TileItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="MaterialList_SelectionChanged" MouseDoubleClick="MaterialList_MouseDoubleClick"
                                 SizeChanged="MaterialList_SizeChanged">
                            <ListBox.InputBindings>
                                <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
                            </ListBox.InputBindings>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:WaterfallPanel Flow="{Binding LayoutJustified}"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="{Binding TileWidth}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="{StaticResource Card}" CornerRadius="6" Height="{Binding TileHeight}" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding KindGlyph}" FontSize="34"
                                                           Foreground="{StaticResource Sub}" HorizontalAlignment="Center"
                                                           Visibility="{Binding HasNoThumb, Converter={StaticResource B2V}}"/>
                                                <Image Source="{Binding Thumb}" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding RatingText}" Foreground="#FFC83D" FontSize="11" Margin="6,0,0,5"
                                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="Black" Opacity="0.9"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5"
                                                        Background="#B0000000" CornerRadius="3" Padding="5,1" IsHitTestVisible="False"
                                                        Visibility="{Binding HasDuration, Converter={StaticResource B2V}}">
                                                    <TextBlock Text="{Binding DurationText}" FontSize="10" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="2,5,2,2"
                                                   ToolTip="{Binding InfoText}"
                                                   Visibility="{Binding DataContext.ShowNames, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource B2V}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="MaterialRubberRect" Visibility="Collapsed" Fill="#4060CDFF"
                                       Stroke="{StaticResource Accent}" StrokeThickness="1"/>
                        </Canvas>
                    </Grid>
                </Grid>

                <!-- 右: インスペクター(プレビュー・評価・タグ・色・メモ) -->
                <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0" Padding="14,12,14,14">
                    <ScrollViewer local:WheelFix.Enabled="True" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="素材を選ぶと、ここにプレビューと詳細が出ます" Foreground="{StaticResource Sub}" TextWrapping="Wrap"
                                       Visibility="{Binding HasNoSelection, Converter={StaticResource B2V}}"/>
                            <TextBlock Text="{Binding SelectionText}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Visibility="{Binding HasMulti, Converter={StaticResource B2V}}"/>

                            <StackPanel Visibility="{Binding HasSingle, Converter={StaticResource B2V}}">
                                <Border Background="#101114" CornerRadius="8" Height="200" ClipToBounds="True" Margin="0,0,0,8">
                                    <Grid>
                                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding ShowImagePreview, Converter={StaticResource B2V}}"/>
                                        <MediaElement x:Name="MaterialPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                                      ScrubbingEnabled="True" Stretch="Uniform" Volume="0.8"
                                                      Visibility="{Binding ShowMediaPreview, Converter={StaticResource B2V}}"/>
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="54" Foreground="{StaticResource Sub}"
                                                   HorizontalAlignment="Center" IsHitTestVisible="False"
                                                   Visibility="{Binding ShowAudioGlyph, Converter={StaticResource B2V}}"/>
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7C3;" FontSize="54" Foreground="{StaticResource Sub}"
                                                   HorizontalAlignment="Center" IsHitTestVisible="False"
                                                   Visibility="{Binding ShowOtherGlyph, Converter={StaticResource B2V}}"/>
                                    </Grid>
                                </Border>
                                <Grid Margin="0,0,0,10" Visibility="{Binding ShowMediaPreview, Converter={StaticResource B2V}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="MaterialPlayBtn" Style="{StaticResource IconBtn}" Content="&#xE768;" ToolTip="再生 / 一時停止"/>
                                    <Slider x:Name="MaterialSeek" Grid.Column="1" Style="{StaticResource Seek}" Margin="8,0"
                                            Minimum="0" Maximum="1" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBox Style="{StaticResource Field}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"
                                         Text="{Binding DetailName, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="{Binding DetailInfo}" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,12"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource B2V}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <Button Style="{StaticResource FilledBtn}" Content="{Binding Star1}" Width="34" Height="34" Padding="0" FontSize="18" Foreground="#FFC83D" Margin="0,0,3,0" Command="{Binding SetRatingCommand}" CommandParameter="1"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="{Binding Star2}" Width="34" Height="34" Padding="0" FontSize="18" Foreground="#FFC83D" Margin="0,0,3,0" Command="{Binding SetRatingCommand}" CommandParameter="2"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="{Binding Star3}" Width="34" Height="34" Padding="0" FontSize="18" Foreground="#FFC83D" Margin="0,0,3,0" Command="{Binding SetRatingCommand}" CommandParameter="3"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="{Binding Star4}" Width="34" Height="34" Padding="0" FontSize="18" Foreground="#FFC83D" Margin="0,0,3,0" Command="{Binding SetRatingCommand}" CommandParameter="4"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="{Binding Star5}" Width="34" Height="34" Padding="0" FontSize="18" Foreground="#FFC83D" Margin="0,0,8,0" Command="{Binding SetRatingCommand}" CommandParameter="5"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="外す" Padding="10,3" Height="34" Command="{Binding SetRatingCommand}" CommandParameter="0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DetailRatingText}" Foreground="{StaticResource Sub}" FontSize="11" Margin="2,0,0,14"/>

                                <TextBlock Text="タグ" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding DetailTags}" Margin="0,0,0,2">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource FilledBtn}" Padding="9,3" Margin="0,0,6,6"
                                                    ToolTip="クリックで、このタグを外します"
                                                    Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock>
                                                    <Run Text="#"/><Run Text="{Binding Path=., Mode=OneWay}"/><Run Text="  ×"/>
                                                </TextBlock>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource Field}" Tag="タグを入力して Enter(複数は、空白かカンマで区切る)"
                                             Text="{Binding NewTagText, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddTagCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Style="{StaticResource AccentBtn}" Content="追加" Padding="12,5" Margin="6,0,0,0"
                                            Command="{Binding AddTagCommand}"/>
                                </Grid>

                                <TextBlock Text="フォルダー" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox Margin="0,0,0,14" ItemsSource="{Binding FolderChoices}" SelectedItem="{Binding DetailFolder, Mode=TwoWay}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasPalette, Converter={StaticResource B2V}}" Margin="0,0,0,14">
                                <TextBlock Text="色(クリックで、近い色の素材を探します)" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding DetailPalette}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="34" Height="34" Margin="0,0,6,6" Cursor="Hand" ToolTip="{Binding Tip}"
                                                    Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Hex}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{Binding Brush}" CornerRadius="6" BorderBrush="{StaticResource Stroke}" BorderThickness="1"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasSingle, Converter={StaticResource B2V}}">
                                <TextBlock Text="ソース(URL)" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource Field}" Tag="素材の出どころのURL" Margin="0,0,0,14"
                                         Text="{Binding DetailUrl, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="メモ" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" Margin="0,0,0,14"
                                         VerticalScrollBarVisibility="Auto" Text="{Binding DetailMemo, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>

                            <WrapPanel Visibility="{Binding HasSelection, Converter={StaticResource B2V}}">
                                <Button Style="{StaticResource AccentBtn}" Content="大きくプレビュー" Padding="12,5" Margin="0,0,6,6"
                                        ToolTip="一覧でダブルクリックしても開けます" Command="{Binding ViewerOpenCommand}"/>
                                <Button Style="{StaticResource FilledBtn}" Content="既定のアプリで開く" Margin="0,0,6,6" Command="{Binding OpenCommand}"/>
                                <Button Style="{StaticResource FilledBtn}" Content="エクスプローラーで表示" Margin="0,0,6,6" Command="{Binding ShowInExplorerCommand}"/>
                                <Button Style="{StaticResource FilledBtn}" Content="パスをコピー" Margin="0,0,6,6" Command="{Binding CopyPathCommand}"/>
                            </WrapPanel>
                            <WrapPanel Visibility="{Binding HasSelection, Converter={StaticResource B2V}}">
                                <Button Style="{StaticResource FilledBtn}" Content="ゴミ箱へ入れる (Delete)" Margin="0,0,6,6" Command="{Binding DeleteCommand}"
                                        Visibility="{Binding IsNotTrashView, Converter={StaticResource B2V}}"/>
                                <Button Style="{StaticResource FilledBtn}" Content="ファイルを削除(完全に削除)" Margin="0,0,6,6" Command="{Binding PermanentDeleteCommand}"
                                        ToolTip="ゴミ箱に入れずに、ライブラリー内のファイルごと消します(確認があります)"
                                        Visibility="{Binding IsNotTrashView, Converter={StaticResource B2V}}"/>
                                <Button Style="{StaticResource AccentBtn}" Content="元に戻す" Margin="0,0,6,6" Command="{Binding RestoreCommand}"
                                        Visibility="{Binding IsTrashView, Converter={StaticResource B2V}}"/>
                                <Button Style="{StaticResource FilledBtn}" Content="完全に削除" Margin="0,0,6,6" Command="{Binding DeleteCommand}"
                                        Visibility="{Binding IsTrashView, Converter={StaticResource B2V}}"/>
                            </WrapPanel>
                            <TextBlock Text="一覧から YMM4のタイムラインへ、ドラッグして使えます" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding HasSelection, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>


                <!-- ローカルAIで作る(Local AI Studio と連携: 画像・音楽) -->
                <Grid Grid.RowSpan="3" Grid.ColumnSpan="3" Background="#C0101114" Visibility="{Binding LocalGen.IsOpen, Converter={StaticResource B2V}}">
                    <Border DataContext="{Binding LocalGen}" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            CornerRadius="12" MaxWidth="860" Margin="20" VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="18,14,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="🖼 ローカルAIで作る(Local AI Studio)" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Hardware}" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource FilledBtn}" Content="Local AI Studio を開く" Padding="10,4" Margin="0,0,6,0"
                                                ToolTip="モデルのインストールや、Audio Studio MCP の設定は Local AI Studio で行います" Command="{Binding OpenAppCommand}"/>
                                        <Button Style="{StaticResource FilledBtn}" Content="読み直す" Padding="10,4" Margin="0,0,6,0"
                                                ToolTip="モデルの一覧を読み直します(Local AI Studio でインストールした後に)" Command="{Binding RefreshCommand}"/>
                                        <Button Style="{StaticResource IconBtn}" Content="&#xE711;" ToolTip="閉じる" Command="{Binding CloseCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" local:WheelFix.Enabled="True" VerticalScrollBarVisibility="Auto" MaxHeight="600">
                                <StackPanel Margin="18,14,18,10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <RadioButton Style="{StaticResource PillToggle}" GroupName="LocalGenMode" Content="🖼 画像" Margin="0,0,6,0" IsChecked="{Binding IsImage, Mode=TwoWay}"/>
                                        <RadioButton Style="{StaticResource PillToggle}" GroupName="LocalGenMode" Content="🎵 音楽・効果音" IsChecked="{Binding IsMusic, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <TextBlock Text="モデル" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding Model, Mode=TwoWay}" DisplayMemberPath="Display" Margin="0,0,0,6"/>
                                    <Border Background="{StaticResource Card}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ModelNote}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ModelDescription}" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding ModelState}" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <Button Style="{StaticResource FilledBtn}" Content="🗑 このモデルをアンインストール" Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Left" FontSize="11"
                                                    ToolTip="このPCから、モデルのファイルを削除します(Local AI Studio の中で削除します)" Command="{Binding UninstallCommand}"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="作りたいもの(プロンプト)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="70" VerticalContentAlignment="Top" PreviewKeyDown="ItemMultiline_PreviewKeyDown"/>
                                    <TextBlock Text="{Binding PromptHint}" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,10"/>

                                    <!-- 参考ファイル(この画像をもとに・このメロディーのように) -->
                                    <TextBlock Text="{Binding ReferenceTitle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Border Background="{StaticResource Card}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Style="{StaticResource FilledBtn}" Content="ファイルを選ぶ…" Padding="8,3" Margin="6,0,0,0" Command="{Binding PickReferenceCommand}"/>
                                                    <Button Style="{StaticResource FilledBtn}" Content="選択中の素材" Padding="8,3" Margin="4,0,0,0" Command="{Binding UseSelectedCommand}"
                                                            ToolTip="素材データベースで選んでいる素材(画像・音声)を参考にします"/>
                                                    <Button Style="{StaticResource FilledBtn}" Content="×" Padding="8,3" Margin="4,0,0,0" Command="{Binding ClearReferenceCommand}"
                                                            ToolTip="参考ファイルを外します" Visibility="{Binding HasReference, Converter={StaticResource B2V}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ReferenceName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reference}"/>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsImage}" Value="True"/>
                                                                    <Condition Binding="{Binding HasReference}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="変える強さ" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Slider Width="160" Minimum="0.05" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                        Value="{Binding Strength, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding StrengthText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ReferenceNote}" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 画像の設定 -->
                                    <Grid Visibility="{Binding IsImage, Converter={StaticResource B2V}}" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="サイズ" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                        <ComboBox Grid.Row="1" ItemsSource="{Binding Sizes}" SelectedIndex="{Binding SizeIndex, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="2" Text="ステップ数(1〜50)" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}" Text="{Binding Steps, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="入れたくないもの(ネガティブプロンプト・省略可)" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,8,0,3"/>
                                        <TextBox Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Field}" Text="{Binding NegativePrompt, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <!-- 音楽の設定 -->
                                    <StackPanel Visibility="{Binding IsMusic, Converter={StaticResource B2V}}" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Width="150">
                                                <TextBlock Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3">
                                                    <Run Text="長さ(秒・"/><Run Text="{Binding DurationMin, Mode=OneWay}"/><Run Text="〜"/><Run Text="{Binding DurationMax, Mode=OneWay}"/><Run Text=")"/>
                                                </TextBlock>
                                                <TextBox Style="{StaticResource Field}" Text="{Binding Duration, UpdateSourceTrigger=LostFocus}"/>
                                            </StackPanel>
                                            <StackPanel Width="190" Margin="12,0,0,0" Visibility="{Binding IsAudioStudio, Converter={StaticResource B2V}}">
                                                <TextBlock Text="音の種類" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                                <ComboBox ItemsSource="{Binding AudioTypes}" SelectedIndex="{Binding AudioTypeIndex, Mode=TwoWay}"/>
                                            </StackPanel>
                                            <StackPanel Width="110" Margin="12,0,0,0" Visibility="{Binding IsAudioStudio, Converter={StaticResource B2V}}">
                                                <TextBlock Text="候補の数(1〜4)" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                                <TextBox Style="{StaticResource Field}" Text="{Binding Variations, UpdateSourceTrigger=LostFocus}"/>
                                            </StackPanel>
                                            <StackPanel Width="120" Margin="12,0,0,0" Visibility="{Binding IsAudioStudio, Converter={StaticResource B2V}}">
                                                <TextBlock Text="テンポ BPM(省略可)" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                                <TextBox Style="{StaticResource Field}" Text="{Binding Bpm, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="シード(省略可。同じ数で、同じ結果を作り直せます)" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox Style="{StaticResource Field}" Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="18,10,18,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <Run Text="{Binding ElapsedText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Log, Mode=OneWay}"/>
                                        </TextBlock>
                                        <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="1" BorderThickness="0" Background="#22FFFFFF"
                                                     Foreground="{StaticResource Accent}" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressUnknown, Mode=OneWay}"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Style="{StaticResource FilledBtn}" Content="生成したファイル" Padding="10,5" Margin="0,0,6,0"
                                                ToolTip="Local AI Studio が作ったファイルのフォルダーを開きます" Command="{Binding OpenOutputCommand}"/>
                                        <Button Style="{StaticResource FilledBtn}" Content="待つのをやめる" Padding="10,5" Margin="0,0,6,0" Command="{Binding CancelCommand}"
                                                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"/>
                                        <Button Style="{StaticResource AccentBtn}" Content="作って取り込む" Padding="14,5" Command="{Binding GenerateCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- AIで音を作る(Audio Studio MCP とつなぐ画面) -->
                <Grid Grid.RowSpan="3" Grid.ColumnSpan="3" Background="#C0101114" Visibility="{Binding Studio.IsOpen, Converter={StaticResource B2V}}">
                    <Border DataContext="{Binding Studio}" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            CornerRadius="12" MaxWidth="860" Margin="20" VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- 見出しと、つながり具合 -->
                            <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="18,14,12,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="🎵 AIで音を作る(Audio Studio MCP)" FontSize="16" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse Width="9" Height="9" Fill="#34C759" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Visibility="{Binding IsConnected, Converter={StaticResource B2V}}"/>
                                            <Ellipse Width="9" Height="9" Fill="#8E8E93" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Visibility="{Binding IsDisconnected, Converter={StaticResource B2V}}"/>
                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" MaxWidth="560"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource AccentBtn}" Content="起動する" Padding="12,4" Margin="0,0,6,0"
                                                ToolTip="設定で指定した audio-studio-mcp.exe を、HTTPのサーバーとして起動してつなぎます(すでに起動していれば、つなぐだけ)"
                                                Command="{Binding StartServerCommand}" Visibility="{Binding IsDisconnected, Converter={StaticResource B2V}}"/>
                                        <Button Style="{StaticResource FilledBtn}" Content="つなぎ直す" Padding="10,4" Margin="0,0,6,0"
                                                ToolTip="自分で起動したサーバーにつなぐ時も、これを押してください" Command="{Binding ConnectCommand}"/>
                                        <Button Style="{StaticResource FilledBtn}" Content="止める" Padding="10,4" Margin="0,0,6,0"
                                                ToolTip="このプラグインが起動したサーバーを止めます" Command="{Binding StopServerCommand}"/>
                                        <Button Style="{StaticResource IconBtn}" Content="&#xE711;" ToolTip="閉じる" Command="{Binding CloseCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="560">
                                <StackPanel Margin="18,14,18,10">
                                    <TextBlock Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                               Visibility="{Binding IsDisconnected, Converter={StaticResource B2V}}"
                                               Text="Audio Studio MCP は、パソコンの中で動く音声生成AI(Stable Audio 3)です。事前に、配布元の手順でインストールしておいてください(Windows は NVIDIA の GPU が必要です)。設定の「YMM4連携」→「AI音声生成」で audio-studio-mcp.exe の場所を指定してから「起動する」を押すと、つながって、ここで音を作れるようになります。"/>
                                    <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource B2V}}">
                                        <!-- ① すること -->
                                        <TextBlock Text="すること" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding Tools}" SelectedItem="{Binding Tool, Mode=TwoWay}" DisplayMemberPath="Label" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding ToolDescription}" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,12"/>

                                        <!-- ② 内容: 「新しく作る」は、わかりやすい画面 -->
                                        <StackPanel Visibility="{Binding IsSimple, Converter={StaticResource B2V}}">
                                            <TextBlock Text="何を作りますか?" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <Border Background="{StaticResource Card}" CornerRadius="10" Padding="4">
                                                <UniformGrid Columns="3">
                                                    <RadioButton GroupName="StudioKind" Cursor="Hand" IsChecked="{Binding KindMusic, Mode=TwoWay}">
                                                    <RadioButton.Template>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="0,9">
                                                                <TextBlock x:Name="tx" Text="🎵 BGM(音楽)" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource Sub}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Text}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg}"/>
                                                                    <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Text}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </RadioButton.Template>
                                                </RadioButton>
                                                    <RadioButton GroupName="StudioKind" Cursor="Hand" IsChecked="{Binding KindInstrument, Mode=TwoWay}">
                                                    <RadioButton.Template>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="0,9">
                                                                <TextBlock x:Name="tx" Text="🎸 楽器ソロ/ループ" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource Sub}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Text}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg}"/>
                                                                    <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Text}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </RadioButton.Template>
                                                </RadioButton>
                                                    <RadioButton GroupName="StudioKind" Cursor="Hand" IsChecked="{Binding KindSfx, Mode=TwoWay}">
                                                    <RadioButton.Template>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="0,9">
                                                                <TextBlock x:Name="tx" Text="💥 効果音" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource Sub}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Text}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg}"/>
                                                                    <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Text}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </RadioButton.Template>
                                                </RadioButton>
                                                </UniformGrid>
                                            </Border>
                                            <TextBlock Text="{Binding KindHint}" Foreground="{StaticResource Sub}" FontSize="11" Margin="2,6,0,14"/>

                                            <TextBlock Text="{Binding PromptLabel}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <TextBox Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalContentAlignment="Top"
                                                     FontSize="14" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="{Binding PromptHint}" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="2,5,0,6"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="例: " Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Top" Margin="2,6,6,0"/>
                                                <ItemsControl ItemsSource="{Binding Examples}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource FilledBtn}" Content="{Binding Label}" Padding="12,5" Margin="0,0,6,6" ToolTip="{Binding Prompt}"
                                                                Command="{Binding DataContext.ExampleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </StackPanel>

                                            <!-- 効果音の細かい指定 -->
                                            <StackPanel Visibility="{Binding ShowSfxFields, Converter={StaticResource B2V}}" Margin="0,8,0,0">
                                                <TextBlock Text="効果音の細かい指定(空欄でもかまいません)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <ItemsControl ItemsSource="{Binding SfxFields}" ItemTemplate="{StaticResource McpFieldTpl}"/>
                                            </StackPanel>

                                            <!-- 長さ -->
                                            <StackPanel Visibility="{Binding HasDuration, Converter={StaticResource B2V}}" Margin="0,12,0,0">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="長さ" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding DurationPresets}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource FilledBtn}" Content="{Binding Label}" Padding="12,5" Margin="0,0,6,6" ToolTip="{Binding Prompt}"
                                                                Command="{Binding DataContext.DurationPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                                <Slider Style="{StaticResource Seek}" Minimum="1" Maximum="{Binding DurationMax}" IsMoveToPointEnabled="True" Margin="0,2,0,0"
                                                        Value="{Binding Duration, Mode=TwoWay}" IsEnabled="{Binding ManualDuration}"
                                                        ToolTip="「おまかせ」以外を押すと、スライダーで決められます"/>
                                            </StackPanel>

                                            <!-- テンポ -->
                                            <StackPanel Visibility="{Binding ShowBpm, Converter={StaticResource B2V}}" Margin="0,14,0,0">
                                                <Grid Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="テンポ" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <CheckBox Style="{StaticResource Check}" Content="自動" Margin="12,0,0,0" IsChecked="{Binding AutoBpm}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding BpmText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider Style="{StaticResource Seek}" Minimum="40" Maximum="220" IsMoveToPointEnabled="True"
                                                        Value="{Binding Bpm, Mode=TwoWay}" IsEnabled="{Binding ManualBpm}" ToolTip="遅い ← → 速い(「自動」を外すと決められます)"/>
                                                <Grid Margin="2,2,2,0">
                                                    <TextBlock Text="ゆっくり" Foreground="{StaticResource Sub}" FontSize="10"/>
                                                    <TextBlock Text="ふつう" Foreground="{StaticResource Sub}" FontSize="10" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="速い" Foreground="{StaticResource Sub}" FontSize="10" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- 候補の数 -->
                                            <StackPanel Visibility="{Binding HasVariations, Converter={StaticResource B2V}}" Margin="0,14,0,0">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="候補の数(一度に何パターン作るか)" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding VariationsText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider Style="{StaticResource Seek}" Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                                        Value="{Binding Variations, Mode=TwoWay}" ToolTip="多いほど選べますが、時間がかかります"/>
                                            </StackPanel>

                                            <Expander Header="詳細設定(シードなど)" Foreground="{StaticResource Text}" Margin="0,14,0,0">
                                                <ItemsControl ItemsSource="{Binding AdvancedFields}" ItemTemplate="{StaticResource McpFieldTpl}" Margin="0,8,0,0"/>
                                            </Expander>
                                        </StackPanel>

                                        <!-- ② 内容: そのほかの作業は、サーバーが教えてくれた入力欄をそのまま並べる -->
                                        <StackPanel Visibility="{Binding IsGeneric, Converter={StaticResource B2V}}">
                                            <TextBlock Text="② 内容" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Tool.Fields}" ItemTemplate="{StaticResource McpFieldTpl}"/>
                                        </StackPanel>

                                        <!-- ③ 結果 -->
                                        <TextBlock Text="結果" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                        <TextBlock Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Text="できた音は、素材データベースのいま選んでいるフォルダーに取り込まれ、タグと、指示の内容(メモ)が付きます。一覧でダブルクリックすると、その場で聞けます。"/>
                                        <TextBox Style="{StaticResource Field}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                                                 FontSize="11" Text="{Binding ResultText, Mode=OneWay}"/>
                                    </StackPanel>
                                    <Expander Header="サーバーの記録" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,10,0,0">
                                        <TextBox Style="{StaticResource Field}" IsReadOnly="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas" FontSize="10" Text="{Binding Log, Mode=OneWay}"/>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="18,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource FilledBtn}" Content="出力フォルダー" Padding="10,6" Margin="0,0,6,0" Command="{Binding OpenOutputCommand}"/>
                                        <Button Style="{StaticResource FilledBtn}" Content="Web画面を開く" Padding="10,6"
                                                ToolTip="サーバーを「Web画面も出す」で起動した時に使えます" Command="{Binding OpenWebUiCommand}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0"
                                                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
                                        <TextBlock Text="処理中… " Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ElapsedText}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Style="{StaticResource FilledBtn}" Content="取りやめ" Padding="10,6" Command="{Binding CancelCommand}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource AccentBtn}" Content="{Binding RunText}" Padding="22,8" FontWeight="SemiBold" Command="{Binding RunCommand}"/>
                                </Grid>
                            </Border>

                            <!-- 生成中の画面(経過時間・GPUの使用率) -->
                            <Border Grid.RowSpan="3" Background="{StaticResource Panel}" CornerRadius="12"
                                    Visibility="{Binding IsGenerating, Converter={StaticResource B2V}}">
                                <StackPanel VerticalAlignment="Center" Margin="40,30">
                                    <TextBlock Text="{Binding GeneratingTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding GeneratingDetail}" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Center" Margin="0,6,0,18" MaxWidth="560"/>
                                    <ProgressBar IsIndeterminate="True" Height="4" Margin="40,0,40,18" Foreground="{StaticResource Accent}" Background="{StaticResource Card}" BorderThickness="0"/>
                                    <TextBlock Text="{Binding ElapsedClock}" FontSize="48" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                    <TextBlock Text="生成を始めてからの時間" Foreground="{StaticResource Sub}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,22"/>

                                    <Border Background="{StaticResource Card}" CornerRadius="10" Padding="16,12" MaxWidth="520">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="GPU" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding GpuName}" Foreground="{StaticResource Sub}" FontSize="11" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                            </Grid>
                                            <Grid Visibility="{Binding HasGpu, Converter={StaticResource B2V}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,3">
                                                        <TextBlock Text="使用率" Foreground="{StaticResource Sub}" FontSize="11"/>
                                                        <TextBlock Text="{Binding GpuUsageText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding GpuUsage, Mode=OneWay}" Margin="0,0,0,10"
                                                                 Foreground="#34C759" Background="{StaticResource Bg}" BorderThickness="0"/>
                                                    <Grid Margin="0,0,0,3">
                                                        <TextBlock Text="GPUメモリ(VRAM)" Foreground="{StaticResource Sub}" FontSize="11"/>
                                                        <TextBlock Text="{Binding GpuMemText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding GpuMemPercent, Mode=OneWay}"
                                                                 Foreground="{StaticResource Accent}" Background="{StaticResource Bg}" BorderThickness="0"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{StaticResource Bg}" CornerRadius="6" Padding="4" ToolTip="使用率の移り変わり(最近の1分)">
                                                    <Viewbox Stretch="Fill">
                                                        <Canvas Width="120" Height="40">
                                                            <Polyline Points="{Binding GpuGraph}" Stroke="#34C759" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="作り終わると、聴き比べて取り込むものを選べます。この間も、YMM4やほかのタブは使えます" Foreground="{StaticResource Sub}" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,16,0,12"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="取りやめ" Padding="20,7" HorizontalAlignment="Center" Command="{Binding CancelCommand}"/>
                                </StackPanel>
                            </Border>

                            <!-- 生成後: 候補を聴き比べて、取り込むものを選ぶ画面 -->
                            <Border Grid.RowSpan="3" Background="{StaticResource Panel}" CornerRadius="12"
                                    Visibility="{Binding IsPicking, Converter={StaticResource B2V}}">
                                <Grid Margin="22,18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding PickTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,40,0"/>
                                            <TextBlock Text="{Binding GeneratingDetail}" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,4,40,12"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource IconBtn}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                ToolTip="閉じる(取り込んでいない候補のファイルは、出力フォルダーに残ります)" Command="{Binding ClosePickCommand}"/>
                                    </Grid>
                                    <ScrollViewer local:WheelFix.Enabled="True" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Candidates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource Card}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Style="{StaticResource AccentBtn}" Content="{Binding PlayText}" Width="86" Padding="8,8" VerticalAlignment="Center"
                                                                    Command="{Binding DataContext.PlayCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                            <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                                                <Grid Margin="0,0,0,4">
                                                                    <TextBlock>
                                                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                        <Run Text="  "/>
                                                                        <Run Text="{Binding DurationText, Mode=OneWay}" Foreground="{StaticResource Sub}"/>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Sub}" FontSize="11" HorizontalAlignment="Right"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="260" ToolTip="{Binding Path}"/>
                                                                </Grid>
                                                                <Grid Height="48">
                                                                    <Border Background="{StaticResource Bg}" CornerRadius="6"/>
                                                                    <Viewbox Stretch="Fill">
                                                                        <Canvas Width="300" Height="48">
                                                                            <Polygon Points="{Binding Wave}" Fill="{StaticResource Accent}" Opacity="0.75"/>
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="3" VerticalAlignment="Bottom"
                                                                                 Foreground="#34C759" Background="Transparent" BorderThickness="0"/>
                                                                </Grid>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource AccentBtn}" Content="{Binding AddText}" Padding="12,6" Margin="0,0,0,6"
                                                                        Command="{Binding DataContext.AddCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <Button Style="{StaticResource IconBtn}" Content="&#xE838;" Width="32" Height="30" ToolTip="エクスプローラーで場所を開く"
                                                                            Command="{Binding DataContext.ShowCandidateFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                                    <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="32" Height="30" Margin="4,0,0,0" ToolTip="この候補を削除(ファイルをごみ箱へ)"
                                                                            Command="{Binding DataContext.DeleteCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource FilledBtn}" Content="↻ 同じ設定で作り直す" Padding="12,7" Command="{Binding RegenerateCommand}"
                                                    ToolTip="今の候補は残したまま、同じ指示・長さでもう一度作ります"/>
                                            <Button Style="{StaticResource FilledBtn}" Content="すべて取り込む" Padding="12,7" Margin="8,0,0,0" Command="{Binding AddAllCandidatesCommand}"/>
                                            <Button Style="{StaticResource AccentBtn}" Content="完了" Padding="18,7" Margin="8,0,0,0" Command="{Binding ClosePickCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
                <!-- 大きなプレビュー(ダブルクリックで開く、プラグイン内のビューアー) -->
                <Grid Grid.RowSpan="3" Grid.ColumnSpan="3" Background="#F4101114"
                      Visibility="{Binding ViewerOpen, Converter={StaticResource B2V}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="16,10,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ViewerTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Foreground="{StaticResource Sub}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                <Run Text="{Binding ViewerPositionText, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding ViewerInfo, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource FilledBtn}" Content="既定のアプリで開く" Padding="10,4" Margin="0,0,8,0" Command="{Binding OpenCommand}"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE711;" ToolTip="閉じる (Esc)" Command="{Binding ViewerCloseCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="ViewerStage" Grid.Row="1" Background="Transparent" ClipToBounds="True" Margin="56,0"
                            MouseWheel="ViewerStage_MouseWheel" local:WheelFix.OwnsWheel="True" MouseLeftButtonDown="ViewerStage_MouseLeftButtonDown"
                            MouseMove="ViewerStage_MouseMove" MouseLeftButtonUp="ViewerStage_MouseLeftButtonUp">
                        <Grid>
                            <MediaElement x:Name="ViewerPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                          ScrubbingEnabled="True" Stretch="Uniform" Volume="0.8"
                                          Visibility="{Binding ViewerShowMedia, Converter={StaticResource B2V}}"/>
                            <Image x:Name="ViewerImage" Source="{Binding ViewerImage}" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding ViewerShowImage, Converter={StaticResource B2V}}">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="ViewerScale"/>
                                        <TranslateTransform x:Name="ViewerShift"/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                            <TextBox Text="{Binding ViewerText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas, MS Gothic" FontSize="13" Padding="14" BorderThickness="0"
                                     Background="#16171A" Foreground="{StaticResource Text}" CaretBrush="{StaticResource Text}"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Visibility="{Binding ViewerShowText, Converter={StaticResource B2V}}"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding ViewerShowOther, Converter={StaticResource B2V}}">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7C3;" FontSize="64" Foreground="{StaticResource Sub}" HorizontalAlignment="Center"/>
                                <TextBlock Text="この種類のファイルは、ここではプレビューできません" Foreground="{StaticResource Sub}" Margin="0,14,0,10" HorizontalAlignment="Center"/>
                                <Button Style="{StaticResource FilledBtn}" Content="既定のアプリで開く" HorizontalAlignment="Center" Command="{Binding OpenCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Grid.Row="1" Style="{StaticResource IconBtn}" Content="&#xE76B;" Width="40" Height="64" HorizontalAlignment="Left" Margin="8,0,0,0"
                            ToolTip="前の素材 (←)" Command="{Binding ViewerPrevCommand}"/>
                    <Button Grid.Row="1" Style="{StaticResource IconBtn}" Content="&#xE76C;" Width="40" Height="64" HorizontalAlignment="Right" Margin="0,0,8,0"
                            ToolTip="次の素材 (→)" Command="{Binding ViewerNextCommand}"/>

                    <StackPanel Grid.Row="2" Margin="16,8,16,12">
                        <Grid Visibility="{Binding ViewerShowMedia, Converter={StaticResource B2V}}" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ViewerPlayBtn" Style="{StaticResource IconBtn}" Content="&#xE768;" ToolTip="再生 / 一時停止 (Space)"/>
                            <Slider x:Name="ViewerSeek" Grid.Column="1" Style="{StaticResource Seek}" Margin="10,0"
                                    Minimum="0" Maximum="1" VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
                            <TextBlock x:Name="ViewerTime" Grid.Column="2" Foreground="{StaticResource Sub}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource Glyph}" Text="&#xE767;" Foreground="{StaticResource Sub}" Margin="0,0,6,0"/>
                            <Slider Grid.Column="4" Width="90" Minimum="0" Maximum="1" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                    ToolTip="音量" Value="{Binding Volume, ElementName=ViewerPlayer, Mode=TwoWay}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6"
                                    Visibility="{Binding ViewerShowPdfNav, Converter={StaticResource B2V}}">
                            <Button Style="{StaticResource IconBtn}" Content="&#xE76B;" ToolTip="前のページ (PageUp)" Command="{Binding ViewerPagePrevCommand}"/>
                            <TextBlock Text="{Binding ViewerPageText}" VerticalAlignment="Center" Margin="14,0"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE76C;" ToolTip="次のページ (PageDown)" Command="{Binding ViewerPageNextCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ViewerHint}" Foreground="{StaticResource Sub}" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== アイテムタブ(選択中のアイテムを編集) ===== -->
        <Grid Grid.Row="1" Background="{StaticResource Bg}" Visibility="{Binding ShowItemView, Converter={StaticResource B2V}}">
            <Grid x:Name="ItemViewRoot" DataContext="{Binding ItemEditor}">
                <Grid.Resources>
                    <CollectionViewSource x:Key="ItemGroupsCvs" Source="{Binding Groups}"/>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 上: いま選んでいるアイテム・検索 -->
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="14,10,14,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasItem, Converter={StaticResource B2V}}"/>
                                <TextBlock Text="アイテムが選ばれていません" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Sub}"
                                           Visibility="{Binding HasNoItem, Converter={StaticResource B2V}}"/>
                                <TextBlock Text="{Binding SubText}" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBox Style="{StaticResource Field}" Width="190" Tag="項目を検索(例: 拡大、色)"
                                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Style="{StaticResource AccentBtn}" Content="✂ テキストを分割" Padding="10,4" Margin="8,0,0,0"
                                        ToolTip="選択中のテキストを、好きな位置で複数のアイテムに分けます"
                                        Command="{Binding DataContext.TextSplit.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding HasText, Converter={StaticResource B2V}}"/>
                                <ToggleButton Style="{StaticResource PillToggle}" Content="ダブルクリックで開く" Margin="8,0,0,0"
                                              ToolTip="オンにすると、YMM4のタイムラインでアイテムをダブルクリックした時に、YMM4標準のアイテム編集ではなく、このアイテムタブが開きます"
                                              IsChecked="{Binding OpenOnDoubleClick, Mode=TwoWay}"/>
                                <ToggleButton Style="{StaticResource PillToggle}" Content="レイアウトを編集" Margin="8,0,0,0"
                                              ToolTip="カードの並べ替え・非表示・列の幅を変えられます" IsChecked="{Binding LayoutEdit, Mode=TwoWay}"/>
                                <Button Style="{StaticResource FilledBtn}" Content="すべて開く" Padding="10,4" Margin="8,0,0,0" Command="{Binding OpenAllCommand}"/>
                                <Button Style="{StaticResource FilledBtn}" Content="すべて閉じる" Padding="10,4" Margin="6,0,0,0" Command="{Binding CloseAllCommand}"/>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" Margin="6,0,0,0" ToolTip="読み込み直す" Command="{Binding ReloadCommand}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <!-- レイアウトの編集 -->
                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,8,0,0"
                                Visibility="{Binding LayoutEdit, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="1列の最小の幅" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                    <Slider Style="{StaticResource Seek}" Width="220" Minimum="260" Maximum="900" VerticalAlignment="Center" Margin="0,0,8,4" IsMoveToPointEnabled="True"
                                            Value="{Binding ColumnWidth, Mode=TwoWay}" ToolTip="小さくすると列が増え、大きくすると列が減ります"/>
                                    <TextBlock Text="{Binding ColumnWidthText}" VerticalAlignment="Center" Margin="0,0,16,4"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="最初の状態に戻す" Padding="10,3" Margin="0,0,0,4" Command="{Binding ResetLayoutCommand}"/>
                                </WrapPanel>
                                <TextBlock Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="各カードの見出しに出る ◀ ▶ で並べ替え、「非表示にする」で隠せます(隠したカードは、編集中だけ薄く出ます)。「よく使う項目」は、項目の「…」または右クリックから出し入れできます。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="1" Foreground="{StaticResource Sub}" TextAlignment="Center" LineHeight="24" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"
                           Text="YMM4のタイムラインでアイテムを選ぶと、ここで編集できます&#x0A;拡大率・位置・テキスト・色・エフェクトなどを、スライダーや入力欄で変えられます&#x0A;複数のアイテムを選ぶと、同じ項目をまとめて変えられます"
                           Visibility="{Binding HasNoItem, Converter={StaticResource B2V}}"/>

                <ScrollViewer local:WheelFix.Enabled="True" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasItem, Converter={StaticResource B2V}}">
                    <StackPanel Margin="14,12,14,24">
                        <!-- 図形の配置(演出図形ごとの専用の画面: プレビューの上のつまみで、発射位置・着弾地点・大きさなどを動かす) -->
                        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="16,12,16,12" Margin="0,0,0,12"
                                BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                Visibility="{Binding HasShapeStage, Converter={StaticResource B2V}}">
                            <StackPanel DataContext="{Binding ShapeStage}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="配置"/><Run Text=" ― " Foreground="{StaticResource Sub}"/><Run Text="{Binding Title, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding HelpText}" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0">
                                        <ToggleButton Style="{StaticResource PillToggle}" Content="プレビューを自動で写す" Margin="0,0,6,4"
                                                      ToolTip="オンにすると、値や再生位置が変わるたびに、YMM4のプレビューをこの画面の背景へ写します(重い時はオフにして、右のボタンで写せます)"
                                                      IsChecked="{Binding AutoPreview, Mode=TwoWay}"/>
                                        <Button Style="{StaticResource FilledBtn}" Content="いま写す" Padding="10,3" Margin="0,0,6,4"
                                                ToolTip="いまYMM4のプレビューに映っている画面を、背景に写します" Command="{Binding CaptureCommand}"/>
                                        <ToggleButton Style="{StaticResource PillToggle}" Content="吸着" Margin="0,0,0,4"
                                                      ToolTip="オンにすると、位置は5%、角度は15°、長さは10pxごとに止まります(Shift を押している間は、逆になります)"
                                                      IsChecked="{Binding Snap, Mode=TwoWay}"/>
                                    </WrapPanel>
                                </Grid>
                                <!-- 移動している時: どの点(始点・中間点・終点)を動かすか -->
                                <WrapPanel Margin="0,0,0,8" Visibility="{Binding HasPointChips, Converter={StaticResource B2V}}">
                                    <TextBlock Text="動かす点" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ItemsControl ItemsSource="{Binding PointChips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource PillToggle}" Content="{Binding Label}" Margin="0,0,6,4"
                                                              IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding Command}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" MinWidth="320"/>
                                        <ColumnDefinition Width="2*" MinWidth="300"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <local:ShapeStageView Height="380" Stage="{Binding}" Version="{Binding Version}"/>
                                        <!-- つまみの色の見本 -->
                                        <ItemsControl ItemsSource="{Binding Legend}" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,2">
                                                        <Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <!-- この図形の項目(つまみと同じ項目を、数値でも変えられる) -->
                                    <ScrollViewer Grid.Column="1" MaxHeight="420" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto"
                                                  Visibility="{Binding HasRows, Converter={StaticResource B2V}}">
                                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ItemPropRowTpl}"/>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- すべてのカード(よく使う項目・エフェクト・各グループ)を、1つのパネルに並べる。列のあいだに、空きができない -->
                        <ItemsControl>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:StretchColumnsPanel MinColumnWidth="{Binding DataContext.ColumnWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="16,8,16,8" Margin="0,0,0,12" Opacity="{Binding CardOpacity}"
                                            Visibility="{Binding HasVisible, Converter={StaticResource B2V}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding LayoutEdit, Converter={StaticResource B2V}}">
                                                <Button Style="{StaticResource FilledBtn}" Content="◀ 前へ" Padding="8,2" FontSize="11" Margin="0,0,5,0" Command="{Binding MoveUpCommand}"/>
                                                <Button Style="{StaticResource FilledBtn}" Content="後ろへ ▶" Padding="8,2" FontSize="11" Margin="0,0,5,0" Command="{Binding MoveDownCommand}"/>
                                                <Button Style="{StaticResource FilledBtn}" Content="{Binding HideText}" Padding="8,2" FontSize="11" Command="{Binding ToggleHiddenCommand}"/>
                                            </StackPanel>
                                            <ToggleButton IsChecked="{Binding IsOpen, Mode=TwoWay}" Cursor="Hand" ToolTip="クリックで開く・閉じる">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent" Padding="0,5">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                                                <TextBlock x:Name="arrow" Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="11"
                                                                           Foreground="{StaticResource Sub}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="arrow" Property="Text" Value="&#xE70E;"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ItemPropRowTpl}" Margin="0,4,0,4"
                                                          Visibility="{Binding IsOpen, Converter={StaticResource B2V}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsSource>
                                <CompositeCollection>


                        <!-- よく使う項目 -->
                        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="16,12,16,10" Margin="0,0,0,12"
                                BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                Visibility="{Binding HasQuick, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <TextBlock Text="よく使う項目" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding QuickRows}" ItemTemplate="{StaticResource ItemPropRowTpl}"/>
                            </StackPanel>
                        </Border>

                        <!-- 映像エフェクト -->
                        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="16,12,16,8" Margin="0,0,0,12"
                                Visibility="{Binding HasVideoEffectList, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{Binding VideoEffectHeader}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ToggleButton Style="{StaticResource PillToggle}" Content="＋ エフェクトを追加" HorizontalAlignment="Right" Margin="0"
                                                  IsChecked="{Binding VideoPicker.IsOpen, Mode=TwoWay}"/>
                                </Grid>
                                <ContentControl Content="{Binding VideoPicker}" ContentTemplate="{StaticResource EffectPickerTpl}" Focusable="False"/>
                                <ItemsControl ItemsSource="{Binding VideoEffects}" ItemTemplate="{StaticResource ItemEffectCardTpl}"/>
                            </StackPanel>
                        </Border>

                        <!-- 音声エフェクト -->
                        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="16,12,16,8" Margin="0,0,0,12"
                                Visibility="{Binding HasAudioEffectList, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{Binding AudioEffectHeader}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ToggleButton Style="{StaticResource PillToggle}" Content="＋ エフェクトを追加" HorizontalAlignment="Right" Margin="0"
                                                  IsChecked="{Binding AudioPicker.IsOpen, Mode=TwoWay}"/>
                                </Grid>
                                <ContentControl Content="{Binding AudioPicker}" ContentTemplate="{StaticResource EffectPickerTpl}" Focusable="False"/>
                                <ItemsControl ItemsSource="{Binding AudioEffects}" ItemTemplate="{StaticResource ItemEffectCardTpl}"/>
                            </StackPanel>
                        </Border>

                                    <CollectionContainer Collection="{Binding Source={StaticResource ItemGroupsCvs}}"/>
                                </CompositeCollection>
                            </ItemsControl.ItemsSource>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- グラフを大きく開いた画面(タブいっぱい) -->
                <Grid Grid.RowSpan="2" Background="{StaticResource Bg}" Visibility="{Binding GraphOpen, Converter={StaticResource B2V}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="16,10,12,8">
                        <StackPanel>
                            <TextBlock Text="{Binding GraphTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Foreground="{StaticResource Sub}" FontSize="11" Margin="0,2,0,6" TextWrapping="Wrap"
                                       Text="{Binding GraphRow.GraphModeHint, StringFormat='左がアイテムの始まり、右が終わり。{0} / Esc で閉じる'}"/>
                            <WrapPanel DataContext="{Binding GraphRow}">
                                <ToggleButton Style="{StaticResource PillToggle}" Content="点を動かす" Margin="0,0,6,0" Padding="12,3"
                                              ToolTip="ふつうのモード: 点を上下にドラッグ・線の上をドラッグで中間点を追加" IsChecked="{Binding GraphModeNormal, Mode=TwoWay}"/>
                                <ToggleButton Style="{StaticResource PillToggle}" Content="✎ 手書き" Margin="0,0,6,0" Padding="12,3"
                                              ToolTip="グラフの上をマウスでなぞると、その形がそのまま動きになります" IsChecked="{Binding GraphModeDraw, Mode=TwoWay}"/>
                                <ToggleButton Style="{StaticResource PillToggle}" Content="⇔ 中間点を横にも動かす" Margin="0,0,6,0" Padding="12,3"
                                              ToolTip="中間点を左右(いつ)にもドラッグできます。Shift を押しながらで、左右だけ" IsChecked="{Binding GraphModeSlide, Mode=TwoWay}"/>
                            </WrapPanel>
                        </StackPanel>
                        <Button Style="{StaticResource IconBtn}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top"
                                ToolTip="閉じる (Esc)" Command="{Binding CloseGraphCommand}"/>
                    </Grid>
                    <local:AnimGraph Grid.Row="1" Margin="16,0,16,10" Row="{Binding GraphRow}" Version="{Binding GraphRow.GraphVersion}" Mode="{Binding GraphRow.GraphMode}"/>
                    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="16,10,16,10">
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Expander Header="動かし方を変える(直線・加減速・緩急・行き過ぎて戻る など)" IsExpanded="True" Foreground="{StaticResource Text}" Margin="0,0,0,8">
                                    <ContentControl Content="{Binding GraphRow}" ContentTemplate="{StaticResource AnimTypeChooserTpl}" Focusable="False" Margin="0,8,0,0"/>
                                </Expander>
                                <TextBlock Text="値を決める" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding GraphRow.AnimPoints}" ItemTemplate="{StaticResource AnimPointRowTpl}"/>
                                <WrapPanel DataContext="{Binding GraphRow}">
                                    <Button Style="{StaticResource FilledBtn}" Content="⇄ 始点と終点を入れ替え" Padding="10,3" FontSize="11" Margin="0,0,6,0" Command="{Binding SwapPointsCommand}"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="＋ 中間点を追加" Padding="10,3" FontSize="11" Margin="0,0,6,0" Command="{Binding AddPointCommand}"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="− 中間点を削除" Padding="10,3" FontSize="11" Command="{Binding RemovePointCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== ショートカットのタブ ===== -->
        <Grid Grid.Row="1" Background="{StaticResource Bg}" Visibility="{Binding ShowShortcutView, Converter={StaticResource B2V}}">
            <ScrollViewer local:WheelFix.Enabled="True" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,12,14,24">
                    <!-- キーの置き換え -->
                    <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="キーの置き換え(YMM4のショートカットを、好きなキーに変える)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource AccentBtn}" Content="＋ 追加" Padding="14,5" HorizontalAlignment="Right" Command="{Binding AddRemapCommand}"/>
                            </Grid>
                            <TextBlock Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="「押すキー」を押した時に、YMM4へ「YMM4に送るキー」を押したことにして伝えます。YMM4の設定で変えられるショートカットも、変えられないショートカット(再生の Space、元に戻すの Ctrl+Z など)も、同じやり方で好きなキーに変えられます。例: 「押すキー」に F1、「YMM4に送るキー」に Space を入れると、F1 で再生・停止できます。「YMM4に送るキー」を空のままにすると、そのキーを押しても何も起きなくなります(無効化)。どちらの欄も、クリックしてから実際にキーを押すと記録されます(Ctrl・Shift・Alt との組み合わせも使えます)。"/>
                            <TextBlock Text="まだ置き換えがありません。「＋ 追加」から作れます" Foreground="{StaticResource Sub}" Margin="0,4,0,4"
                                       Visibility="{Binding HasNoRemaps, Converter={StaticResource B2V}}"/>
                            <ItemsControl ItemsSource="{Binding RemapRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Card}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource Check}" VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="{Binding Enabled, Mode=TwoWay}" ToolTip="この置き換えのオン・オフ"/>
                                                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Tag="名前(例: 再生・停止)" MaxLength="40"
                                                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                                                    <TextBlock Grid.Column="2" Text="押すキー" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                                    <local:KeyRecorder Grid.Column="3" Style="{StaticResource Field}" Keys="{Binding From, Mode=TwoWay}"
                                                                       ToolTip="クリックして、実際にキーを押してください(Delete: 消す)"/>
                                                    <TextBlock Grid.Column="4" Text="→ YMM4に送るキー" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                                    <local:KeyRecorder Grid.Column="5" Style="{StaticResource Field}" Keys="{Binding To, Mode=TwoWay}"
                                                                       ToolTip="クリックして、YMM4で使われているキーを押してください(空のままなら、押すキーを無効にします)"/>
                                                    <Button Grid.Column="6" Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="32" Height="32" Margin="8,0,0,0" ToolTip="この置き換えを削除"
                                                            Command="{Binding DataContext.RemoveRemapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding StateText}" Foreground="{StaticResource Accent}" FontSize="11" Margin="2,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- このツール自体の操作(タブの移動など)のショートカット -->
                    <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="このツールの操作(タブの移動など)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="「エクスプローラー2を開く」「次のタブへ」「設定を開く」などに、キーを割り当てられます。右の欄をクリックしてキーを押し、すべてのキーを離すと決まります(Ctrl+Shift+A+S のように、キーは何個でも同時押しで組み合わせられます)。ゴミ箱のボタンで削除できます。"/>
                            <TextBlock Text="実行するウィンドウ" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding ActionScopeChoices}" Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource PillToggle}" GroupName="ActionScope" Margin="0,0,6,6"
                                                     Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ActionScopeText}" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding ActionShortcutGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,0,0,6" IsExpanded="False">
                                            <Expander.Header>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Rows}" Margin="4,8,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="240"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Note}" Foreground="{StaticResource Sub}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Note}" Visibility="{Binding HasNote, Converter={StaticResource B2V}}"/>
                                                            </StackPanel>
                                                            <local:KeyRecorder Grid.Column="1" Style="{StaticResource Field}" Keys="{Binding Keys, Mode=TwoWay}"
                                                                               ToolTip="クリックして、実際にキーを押してください(何個でも同時押しOK・すべて離すと決定)"/>
                                                            <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="32" Height="32" Margin="6,0,0,0"
                                                                    ToolTip="このショートカットを削除" IsEnabled="{Binding HasKeys}"
                                                                    Command="{Binding DataContext.ClearActionShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 素材・プリセットなどに付けたショートカット -->
                    <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="このツールのショートカット(ファイル・プリセット・図形・エフェクト・テキスト)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="各タブでアイテムを選び、「ショートカットキー」欄をクリックしてキーを押すと、割り当てられます。ここでは、割り当て済みの一覧を確認し、キーの付け直しや解除ができます。Ctrl+1 や Ctrl+Shift+A のような組み合わせも使えます。押すと、どのタブを開いていても実行されます。YMM4自身のショートカットと同じキーにした場合は、こちらが優先されます。"/>
                            <TextBlock Text="まだ割り当てがありません" Foreground="{StaticResource Sub}" Margin="0,4,0,4"
                                       Visibility="{Binding HasNoShortcuts, Converter={StaticResource B2V}}"/>
                            <ItemsControl ItemsSource="{Binding ShortcutRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding KindText}" Foreground="{StaticResource Sub}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding KindText}"/>
                                            </StackPanel>
                                            <local:KeyRecorder Grid.Column="1" Style="{StaticResource Field}" Keys="{Binding Keys, Mode=TwoWay}"
                                                               ToolTip="クリックして、実際にキーを押すと付け直せます(Delete: 解除)"/>
                                            <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE74D;" Width="32" Height="32" Margin="6,0,0,0"
                                                    ToolTip="この割り当てを解除"
                                                    Command="{Binding DataContext.DeleteShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== AIエディット(AIに、タイムラインとプレビューを見せて、編集の相談をする) ===== -->
        <Grid Grid.Row="1" Background="{StaticResource Bg}" DataContext="{Binding AiEdit}"
              Visibility="{Binding DataContext.ShowAiEditView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource B2V}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 上: AIの選択 -->
            <Border Background="{StaticResource Panel}" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✦ AIエディット" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <ComboBox MinWidth="210" ItemsSource="{Binding Providers}" SelectedIndex="{Binding ProviderIndex, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <ComboBox IsEditable="True" MinWidth="200" Margin="8,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding ModelChoices}"
                                  Text="{Binding Model, UpdateSourceTrigger=LostFocus}"
                                  ToolTip="使うモデル。▼ で選ぶか、名前を直接入力できます(APIキーがあれば、使えるモデルの一覧を自動で読み込みます)"/>
                        <TextBlock Text="{Binding ModelBadge}" ToolTip="{Binding ModelNote}" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Visibility="{Binding HasModelNote, Converter={StaticResource B2V}}"/>
                        <CheckBox Style="{StaticResource Check}" Content="🌐 ネット検索" IsChecked="{Binding WebOn}" VerticalAlignment="Center" Margin="14,0,0,0"
                                  Visibility="{Binding IsLocalStudio, Converter={StaticResource B2V}}"
                                  ToolTip="オンにすると、Local AI Studio が必要な時にインターネットを検索して、ページを読んだ結果を AI に渡します(最新の情報・使い方・URL の中身など)"/>
                        <CheckBox Style="{StaticResource Check}" Content="操作の提案" IsChecked="{Binding ProposalsOn}" VerticalAlignment="Center" Margin="14,0,0,0"
                                  ToolTip="オンにすると、AI がエフェクトの追加や値の変更を具体的に提案します。実行されるのは、「提案」であなたが OK したものだけです"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource PillToggle}" GroupName="AiPane" Content="💬 会話" Margin="0,0,4,0"
                                     IsChecked="{Binding Pane, Converter={StaticResource Eq}, ConverterParameter=0}"/>
                        <RadioButton Style="{StaticResource PillToggle}" GroupName="AiPane" Content="{Binding ProposalTabText}" Margin="0,0,4,0"
                                     IsChecked="{Binding Pane, Converter={StaticResource Eq}, ConverterParameter=1}"/>
                        <RadioButton Style="{StaticResource PillToggle}" GroupName="AiPane" Content="変更ログ" Margin="0,0,4,0"
                                     IsChecked="{Binding Pane, Converter={StaticResource Eq}, ConverterParameter=2}"/>
                        <RadioButton Style="{StaticResource PillToggle}" GroupName="AiPane" Content="会話の履歴" Margin="0,0,14,0"
                                     ToolTip="これまでの会話(YMM4専用ストレージの「AI会話」に保存)を開いて、続きから話せます"
                                     IsChecked="{Binding Pane, Converter={StaticResource Eq}, ConverterParameter=3}"/>
                        <Button Style="{StaticResource FilledBtn}" Content="新しい会話" Padding="12,5" Margin="0,0,6,0" Command="{Binding NewChatCommand}"/>
                        <ToggleButton Style="{StaticResource PillToggle}" Content="⚙ 設定" IsChecked="{Binding ShowSettings, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 設定(APIキー・モデル・送る内容) -->
            <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,1" Padding="16,12"
                    Visibility="{Binding ShowSettings, Converter={StaticResource B2V}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="APIキー" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <PasswordBox x:Name="AiKeyBox" Padding="8,6" Background="{StaticResource Card}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Stroke}"
                                         CaretBrush="{StaticResource Text}" ToolTip="{Binding KeyHint}"/>
                            <Button Grid.Column="1" Style="{StaticResource AccentBtn}" Content="保存" Padding="12,5" Margin="6,0,0,0" Click="AiSaveKey_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource FilledBtn}" Content="キーを取得" Padding="10,5" Margin="6,0,0,0" Command="{Binding OpenKeyPageCommand}"
                                    Visibility="{Binding HasKeyPage, Converter={StaticResource B2V}}"/>
                        </Grid>
                        <TextBlock Text="{Binding KeyState}" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,0,0,8"/>
                        <TextBlock Text="モデル名" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox IsEditable="True" ItemsSource="{Binding ModelChoices}" Text="{Binding Model, UpdateSourceTrigger=LostFocus}"
                                      ToolTip="使うモデルの名前。▼ で選ぶか、直接入力できます"/>
                            <Button Grid.Column="1" Style="{StaticResource FilledBtn}" Content="一覧を取得" Padding="10,5" Margin="6,0,0,0" Command="{Binding FetchModelsCommand}"
                                    ToolTip="APIキーを保存してから押すと、いま使えるモデルの一覧を読み込みます"/>
                        </Grid>
                        <StackPanel Visibility="{Binding IsLocalStudio, Converter={StaticResource B2V}}" Margin="0,0,0,8">
                            <TextBlock Text="{Binding ModelNote}" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="このPCの中で動く AI です(APIキーは要りません。画像は Gemma 3 など画像を見られるモデルで読めます)。使う前に「Local AI Studio を開く」で起動してください。モデルのインストールは Local AI Studio の「モデルの管理」で。"
                                       Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Button Style="{StaticResource FilledBtn}" Content="Local AI Studio を開く" Padding="10,5" HorizontalAlignment="Left" Command="{Binding OpenLocalStudioCommand}"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsCompatible, Converter={StaticResource B2V}}">
                            <TextBlock Text="URL(OpenAI 互換の API。例: Ollama は http://localhost:11434/v1)" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding BaseUrl, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="AIに一緒に送るもの" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,6"/>
                        <CheckBox Style="{StaticResource Check}" Content="タイムライン(すべてのシーンのアイテム・文字・位置・エフェクト・選択中のアイテム・キャラクター)" IsChecked="{Binding SendTimeline}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding DetailModes}" SelectedIndex="{Binding Detail, Mode=TwoWay}" MinWidth="240" HorizontalAlignment="Left" Margin="0,0,0,8"
                                  ToolTip="「詳しく」にすると、YMM4の画面に出るすべての項目と、エフェクトの中身の値まで送ります(操作の提案がオンの時は、いつも詳しく送ります)"/>
                        <WrapPanel Margin="0,0,0,2">
                            <ComboBox ItemsSource="{Binding PreviewModes}" SelectedIndex="{Binding PreviewMode, Mode=TwoWay}" MinWidth="200" Margin="0,0,6,6"/>
                            <ComboBox ItemsSource="{Binding PreviewSizes}" SelectedIndex="{Binding PreviewSize, Mode=TwoWay}" MinWidth="200" Margin="0,0,6,6"/>
                            <ComboBox ItemsSource="{Binding PreviewPointModes}" SelectedIndex="{Binding PreviewPoints, Mode=TwoWay}" MinWidth="200" Margin="0,0,6,6"
                                      ToolTip="「セリフ・テキストごと」は字幕が出ている場面を中心に撮ります。「とぎれなく全部」は、はじめからおわりまで決めた間隔で全部撮り、Gemini には動画にして、ほかの AI には送れる枚数まで画像で送ります"/>
                            <ComboBox ItemsSource="{Binding ContinuousChoices}" SelectedIndex="{Binding ContinuousIndex, Mode=TwoWay}" MinWidth="160" Margin="0,0,6,6"
                                      Visibility="{Binding IsContinuous, Converter={StaticResource B2V}}"
                                      ToolTip="とぎれなく撮る時の細かさ。細かいほど、撮るのに時間がかかります(1コマ 0.1 秒ほど)"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="1シーンから撮るコマ数" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider Width="140" Minimum="1" Maximum="12" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding FramesPerScene}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FramesPerScene}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="添付した動画から取り出すコマ数" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                       ToolTip="Claude・ChatGPT などには、動画をコマの画像にして送ります(Gemini には動画そのものを送ります)"/>
                            <Slider Width="140" Minimum="0" Maximum="24" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding MediaFrames}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MediaFrames}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Check}" Content="ChatGPT の時、添付した動画・音声を文字起こしして送る(OpenAI の文字起こしは別料金)" IsChecked="{Binding Transcribe}" Margin="0,0,0,8"/>
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding UseMemory}" Margin="0,0,0,2"
                                  Content="AI の記憶を使う(これまでの会話を、ほかのプロジェクトのものも含めて覚えておく。YMM4専用ストレージの「AI記憶」に保存)"/>
                        <DockPanel Margin="20,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource FilledBtn}" Content="すべて忘れる" Padding="10,3" Margin="6,0,0,0" Command="{Binding ClearMemoryCommand}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource FilledBtn}" Content="記憶を開く" Padding="10,3" Command="{Binding OpenMemoryCommand}"/>
                            <TextBlock Text="{Binding MemoryInfo}" Opacity="0.7" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding ShareStorage}" Margin="0,0,0,4"
                                  Content="YMM4専用ストレージのすべての中身(ファイルの一覧)を AI に見せ、必要なファイルを AI が読めるようにする"/>
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding DetectCommands}" Margin="0,0,0,4"
                                  Content="「〜を動かして」「〜を付けて」のような指示は、そのまま実行できる操作として出してもらう(先頭に ! を付けると、いつも指示として送ります)"/>
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding AutoRunCommands}" Margin="20,0,0,8"
                                  Content="指示された操作は、OK を押さずにすぐ実行する(変更ログから元に戻せます)"/>
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding ShareLibrary}" Margin="0,0,0,4"
                                  Content="操作の提案の時に、素材データベース・テンプレート・プリセット・許可したフォルダーを AI に見せる(素材の配置を提案できる)"/>
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource FilledBtn}" Content="＋ フォルダーを許可" Padding="10,3" Click="AiAddAllowedFolder_Click"
                                    ToolTip="AI に見せて、配置に使ってよい素材フォルダーを選びます(中の画像・動画・音声の名前が AI に送られます)"/>
                            <TextBlock Text="AI に見せてよい素材フォルダー" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="(まだありません)" Foreground="{StaticResource Sub}" FontSize="11" Margin="4,0,0,6"
                                   Visibility="{Binding HasNoAllowedFolders, Converter={StaticResource B2V}}"/>
                        <ItemsControl ItemsSource="{Binding AllowedFolders}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,2">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="✕" FontSize="10" Width="22" Height="20" ToolTip="許可をやめる"
                                                Command="{Binding DataContext.RemoveAllowedFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding StringFormat=📁 {0}}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="AIへの追加の指示(毎回送る。例: 小学生向けの解説動画です / 辛口で)" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox Style="{StaticResource Field}" Text="{Binding ExtraInstruction, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 会話 -->
            <ScrollViewer local:WheelFix.Enabled="True" x:Name="AiScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,10" AllowDrop="True" PreviewDragOver="AiDrop_DragOver" PreviewDrop="AiDrop_Drop"
                          Visibility="{Binding IsChatPane, Converter={StaticResource B2V}}">
                <StackPanel Margin="18,0,18,10" MaxWidth="980">
                    <!-- まだ何も話していない時 -->
                    <StackPanel Visibility="{Binding HasNoMessages, Converter={StaticResource B2V}}" Margin="0,30,0,0">
                        <TextBlock Text="AIに、編集の相談をしましょう" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Foreground="{StaticResource Sub}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,20"
                                   Text="送った質問と一緒に、タイムライン(すべてのシーン)とプレビューの画面を、自動でAIに見せます。下のボタンを押すと、その質問をすぐに送れます。"/>
                        <ItemsControl ItemsSource="{Binding QuickPrompts}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FilledBtn}" Margin="0,0,8,8" Padding="14,8" MaxWidth="320"
                                            Command="{Binding DataContext.QuickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <!-- あなた: 右 / AI: 左 -->
                                    <Border x:Name="bubble" CornerRadius="12" Padding="14,10" MaxWidth="760" HorizontalAlignment="Left" Background="{StaticResource Panel}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock x:Name="who" Text="{Binding Who}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Accent}"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="30,0,0,0">
                                                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Sub}" FontSize="10" VerticalAlignment="Center"/>
                                                    <Button Style="{StaticResource IconBtn}" Content="&#xE8C8;" FontSize="11" Width="24" Height="22" Margin="6,0,0,0" ToolTip="コピー"
                                                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource Text}" FontSize="13" Padding="0" Cursor="IBeam"/>
                                            <TextBlock Text="{Binding Attached, StringFormat=📎 一緒に送ったもの: {0}}" Foreground="{StaticResource Sub}" FontSize="10" Margin="0,6,0,0"
                                                       TextWrapping="Wrap" Visibility="{Binding HasAttached, Converter={StaticResource B2V}}"/>
                                            <!-- AI からの質問の選択肢 -->
                                            <ItemsControl ItemsSource="{Binding Options}" Margin="0,8,0,0" Visibility="{Binding ShowOptions, Converter={StaticResource B2V}}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource AccentBtn}" Margin="0,0,6,6" Padding="12,5" MaxWidth="320"
                                                                Command="{Binding DataContext.AnswerCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}">
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="bubble" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="bubble" Property="Background" Value="{StaticResource Card}"/>
                                        <Setter TargetName="who" Property="Foreground" Value="{StaticResource Sub}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter TargetName="bubble" Property="Background" Value="#3A2526"/>
                                        <Setter TargetName="who" Property="Foreground" Value="#FF8A80"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 操作の提案 -->
            <Grid Grid.Row="2" Visibility="{Binding IsProposalPane, Converter={StaticResource B2V}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="18,10,18,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource AccentBtn}" Content="待っているものを一括で実行" Padding="10,4" Margin="0,0,6,0" Command="{Binding ApproveAllCommand}"
                                ToolTip="確認待ちの提案を、上から順にまとめて実行します"/>
                        <Button Style="{StaticResource FilledBtn}" Content="待っているものをすべて却下" Padding="10,4" Margin="0,0,6,0" Command="{Binding RejectAllCommand}"/>
                        <Button Style="{StaticResource FilledBtn}" Content="済んだものを片付ける" Padding="10,4" Command="{Binding ClearDoneCommand}"/>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Sub}" FontSize="11"
                               Text="AI からの操作の提案です。内容を確かめて「OK・実行」を押したものだけが YMM4 に反映されます。実行したものは「変更ログ」から元に戻せます(YMM4 の元に戻すも使えます)。"/>
                </DockPanel>
                <ScrollViewer local:WheelFix.Enabled="True" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,0,18,12">
                        <TextBlock Visibility="{Binding HasNoProposals, Converter={StaticResource B2V}}" Foreground="{StaticResource Sub}" Margin="0,30,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="まだ提案はありません。上の「操作の提案」をオンにしてから AI に質問すると、ここに届きます。"/>
                        <ItemsControl ItemsSource="{Binding Proposals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="card" Background="{StaticResource Panel}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3" Visibility="{Binding HasScene, Converter={StaticResource B2V}}">
                                                    <Border Background="{StaticResource Card}" CornerRadius="8" Padding="8,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SceneText, StringFormat=🎬 {0}}" FontSize="11" Foreground="{StaticResource Accent}"/>
                                                    </Border>
                                                    <Button Style="{StaticResource FilledBtn}" Content="シーンを開く" Padding="8,1" FontSize="11" Margin="6,0,0,0"
                                                            ToolTip="YMM4 でこのシーンを開いて、提案の場所へシークバーを動かします"
                                                            Command="{Binding DataContext.ShowSceneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Reason, StringFormat=理由: {0}}" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                                           Visibility="{Binding HasReason, Converter={StaticResource B2V}}"/>
                                                <TextBlock x:Name="state" Text="{Binding StateText}" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                                                        Visibility="{Binding CanRun, Converter={StaticResource B2V}}">
                                                <Button Style="{StaticResource AccentBtn}" Content="OK・実行" Padding="12,5" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource FilledBtn}" Content="却下" Padding="12,5"
                                                        Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPending}" Value="False">
                                            <Setter TargetName="card" Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="failed">
                                            <Setter TargetName="state" Property="Foreground" Value="#FF8A80"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 会話の履歴 -->
            <Grid Grid.Row="2" Visibility="{Binding IsHistoryPane, Converter={StaticResource B2V}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="18,10,18,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource FilledBtn}" Content="保存先を開く" Padding="10,4" Command="{Binding OpenChatFolderCommand}"/>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Sub}" FontSize="11"
                               Text="{Binding ChatFolder, StringFormat=会話は自動で保存しています({0})。「続きから話す」で、これまでのやりとりを引き継いで質問できます。YMM4 マネージャーの AI質問の会話も、ここから続けられます。}"/>
                </DockPanel>
                <Grid Grid.Row="1">
                    <TextBlock Text="まだ保存した会話はありません" Foreground="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoHistory, Converter={StaticResource B2V}}"/>
                    <ListBox ItemsSource="{Binding History}" Background="Transparent" BorderThickness="0" Margin="12,0,12,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding InfoText}" Foreground="{StaticResource Sub}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Style="{StaticResource AccentBtn}" Content="続きから話す" Padding="10,4" Margin="0,0,6,0"
                                                Command="{Binding DataContext.ContinueChatCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource FilledBtn}" Content="削除" Padding="10,4"
                                                Command="{Binding DataContext.DeleteChatCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- 変更ログ -->
            <Grid Grid.Row="2" Visibility="{Binding IsLogPane, Converter={StaticResource B2V}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="18,10,18,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource FilledBtn}" Content="保存先を開く" Padding="10,4" Margin="0,0,6,0" Command="{Binding OpenLogFolderCommand}"/>
                        <Button Style="{StaticResource FilledBtn}" Content="ログを消す" Padding="10,4" Command="{Binding ClearLogCommand}"/>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Sub}" FontSize="11"
                               Text="AI の提案で行った変更の記録です(新しい順・最大500件)。「元に戻す」は、YMM4 を起動している間に実行したものだけ使えます。"/>
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Log}" Background="Transparent" BorderThickness="0" Margin="12,0,12,10"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,1,10,0" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Result}" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Reason, StringFormat=理由: {0}}" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap"
                                               Visibility="{Binding HasReason, Converter={StaticResource B2V}}"/>
                                    <TextBlock Text="{Binding Undone}" Foreground="{StaticResource Sub}" FontSize="11" Visibility="{Binding HasUndone, Converter={StaticResource B2V}}"/>
                                    <TextBlock Text="{Binding Ai}" Foreground="{StaticResource Sub}" FontSize="10"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource FilledBtn}" Content="元に戻す" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Top"
                                        Visibility="{Binding CanUndo, Converter={StaticResource B2V}}"
                                        Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 下: 入力 -->
            <Border Grid.Row="3" Background="{StaticResource Panel}" Padding="14,10" AllowDrop="True"
                    PreviewDragOver="AiDrop_DragOver" PreviewDragEnter="AiDrop_DragOver" PreviewDrop="AiDrop_Drop">
                <StackPanel>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" FontSize="11" Margin="2,0,0,6" TextWrapping="Wrap"/>
                    <!-- 添付(ファイル・フォルダー) -->
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource FilledBtn}" Content="📎 ファイル" Padding="10,4" Margin="0,0,6,0" Click="AiAttachFile_Click"
                                    ToolTip="画像・動画・音声・PDF・テキスト・字幕(srt)・プロジェクト(ymmp)などを AI に送ります。入力欄へのドラッグ&amp;ドロップや、Ctrl+V での画像の貼り付けもできます"/>
                            <Button Style="{StaticResource AccentBtn}" Content="🛠 これまでのアドバイスを提案にする" Padding="10,4" Margin="0,0,6,0"
                                    Command="{Binding ProposeFromChatCommand}" Visibility="{Binding CanProposeFromChat, Converter={StaticResource B2V}}"
                                    ToolTip="操作の提案をオンにする前に AI が話したアドバイスを、実行できる提案の一覧にしてもらいます"/>
                            <Button Style="{StaticResource FilledBtn}" Content="📁 フォルダー" Padding="10,4" Margin="0,0,8,0" Click="AiAttachFolder_Click"
                                    ToolTip="フォルダーの中身(ファイルの一覧と、画像・テキストの中身)を AI に送ります"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource FilledBtn}" Content="添付をすべて外す" Padding="8,3" VerticalAlignment="Top"
                                Command="{Binding ClearAttachmentsCommand}" Visibility="{Binding HasAttachments, Converter={StaticResource B2V}}"/>
                        <ItemsControl ItemsSource="{Binding Attachments}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Card}" CornerRadius="10" Padding="8,2,2,2" Margin="0,0,6,4" ToolTip="{Binding Path}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                            <Button Style="{StaticResource IconBtn}" Content="✕" FontSize="10" Width="20" Height="20" Margin="4,0,0,0" ToolTip="外す"
                                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AiInput" Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="AiInput_PreviewKeyDown"
                                 Tag="AIに質問する(Enter で送信 / Shift+Enter で改行 / ファイルはここへドロップ)"/>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource AccentBtn}" Content="送信 ➤" Padding="18,10" Command="{Binding SendCommand}"/>
                            <Button Style="{StaticResource FilledBtn}" Content="取りやめ" Padding="10,4" Margin="0,6,0,0" Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding CurrentAi}" Foreground="{StaticResource Sub}" FontSize="11" Margin="2,6,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 設定ページ ===== -->
        <Grid Grid.Row="1" Background="{StaticResource Bg}"
              Visibility="{Binding ShowSettingsPage, Converter={StaticResource B2V}}">
            <ScrollViewer local:WheelFix.Enabled="True" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="24,20,24,28">
                    <TextBlock Text="設定" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                                        <WrapPanel Margin="0,0,0,16">
                        <RadioButton Style="{StaticResource PillToggle}" GroupName="SettingsTabs" Margin="0,0,6,6" Content="タブ構成"
                                     IsChecked="{Binding ShowSettingsTabs, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource PillToggle}" GroupName="SettingsTabs" Margin="0,0,6,6" Content="動作"
                                     IsChecked="{Binding ShowSettingsBehavior, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource PillToggle}" GroupName="SettingsTabs" Margin="0,0,6,6" Content="YMM4連携"
                                     IsChecked="{Binding ShowSettingsLink, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource PillToggle}" GroupName="SettingsTabs" Margin="0,0,6,6" Content="ショートカット"
                                     IsChecked="{Binding ShowSettingsShortcuts, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource PillToggle}" GroupName="SettingsTabs" Margin="0,0,6,6" Content="プラグイン一覧"
                                     IsChecked="{Binding ShowSettingsPlugins, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource PillToggle}" GroupName="SettingsTabs" Margin="0,0,6,6" Content="図形の表示"
                                     IsChecked="{Binding ShowSettingsShapes, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource PillToggle}" GroupName="SettingsTabs" Margin="0,0,6,6" Content="完全リセット"
                                     IsChecked="{Binding ShowSettingsReset, Mode=TwoWay}"/>
                    </WrapPanel>
                    <Border Background="{StaticResource Card}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding HasResetMessage, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding ResetMessage}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Visibility="{Binding ShowSettingsTabs, Converter={StaticResource B2V}}">
                        <TextBlock Foreground="{StaticResource Accent}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="{Binding AutoRegisterMessage}"/>
<Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="エクスプローラーのタブ" FontWeight="SemiBold" Margin="0,0,0,4"/>

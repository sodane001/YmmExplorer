            <Border Background="#D0000000" MouseLeftButtonDown="PreviewBackdrop_MouseDown"/>
            <Border Margin="32" MaxWidth="1100" CornerRadius="12" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- タイトルバー -->
                    <Grid Grid.Row="0" Margin="16,10,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding PreviewItem.IconGlyph}"
                                   Foreground="{Binding PreviewItem.IconBrush}" FontSize="20" Width="32"/>
                        <TextBlock Grid.Column="1" Text="{Binding PreviewItem.Name}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding PreviewCounter}" Foreground="{StaticResource Sub}"
                                   VerticalAlignment="Center" Margin="12,0"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Style="{StaticResource IconBtn}" Content="&#xE76B;" ToolTip="前へ (←)" Command="{Binding PrevPreviewCommand}"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE76C;" ToolTip="次へ (→)" Command="{Binding NextPreviewCommand}"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE8A7;" ToolTip="既定のアプリで開く" Command="{Binding OpenExternalCommand}"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE711;" ToolTip="閉じる (Esc)" Command="{Binding ClosePreviewCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 本体 -->
                    <Grid Grid.Row="1" Margin="16,0" MinHeight="260">
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding IsPreviewImage, Converter={StaticResource B2V}}"/>
                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                      Stretch="Uniform" MaxHeight="520"
                                      Volume="{Binding Value, ElementName=VolSlider}"
                                      MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"
                                      MediaFailed="Player_MediaFailed"/>
                        <ScrollViewer local:WheelFix.Enabled="True" x:Name="PdfScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsPreviewPdf, Converter={StaticResource B2V}}">
                            <Image Source="{Binding PdfPageImage}" Stretch="Uniform" Margin="0,0,0,8"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </ScrollViewer>
                        <Border Background="{StaticResource Panel}"
                                Visibility="{Binding IsPreviewAudio, Converter={StaticResource B2V}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="96"
                                           Foreground="#FF9F6B" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding PreviewItem.Name}" FontSize="15" Margin="0,16,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding PreviewMessage}" Foreground="#FFB4AB" TextWrapping="Wrap"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    </Grid>

                    <!-- 再生コントロール -->
                    <Grid Grid.Row="2" Margin="16,8,16,14"
                          Visibility="{Binding IsPreviewMedia, Converter={StaticResource B2V}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconBtn}" Click="PlayBtn_Click" ToolTip="再生 / 一時停止 (Space)">
                            <TextBlock x:Name="PlayGlyph" Style="{StaticResource Glyph}" Text="&#xE769;"/>
                        </Button>
                        <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource Seek}" Margin="8,0"
                                Minimum="0" Maximum="1"
                                PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up"/>
                        <TextBlock x:Name="TimeText" Grid.Column="2" Text="00:00 / 00:00" Foreground="{StaticResource Sub}"
                                   FontSize="12" VerticalAlignment="Center" Margin="4,0,14,0"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource Glyph}" Text="&#xE767;" Foreground="{StaticResource Sub}"
                                   Margin="0,0,8,0"/>
                        <Slider x:Name="VolSlider" Grid.Column="4" Style="{StaticResource Seek}"
                                Minimum="0" Maximum="1" Value="0.8"/>
                    </Grid>

                    <!-- PDFのページ送り -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="16,8,16,14"
                                Visibility="{Binding IsPreviewPdf, Converter={StaticResource B2V}}">
                        <Button Style="{StaticResource IconBtn}" Content="&#xE76B;" ToolTip="前のページ (PageUp)"
                                Command="{Binding PrevPageCommand}"/>
                        <TextBlock Text="{Binding PdfPageText}" VerticalAlignment="Center" TextAlignment="Center"
                                   MinWidth="80" Margin="12,0"/>
                        <Button Style="{StaticResource IconBtn}" Content="&#xE76C;" ToolTip="次のページ (PageDown)"
                                Command="{Binding NextPageCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== ショートカットを実行した時の知らせ ===== -->
        <Border Grid.Row="1" Panel.ZIndex="100" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,24"
                Background="{StaticResource Card}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                CornerRadius="8" Padding="14,9" IsHitTestVisible="False"
                Visibility="{Binding ShowToast, Converter={StaticResource B2V}}">
            <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap" MaxWidth="460"/>
        </Border>

        <!-- ===== テキスト分割の画面(どのタブからでも開ける) ===== -->
        <Grid Grid.RowSpan="2" Background="#C0101114" Visibility="{Binding TextSplit.IsOpen, Converter={StaticResource B2V}}">
            <Border DataContext="{Binding TextSplit}" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    CornerRadius="12" MaxWidth="820" Margin="24" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 見出し -->
                    <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="18,14,12,12">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="✂ テキスト分割" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="1つのテキストを、複数のアイテムに分けます。上から順に ① → ② → ③ と進めてください" Foreground="{StaticResource Sub}" FontSize="11" Margin="0,3,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="選択中のテキストをここへ送るキー" Foreground="{StaticResource Sub}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <local:KeyRecorder Style="{StaticResource Field}" Width="200"
                                                       Keys="{Binding DataContext.TextSplitShortcutKeys, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       ToolTip="YMM4で別のテキストを選んでこのキーを押すと、そのテキストを読み込み直します"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="閉じる (Esc)" Command="{Binding CloseCommand}"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="560">
                        <StackPanel Margin="18,14,18,10">
                            <!-- ① 分け方 -->
                            <TextBlock Text="① 分け方を選ぶ" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton GroupName="SplitMode" Cursor="Hand" IsChecked="{Binding IsSubtitle, Mode=TwoWay}">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bd" Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}" BorderThickness="2" CornerRadius="10" Padding="14,12">
                                                <StackPanel>
                                                    <TextBlock Text="字幕切替" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="時間で分ける" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,2,0,6"/>
                                                    <!-- 図: 時間の流れに沿って、順番に並ぶ -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Border Width="52" Height="18" CornerRadius="3" Background="{StaticResource Accent}" Margin="0,0,3,0"/>
                                                        <Border Width="40" Height="18" CornerRadius="3" Background="#FFC83D" Margin="0,0,3,0"/>
                                                        <Border Width="62" Height="18" CornerRadius="3" Background="#34C759"/>
                                                        <TextBlock Text=" → 時間" Foreground="{StaticResource Sub}" FontSize="10" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="1つめ → 2つめ → … と、順番に表示されます。話す速さに合わせた字幕に" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectedBg}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                                <RadioButton Grid.Column="2" GroupName="SplitMode" Cursor="Hand" IsChecked="{Binding IsLayout, Mode=TwoWay}"
                                             IsEnabled="{Binding CanLayout}" Opacity="{Binding LayoutOpacity}"
                                             ToolTip="ボイスのアイテムでは、選べません(音声が重なってしまうため)" ToolTipService.ShowOnDisabled="True">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bd" Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}" BorderThickness="2" CornerRadius="10" Padding="14,12">
                                                <StackPanel>
                                                    <TextBlock Text="レイアウト" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="同じ時間のまま、別々のアイテムに" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,2,0,6"/>
                                                    <!-- 図: 同じ時間に、レイヤーを分けて重なる -->
                                                    <StackPanel Margin="0,0,0,6">
                                                        <Border Width="160" Height="5" CornerRadius="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Margin="0,0,0,2"/>
                                                        <Border Width="160" Height="5" CornerRadius="2" Background="#FFC83D" HorizontalAlignment="Left" Margin="0,0,0,2"/>
                                                        <Border Width="160" Height="5" CornerRadius="2" Background="#34C759" HorizontalAlignment="Left"/>
                                                    </StackPanel>
                                                    <TextBlock Text="見た目は変えずに、文字ごと・単語ごとに動かしたり、色を変えたりできます" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectedBg}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </Grid>
                            <CheckBox Style="{StaticResource Check}" Content="{Binding ByLengthText}" Margin="2,2,0,0"
                                      IsChecked="{Binding ByLength}" Visibility="{Binding IsSubtitle, Converter={StaticResource B2V}}"/>
                            <TextBlock Text="{Binding VoiceNote}" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0"
                                       Visibility="{Binding IsVoice, Converter={StaticResource B2V}}"/>
                            <TextBlock Text="{Binding FormatInfo}" Foreground="{StaticResource Sub}" FontSize="11" TextWrapping="Wrap" Margin="2,2,0,0"
                                       Visibility="{Binding IsLayout, Converter={StaticResource B2V}}"/>

                            <!-- ② 分ける位置 -->
                            <Grid Margin="0,16,0,8">
                                <TextBlock Text="② 分ける位置を選ぶ(文字と文字のあいだをクリック)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource FilledBtn}" Content="1文字ずつ" Padding="9,3" FontSize="11" Margin="0,0,5,0" ToolTip="すべての文字のあいだで分けます" Command="{Binding SplitAllCommand}"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="改行で" Padding="9,3" FontSize="11" Margin="0,0,5,0" ToolTip="改行の位置に、分ける印を付けます" Command="{Binding SplitLinesCommand}"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="句読点で" Padding="9,3" FontSize="11" Margin="0,0,5,0" ToolTip="「、」「。」などの後ろに、分ける印を付けます" Command="{Binding SplitPunctCommand}"/>
                                    <Button Style="{StaticResource FilledBtn}" Content="印を消す" Padding="9,3" FontSize="11" ToolTip="分ける印を、すべて消します" Command="{Binding ResetCommand}"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="14,16" MinHeight="88">
                                <ItemsControl ItemsSource="{Binding Cells}" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <Border x:Name="cell" Padding="3,2" Background="Transparent">
                                                    <TextBlock Text="{Binding Display}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </Border>
                                                <ToggleButton Width="16" Height="44" Cursor="Hand" IsChecked="{Binding SplitAfter, Mode=TwoWay}"
                                                              ToolTip="クリックで、ここで分ける / やめる"
                                                              Visibility="{Binding ShowGap, Converter={StaticResource B2V}}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Grid Background="Transparent">
                                                                <Rectangle x:Name="bar" Width="2" Fill="{StaticResource Sub}" Opacity="0.25" HorizontalAlignment="Center" Margin="0,8"/>
                                                                <TextBlock x:Name="cut" Text="✂" FontSize="9" Foreground="#FF4D4F" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bar" Property="Opacity" Value="1"/>
                                                                    <Setter TargetName="bar" Property="Width" Value="3"/>
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="bar" Property="Fill" Value="#FF4D4F"/>
                                                                    <Setter TargetName="bar" Property="Opacity" Value="1"/>
                                                                    <Setter TargetName="bar" Property="Width" Value="3"/>
                                                                    <Setter TargetName="bar" Property="Margin" Value="0,10,0,0"/>
                                                                    <Setter TargetName="cut" Property="Visibility" Value="Visible"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Shade}" Value="True">
                                                    <Setter TargetName="cell" Property="Background" Value="#2860CDFF"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Grid Margin="2,6,2,0">
                                <TextBlock Text="{Binding CountText}" Foreground="{StaticResource Sub}" FontSize="11"/>
                                <TextBlock Text="{Binding SplitText}" Foreground="{StaticResource Accent}" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- ③ できあがり -->
                            <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource B2V}}">
                                <TextBlock Text="③ できあがりを確かめる(この数のアイテムになります)" FontWeight="SemiBold" Margin="0,16,0,8"/>
                                <ItemsControl ItemsSource="{Binding Preview}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Card}" CornerRadius="8" Padding="10,6" Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{StaticResource Accent}" CornerRadius="9" MinWidth="18" Height="18" Padding="4,0" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Number}" Foreground="{StaticResource OnAccent}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Text}" FontSize="14" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Info}" Foreground="{StaticResource Sub}" FontSize="10"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" Margin="2,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource FilledBtn}" Content="キャンセル" Padding="0,9" Command="{Binding CloseCommand}"/>
                            <Button Grid.Column="2" Style="{StaticResource AccentBtn}" Content="✓ この内容で分割する" Padding="0,9" Command="{Binding ExecuteCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

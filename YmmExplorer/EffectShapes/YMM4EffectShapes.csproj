  <!-- YMM4DirPath の設定ミスを分かりやすく通知 -->
  <Target Name="CheckYmmDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(YMM4DirPath)YukkuriMovieMaker.Plugin.dll')"
           Text="Directory.Build.props の YMM4DirPath を YMM4 のインストールフォルダに設定してください（現在の値: $(YMM4DirPath)）" />
  </Target>

  <!-- ビルド後、YMM4のpluginフォルダへ自動コピー -->
  <Target Name="PostBuild" AfterTargets="Build" Condition="'$(SkipPluginCopy)' != 'true'">
    <MakeDir Directories="$(YMM4DirPath)user\plugin\$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(YMM4DirPath)user\plugin\$(AssemblyName)" SkipUnchangedFiles="true" />
  </Target>

